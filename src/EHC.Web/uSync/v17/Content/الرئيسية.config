              "unique": null,
              "type": null,
              "udi": null,
              "url": "tel:937",
              "queryString": null,
              "culture": null
            }
          ]
        },
        {
          "alias": "title",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Your next appointment"
        },
        {
          "alias": "titleHighlight",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "is a minute away."
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Book through Sehhaty or call 937. And we\u0027re always here in an emergency."
        },
        {
          "alias": "primaryCta",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "Book now",
