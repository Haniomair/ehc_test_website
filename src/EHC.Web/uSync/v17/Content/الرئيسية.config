                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0623\u0645 \u0648\u0627\u0644\u0637\u0641\u0644"
                  },
                  {
                    "alias": "summary",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0631\u0639\u0627\u064A\u0629 \u0634\u0627\u0645\u0644\u0629 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u062D\u0645\u0644 \u062D\u062A\u0649 \u0627\u0644\u0637\u0641\u0648\u0644\u0629 \u0627\u0644\u0645\u0628\u0643\u0631\u0629"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062F\u0639\u0645 \u0634\u0627\u0645\u0644 \u0644\u0644\u0623\u0645\u0647\u0627\u062A \u0648\u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u0645\u0646 \u0645\u0631\u062D\u0644\u0629 \u0645\u0627 \u0642\u0628\u0644 \u0627\u0644\u062D\u0645\u0644\u060C \u0645\u0631\u0648\u0631\u064B\u0627 \u0628\u0627\u0644\u062D\u0645\u0644 \u0648\u0627\u0644\u0648\u0644\u0627\u062F\u0629\u060C \u0648\u062D\u062A\u0649 \u0631\u0639\u0627\u064A\u0629 \u0645\u0627 \u0628\u0639\u062F \u0627\u0644\u0648\u0644\u0627\u062F\u0629."
                  },
                  {
                    "alias": "points",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0641\u062D\u0635 \u0642\u0628\u0644 \u0627\u0644\u0632\u0648\u0627\u062C \u0648\u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0642\u0628\u0644 \u0627\u0644\u062D\u0645\u0644\n\u0645\u062A\u0627\u0628\u0639\u0629 \u0627\u0644\u062D\u0645\u0644 \u0648\u0627\u0644\u0648\u0644\u0627\u062F\u0629 \u0627\u0644\u0622\u0645\u0646\u0629\n\u0631\u0639\u0627\u064A\u0629 \u0645\u0627 \u0628\u0639\u062F \u0627\u0644\u0648\u0644\u0627\u062F\u0629 \u0648\u0645\u062A\u0627\u0628\u0639\u0629 \u0627\u0644\u0637\u0641\u0644 \u0627\u0644\u0633\u0644\u064A\u0645"
                  },
                  {
                    "alias": "link",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "\u0627\u062D\u0633\u0628\u064A \u0645\u0648\u0639\u062F \u0627\u0644\u0648\u0644\u0627\u062F\u0629",
