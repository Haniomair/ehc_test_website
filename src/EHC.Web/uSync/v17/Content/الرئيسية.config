                            },
                            {
                              "alias": "title",
                              "culture": "ar-SA",
                              "editorAlias": null,
                              "segment": null,
                              "value": "\u0627\u0644\u0623\u0643\u062B\u0631 \u062D\u0627\u062C\u0629 \u0625\u0644\u0649 \u0627\u0644\u0644\u0642\u0627\u062D"
                            },
                            {
                              "alias": "text",
                              "culture": "ar-SA",
                              "editorAlias": null,
                              "segment": null,
                              "value": "\u0645\u0646 \u062A\u062C\u0627\u0648\u0632\u0648\u0627 50 \u0639\u0627\u0645\u064B\u0627\u060C \u0648\u0627\u0644\u062D\u0648\u0627\u0645\u0644\u060C \u0648\u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u0645\u0646 6 \u0623\u0634\u0647\u0631 \u0625\u0644\u0649 5 \u0633\u0646\u0648\u0627\u062A\u060C \u0648\u0645\u0631\u0636\u0649 \u0627\u0644\u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0645\u0632\u0645\u0646\u0629\u060C \u0648\u0627\u0644\u0639\u0627\u0645\u0644\u0648\u0646 \u0641\u064A \u0627\u0644\u0642\u0637\u0627\u0639 \u0627\u0644\u0635\u062D\u064A."
                            },
                            {
                              "alias": "title",
                              "culture": "en-US",
                              "editorAlias": null,
                              "segment": null,
                              "value": "Who needs it most"
                            },
                            {
                              "alias": "text",
                              "culture": "en-US",
                              "editorAlias": null,
                              "segment": null,
                              "value": "Adults over 50, pregnant women, children aged 6 months to 5 years, people with chronic diseases and health workers."
                            }
                          ]
                        },
                        {
                          "contentTypeKey": "f59bb18d-456b-4579-9946-1c38b8c0b587",
                          "key": "2381e60a-af45-459e-a4c6-60af771afffc",
                          "values": [
                            {
                              "alias": "text",
                              "culture": "ar-SA",
                              "editorAlias": null,
                              "segment": null,
                              "value": "\u0627\u062D\u062C\u0632 \u0645\u0648\u0639\u062F \u0627\u0644\u062A\u0637\u0639\u064A\u0645 \u0641\u064A \u0645\u0631\u0643\u0632 \u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0627\u0644\u0623\u0648\u0644\u064A\u0629 \u0627\u0644\u0642\u0631\u064A\u0628 \u0645\u0646\u0643."
                            },
                            {
                              "alias": "text",
                              "culture": "en-US",
                              "editorAlias": null,
                              "segment": null,
                              "value": "Book your vaccination at a primary health care centre near you."
                            }
                          ]
                        }
