                    "alias": "resultText",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0641\u064A \u062D\u0627\u0644\u0627\u062A \u0623\u0644\u0645 \u0627\u0644\u0635\u062F\u0631 \u0623\u0648 \u0635\u0639\u0648\u0628\u0629 \u0627\u0644\u062A\u0646\u0641\u0633 \u0623\u0648 \u0627\u0644\u0646\u0632\u064A\u0641 \u0627\u0644\u0634\u062F\u064A\u062F \u0623\u0648 \u0641\u0642\u062F\u0627\u0646 \u0627\u0644\u0648\u0639\u064A\u060C \u0644\u0627 \u062A\u0646\u062A\u0638\u0631."
