@* Eyebrow, h2 (with *highlight*) and intro used at the top of most sections. Renders nothing when all are empty. *@
@using EHC.Web.Blocks
@using System.Text.Encodings.Web
@model SectionHeader
@inject HtmlEncoder Encoder
@if (!string.IsNullOrWhiteSpace(Model.Eyebrow) || !string.IsNullOrWhiteSpace(Model.Heading) || !string.IsNullOrWhiteSpace(Model.Intro))
{
    <div>
        @if (!string.IsNullOrWhiteSpace(Model.Eyebrow))
        {
            <div class="eyebrow @(Model.OnDark ? "!text-brand-300" : "")">@Model.Eyebrow</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Heading))
        {
            <h2 id="@Model.Id" class="h2 @(Model.OnDark ? "!text-white [&_em]:!text-brand-300" : "")">@Text.Emphasis(Model.Heading, Encoder)</h2>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Intro))
        {
            <p class="mt-3.5 max-w-[560px] text-[1.05rem] @(Model.OnDark ? "text-on-deep" : "text-slate-600 dark:text-slate-400")">@Model.Intro</p>
        }
    </div>
}
