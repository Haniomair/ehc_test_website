{
  "name": "ehc-frontend",
  "version": "1.0.0",
  "description": "EHC website design system: Tailwind v4 tokens, theme presets, components",
  "scripts": {
    "build:css": "tailwindcss -i src/css/ehc.css -o dist/css/ehc.css --minify",
    "build": "npm run check:contrast && npm run build:css && node scripts/copy-assets.mjs",
    "watch": "tailwindcss -i src/css/ehc.css -o dist/css/ehc.css --watch",
    "publish:umbraco": "cross-env EHC_WWWROOT=../src/EHC.Web/wwwroot/assets npm run build",
    "check:contrast": "node scripts/check-contrast.mjs",
    "tiles": "node scripts/fetch-tiles.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "protomaps-leaflet": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
