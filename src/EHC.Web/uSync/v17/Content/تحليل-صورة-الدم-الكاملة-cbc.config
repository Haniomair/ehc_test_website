    <during>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u062A\u064F\u0633\u062D\u0628 \u0639\u064A\u0646\u0629 \u062F\u0645 \u0645\u0646 \u0648\u0631\u064A\u062F \u0641\u064A \u0627\u0644\u0630\u0631\u0627\u0639 \u062E\u0644\u0627\u0644 \u062F\u0642\u0627\u0626\u0642.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EA blood sample is taken from a vein in your arm, which takes a few minutes.\u003C/p\u003E"
}]]></Value>
