                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0639\u0646\u0627\u064A\u0629 \u0627\u0644\u0630\u0627\u062A\u064A\u0629 \u0641\u064A \u0627\u0644\u0645\u0646\u0632\u0644"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u063A\u0627\u0644\u0628\u064B\u0627 \u062A\u062A\u062D\u0633\u0646 \u0647\u0630\u0647 \u0627\u0644\u062D\u0627\u0644\u0629 \u0628\u0627\u0644\u0631\u0627\u062D\u0629 \u0648\u0627\u0644\u0633\u0648\u0627\u0626\u0644. \u0631\u0627\u062C\u0639 \u0637\u0628\u064A\u0628 \u0627\u0644\u0623\u0633\u0631\u0629 \u0625\u0630\u0627 \u0633\u0627\u0621\u062A \u0623\u0648 \u0627\u0633\u062A\u0645\u0631\u062A \u0623\u0643\u062B\u0631 \u0645\u0646 \u0628\u0636\u0639\u0629 \u0623\u064A\u0627\u0645."
                  },
                  {
                    "alias": "ctaLabel",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0642\u0631\u0623 \u0641\u064A \u0627\u0644\u0645\u0643\u062A\u0628\u0629 \u0627\u0644\u0635\u062D\u064A\u0629"
