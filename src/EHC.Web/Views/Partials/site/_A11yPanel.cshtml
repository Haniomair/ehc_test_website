@* Accessibility settings (opened from the utility bar). Every option is a class on <html> set by site.js and remembered
   on this device only (theme-init.js re-applies it before paint). Options complement assistive technology; none of them
   rewrites page content. Text size and contrast keep the data-action hooks used before this panel existed. *@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<EHC.Web.Site.SiteData>
@{
    string D(string k) => Umbraco.GetDictionaryValue("EHC.A11y." + k) ?? "";
    const string tile = "a11y-tile";
    var toggles = new (string Key, string Icon, string Label)[]
    {
        ("links", "link", D("Links")),
        ("spacing", "spacing", D("Spacing")),
        ("still", "pause", D("Still")),
        ("cursor", "cursor", D("Cursor")),
        ("guide", "guide", D("Guide")),
    };
}
<div id="a11y" class="fixed inset-0 z-[85] hidden" role="dialog" aria-modal="true" aria-labelledby="a11y-title">
    <div class="absolute inset-0 bg-deep-950/50" data-action="a11y-close"></div>
    <div class="absolute inset-y-0 end-0 flex w-[min(400px,100%)] flex-col bg-white dark:bg-night-900">
        <div class="flex items-center justify-between gap-4 bg-deep-900 px-5 py-4 text-white dark:bg-deep-950">
            <h2 id="a11y-title" class="flex items-center gap-2.5 text-lg font-bold"><svg class="ico" aria-hidden="true"><use href="#i-a11y" /></svg>@D("Title")</h2>
            <button type="button" data-action="a11y-close" class="grid h-11 w-11 place-items-center rounded-full bg-white/10 ring-1 ring-white/20 hover:bg-white/20" aria-label="@D("Close")"><svg class="ico" aria-hidden="true"><use href="#i-x" /></svg></button>
        </div>
        <div class="flex-1 overflow-y-auto overscroll-contain p-5">
            <p class="mb-5 text-sm text-slate-600 dark:text-slate-400">@D("Intro")</p>

            <div class="mb-3 rounded-2xl border border-slate-200 p-4 dark:border-white/10">
                <div class="flex items-center gap-3">
                    <span class="mega-ic !h-10 !w-10" aria-hidden="true"><svg class="ico"><use href="#i-type" /></svg></span>
                    <span class="flex-1 font-semibold text-deep-900 dark:text-white" id="a11y-size-label">@D("TextSize")</span>
                    <span class="w-14 text-center text-sm font-bold tabular-nums text-deep-900 dark:text-white" data-a11y-size aria-live="polite">100%</span>
                </div>
                <div class="mt-3 grid grid-cols-2 gap-2" role="group" aria-labelledby="a11y-size-label">
                    <button type="button" data-action="font" data-step="-1" class="btn btn-ghost btn-sm" aria-label="@Umbraco.GetDictionaryValue("EHC.Utility.SmallerText")"><span aria-hidden="true">A−</span></button>
                    <button type="button" data-action="font" data-step="1" class="btn btn-ghost btn-sm" aria-label="@Umbraco.GetDictionaryValue("EHC.Utility.LargerText")"><span aria-hidden="true" class="text-lg">A+</span></button>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <button type="button" data-action="contrast" aria-pressed="false" class="@tile"><svg class="ico" aria-hidden="true"><use href="#i-contrast" /></svg><span>@Umbraco.GetDictionaryValue("EHC.Utility.HighContrast")</span></button>
                <button type="button" data-action="dark" aria-pressed="false" class="@tile"><svg class="ico" aria-hidden="true"><use href="#i-moon" /></svg><span>@D("Dark")</span></button>
                @foreach (var t in toggles)
                {
                    <button type="button" data-a11y="@t.Key" aria-pressed="false" class="@tile"><svg class="ico" aria-hidden="true"><use href="#i-@t.Icon" /></svg><span>@t.Label</span></button>
                }
            </div>

            <button type="button" data-action="a11y-reset" class="btn btn-ghost mt-5 w-full"><svg class="ico !h-5 !w-5" aria-hidden="true"><use href="#i-reset" /></svg><span>@D("Reset")</span></button>
            <p class="mt-5 flex gap-2 text-xs leading-relaxed text-slate-500 dark:text-slate-400"><svg class="ico mt-0.5 !h-4 !w-4" aria-hidden="true"><use href="#i-shield" /></svg><span>@D("Note")</span></p>
        </div>
    </div>
</div>
