    <during>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u062A\u064F\u0633\u062D\u0628 \u0639\u064A\u0646\u0629 \u0635\u063A\u064A\u0631\u0629 \u0645\u0646 \u0627\u0644\u062F\u0645 \u0645\u0646 \u0648\u0631\u064A\u062F \u0641\u064A \u0627\u0644\u0630\u0631\u0627\u0639 \u062E\u0644\u0627\u0644 \u062F\u0642\u0627\u0626\u0642. \u0648\u062A\u0633\u062A\u062E\u062F\u0645 \u0628\u0639\u0636 \u0627\u0644\u0639\u064A\u0627\u062F\u0627\u062A \u062C\u0647\u0627\u0632\u064B\u0627 \u064A\u0643\u062A\u0641\u064A \u0628\u0648\u062E\u0632\u0629 \u0641\u064A \u0627\u0644\u0625\u0635\u0628\u0639.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EA small blood sample is taken from a vein in your arm, which takes a few minutes. Some clinics use a finger-prick device.\u003C/p\u003E"
}]]></Value>
    </during>
