        {
          "alias": "items",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0645\u0633\u062A\u0634\u0641\u0649 \u0627\u0644\u0645\u0644\u0643 \u0641\u0647\u062F \u0627\u0644\u062A\u062E\u0635\u0635\u064A\n\u0645\u062C\u0645\u0639 \u0627\u0644\u062F\u0645\u0627\u0645 \u0627\u0644\u0637\u0628\u064A\n\u0645\u0633\u062A\u0634\u0641\u0649 \u0627\u0644\u0642\u0637\u064A\u0641 \u0627\u0644\u0639\u0627\u0645\n\u0645\u0633\u062A\u0634\u0641\u0649 \u0627\u0644\u0648\u0644\u0627\u062F\u0629 \u0648\u0627\u0644\u0623\u0637\u0641\u0627\u0644\n\u0645\u0631\u0643\u0632 \u0625\u0631\u0627\u062F\u0629\n\u0645\u0631\u0643\u0632 \u0633\u0639\u0648\u062F \u0627\u0644\u0628\u0627\u0628\u0637\u064A\u0646\n\u0645\u0633\u062A\u0634\u0641\u0649 \u0627\u0644\u0639\u064A\u0648\u0646 \u0627\u0644\u062A\u062E\u0635\u0635\u064A\n\u0623\u0643\u0627\u062F\u064A\u0645\u064A\u0629 \u0637\u0628 \u0627\u0644\u0623\u0633\u0631\u0629 (31 \u0645\u0631\u0643\u0632 \u0623\u0648\u0644\u064A)"
        },
        {
          "alias": "items",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "King Fahad Specialist Hospital\nDammam Medical Complex\nQatif Central Hospital\nMaternity and Children\u0027s Hospital\nEradah Mental Health Complex\nSaud Al Babtain Cardiac Center\nDhahran Eye Specialist Hospital\nFamily Medicine Academy (31 Primary Healthcare Centers)"
        }
