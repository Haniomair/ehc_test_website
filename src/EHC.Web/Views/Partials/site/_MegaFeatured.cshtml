@* Featured card in a mega panel. One of: megaFeaturedCampaign, megaFeaturedApp, megaFeaturedMap, megaFeaturedStats, megaFeaturedPromo (icon, title, text, button). *@
@using EHC.Web.Site
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<EHC.Web.Site.MegaFeaturedModel>
@{
    var c = Model.Content;
    var title = c.Value<string>("title");
    var text = c.Value<string>("text");
}
@switch (c.ContentType.Alias)
{
    case "megaFeaturedCampaign":
        var campaign = c.Value<IPublishedContent>("campaign");
        if (campaign is null) { break; }
        var campaignTitle = campaign.Value<string>("pageTitle");
        <a href="@campaign.Url()" class="group relative flex h-full flex-col justify-end overflow-hidden rounded-3xl bg-linear-to-br from-support-500 to-support-900 p-6 text-white">
            <span class="mark-bg mark-white absolute -end-10 -top-10 h-56 w-56 opacity-20" aria-hidden="true"></span>
            @if (!string.IsNullOrWhiteSpace(campaign.Value<string>("tag")))
            {
                <span class="mb-auto w-fit rounded-full bg-white/20 px-3 py-1 text-xs font-bold">@(campaign.Value<string>("tag"))</span>
            }
            <b class="mt-10 text-2xl leading-tight">@(string.IsNullOrWhiteSpace(campaignTitle) ? campaign.Name : campaignTitle)</b>
            @if (!string.IsNullOrWhiteSpace(campaign.Value<string>("intro")))
            {
                <span class="mt-2 text-sm text-white/85">@(campaign.Value<string>("intro"))</span>
            }
        </a>
        break;

    case "megaFeaturedApp":
        @* the app: what it does (four tiles, texts in the EHC.Mega.AppFeature.* dictionary items), a decorative phone
           (shapes only, hidden from screen readers) that fills the free height and is cut off at the bottom, and the
           store links from Site settings. The card lies over its grid cell (absolute), so the menu's link columns set the
           height and the card never makes the panel taller; the phone shrinks away when there is no room. *@
        var features = new[] { ("cal", "1"), ("lab", "2"), ("drop", "3"), ("note", "4") }
            .Select(f => (Icon: f.Item1, Label: Umbraco.GetDictionaryValue("EHC.Mega.AppFeature." + f.Item2)))
            .Where(f => !string.IsNullOrWhiteSpace(f.Label)).ToList();
        <div class="relative h-full min-h-[21rem]">
        <div class="absolute inset-0 isolate flex flex-col overflow-hidden rounded-3xl bg-linear-to-br from-brand-500 to-deep-900 p-5 text-white">
            <span class="mark-bg mark-white anim-spin-slow pointer-events-none absolute -end-12 -top-12 -z-10 h-56 w-56 opacity-15" aria-hidden="true"></span>
            <div class="flex items-center gap-3"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white text-brand-500"><svg class="ico" aria-hidden="true"><use href="#i-app" /></svg></span><b class="text-lg leading-snug">@title</b></div>
            @if (!string.IsNullOrWhiteSpace(text)) { <p class="mt-3 text-sm leading-relaxed text-white/85">@text</p> }
            @if (features.Count > 0)
            {
                <ul class="mt-4 flex shrink-0 flex-wrap gap-1.5">
                    @foreach (var f in features)
                    {
                        <li class="flex items-center gap-1.5 whitespace-nowrap rounded-full bg-white/10 py-1 pe-3 ps-1 text-xs font-semibold ring-1 ring-white/15">
                            <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-white/15" aria-hidden="true"><svg class="ico !h-3.5 !w-3.5"><use href="#i-@f.Icon" /></svg></span>
                            @f.Label
                        </li>
                    }
                </ul>
            }
            @* the phone shows only when there is room for it (ehc.css .app-phone-area: a height container) *@
            <div class="app-phone-area relative mt-4 min-h-0 flex-1 overflow-hidden" aria-hidden="true">
                <div class="app-phone anim-bob absolute start-1/2 top-3 w-44 -translate-x-1/2 rtl:translate-x-1/2 rounded-[2rem] border-[6px] border-white/25 bg-white/10 p-3 shadow-[0_24px_60px_rgba(0,0,0,.3)]">
                    <div class="mx-auto mb-3 h-1.5 w-12 rounded-full bg-white/30"></div>
                    <div class="rounded-xl bg-white p-3">
                        <div class="flex items-center gap-2">
                            <span class="grid h-7 w-7 place-items-center rounded-lg bg-brand-50 text-brand-600"><svg class="ico !h-4 !w-4"><use href="#i-cal" /></svg></span>
                            <span class="grid flex-1 gap-1"><span class="h-1.5 w-16 rounded-full bg-deep-900/70"></span><span class="h-1.5 w-10 rounded-full bg-slate-200"></span></span>
                        </div>
                        <span class="mt-3 block h-6 rounded-lg bg-brand-500"></span>
                    </div>
                    <div class="mt-2 grid grid-cols-3 gap-1.5">
                        <span class="grid h-11 place-items-center rounded-lg bg-white/15"><svg class="ico !h-4 !w-4 opacity-80"><use href="#i-lab" /></svg></span>
                        <span class="grid h-11 place-items-center rounded-lg bg-white/15"><svg class="ico !h-4 !w-4 opacity-80"><use href="#i-note" /></svg></span>
                        <span class="grid h-11 place-items-center rounded-lg bg-white/15"><svg class="ico !h-4 !w-4 opacity-80"><use href="#i-heart" /></svg></span>
                    </div>
                    <span class="mt-2 block h-12 rounded-xl bg-white/15"></span>
                    <span class="mt-2 block h-12 rounded-xl bg-white/10"></span>
                    <span class="mt-2 block h-12 rounded-xl bg-white/10"></span>
                </div>
            </div>
            @if (Model.Site.AppLinks.Count > 0)
            {
                <div class="mt-3 grid shrink-0 grid-cols-2 gap-2" aria-label="@Umbraco.GetDictionaryValue("EHC.Mega.AppStores")">
                    @foreach (var store in Model.Site.AppLinks)
                    {
                        <a href="@store.Url" target="@store.Target" class="shine flex items-center justify-center gap-2 rounded-xl bg-night-950 px-3 py-2.5 text-xs font-semibold ring-1 ring-white/15 transition hover:bg-night-900"><svg class="ico !h-4 !w-4" aria-hidden="true"><use href="#i-app" /></svg>@store.Name</a>
                    }
                </div>
            }
        </div>
        </div>
        break;

    case "megaFeaturedMap":
        var mapLink = c.Value<Link>("link");
        <a href="@(mapLink?.Url ?? "#")" class="group relative block h-full min-h-[200px] overflow-hidden rounded-3xl bg-linear-to-br from-brand-50 to-brand-100 p-6 dark:from-deep-900 dark:to-night-950">
            <svg class="absolute inset-0 h-full w-full" viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path d="M300 0C260 30 270 60 235 85 210 102 230 130 205 150 185 165 195 190 180 200H300Z" class="fill-brand-200 dark:fill-deep-800" /><g class="stroke-white dark:stroke-white/10" stroke-width="4" fill="none"><path d="M0 125C75 120 125 100 210 95" /><path d="M100 0C110 60 130 130 125 200" /></g></svg>
            <span class="relative block w-fit rounded-2xl bg-white/90 p-4 shadow-soft dark:bg-night-900/90">
                <b class="block text-deep-900 dark:text-white">@title</b>
                @if (!string.IsNullOrWhiteSpace(text)) { <span class="text-sm text-slate-500 dark:text-slate-400">@text</span> }
            </span>
        </a>
        break;

    case "megaFeaturedPromo":
        var promoLink = c.Value<Link>("link");
        var promoIcon = c.Value<string>("icon");
        if (string.IsNullOrWhiteSpace(title)) { break; }
        <div class="relative flex h-full flex-col overflow-hidden rounded-3xl bg-linear-to-br from-brand-600 to-deep-900 p-6 text-white">
            <span class="mark-bg mark-white absolute -end-12 -bottom-12 h-56 w-56 opacity-15" aria-hidden="true"></span>
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white text-brand-600"><svg class="ico" aria-hidden="true"><use href="#i-@(string.IsNullOrWhiteSpace(promoIcon) ? "star" : promoIcon)" /></svg></span>
            <b class="mt-5 text-xl leading-snug">@title</b>
            @if (!string.IsNullOrWhiteSpace(text)) { <p class="mt-2 text-sm text-white/85">@text</p> }
            @if (promoLink is not null && !string.IsNullOrWhiteSpace(promoLink.Url))
            {
                <a href="@promoLink.Url" target="@promoLink.Target" class="btn btn-sand relative mt-auto w-fit btn-sm">@promoLink.Name<svg class="ico flip !h-4 !w-4" aria-hidden="true"><use href="#i-arrow" /></svg></a>
            }
        </div>
        break;

    case "megaFeaturedStats":
        var stats = c.Value<BlockListModel>("stats")?.ToList() ?? [];
        <div class="grid grid-cols-2 gap-3">
            @for (var i = 0; i < stats.Count; i++)
            {
                var s = stats[i].Content;
                <div class="@(i == 0 ? "rounded-2xl bg-deep-900 p-4 text-white dark:bg-brand-500/15" : "rounded-2xl bg-brand-50 p-4 dark:bg-white/5")">
                    <b class="block text-3xl @(i == 0 ? "" : "text-deep-900 dark:text-white")">@(s.Value<string>("value"))@(s.Value<string>("suffix"))</b>
                    <span class="text-sm @(i == 0 ? "text-brand-100" : "text-slate-500 dark:text-slate-400")">@(s.Value<string>("label"))</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(title)) { <p class="col-span-2 text-xs text-slate-400">@title</p> }
        </div>
        break;
}
