                    "value": "\u0628\u062C\u0631\u0639\u0629 \u0648\u0627\u062D\u062F\u0629."
                  },
                  {
                    "alias": "lead",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0644\u0642\u0627\u062D \u0627\u0644\u0625\u0646\u0641\u0644\u0648\u0646\u0632\u0627 \u0627\u0644\u0645\u0648\u0633\u0645\u064A\u0629 \u0645\u062A\u0627\u062D \u0645\u062C\u0627\u0646\u064B\u0627 \u0641\u064A \u0645\u0631\u0627\u0643\u0632 \u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0627\u0644\u0623\u0648\u0644\u064A\u0629. \u0633\u0631\u064A\u0639 \u0648\u0622\u0645\u0646\u060C \u0648\u0627\u062D\u062C\u0632 \u0645\u0648\u0639\u062F\u0643 \u0639\u0628\u0631 \u062A\u0637\u0628\u064A\u0642 \u0635\u062D\u062A\u064A."
                  },
