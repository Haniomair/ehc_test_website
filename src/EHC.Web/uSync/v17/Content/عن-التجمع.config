        {
          "alias": "quote",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0644\u0642\u062F \u062D\u0642\u0642 \u062A\u062C\u0645\u0639 \u0627\u0644\u0634\u0631\u0642\u064A\u0629 \u0627\u0644\u0635\u062D\u064A \u0648\u0644\u0644\u0647 \u0627\u0644\u062D\u0645\u062F \u062A\u0642\u062F\u0645\u0627\u064B \u0643\u0628\u064A\u0631\u0627\u064B \u0641\u064A \u0645\u0633\u064A\u0631\u062A\u0647 \u0627\u0644\u062A\u062D\u0648\u0644\u064A\u0629 \u0648\u0630\u0644\u0643 \u0628\u0641\u0636\u0644 \u0627\u0644\u0644\u0647 \u0623\u0648\u0644\u0627\u064B \u062B\u0645 \u0628\u062C\u0647\u0648\u062F \u0645\u0646\u0633\u0648\u0628\u064A\u0647 \u0645\u0646 \u0627\u0644\u0643\u0641\u0627\u0621\u0627\u062A \u0627\u0644\u0645\u0624\u0647\u0644\u0629 \u0648\u0627\u0644\u0645\u062F\u0631\u0628\u0629 \u0627\u0644\u0645\u062F\u0639\u0648\u0645\u0629 \u0628\u0627\u0644\u062E\u0628\u0631\u0627\u062A \u0627\u0644\u0645\u062D\u0644\u064A\u0629 \u0648\u0627\u0644\u0639\u0627\u0644\u0645\u064A\u0629."
        },
        {
