        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0641\u064A *\u0627\u0633\u062A\u0631\u0627\u062A\u064A\u062C\u064A\u062A\u0646\u0627*"
        },
        {
          "alias": "intro",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0623\u0631\u0628\u0639\u0629 \u0648\u0639\u0648\u062F\u060C \u0648\u062E\u0645\u0633 \u0642\u064A\u0645\u060C \u0648\u0633\u062A\u0629 \u0623\u0647\u062F\u0627\u0641"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "In Our *Strategy*"
        },
        {
          "alias": "intro",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Four promises, five values, and six objectives"
        }
      ]
    },
