  <Translations>
    <Translation Language="ar-SA">اتصل بالهلال الأحمر فورًا. أوقات الانتظار لا تنطبق على الحالات الحرجة.</Translation>
    <Translation Language="en-US">Call the Red Crescent now. Wait times don't apply to critical cases.</Translation>
  </Translations>
