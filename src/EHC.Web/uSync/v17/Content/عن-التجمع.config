        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0628\u0646\u0627\u0621 \u0645\u062C\u062A\u0645\u0639 *\u0623\u0643\u062B\u0631 \u0635\u062D\u0629*"
        },
        {
          "alias": "lead",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0646\u0634\u0627\u0631\u0643 \u062E\u0628\u0631\u0627\u062A\u0646\u0627 \u0639\u0644\u0649 \u0645\u0633\u062A\u0648\u0649 \u0627\u0644\u0639\u0627\u0644\u0645 \u0648\u0646\u0624\u062B\u0631 \u0641\u064A \u0627\u0644\u0633\u064A\u0627\u0633\u0627\u062A \u0627\u0644\u0635\u062D\u064A\u0629 \u0648\u0646\u0628\u0646\u064A \u0634\u0631\u0627\u0643\u0627\u062A \u0627\u0633\u062A\u0631\u0627\u062A\u064A\u062C\u064A\u0629 \u0644\u0625\u062D\u062F\u0627\u062B \u062A\u063A\u064A\u064A\u0631 \u0645\u0633\u062A\u062F\u0627\u0645 \u0645\u0646 \u0623\u062C\u0644 \u0645\u0633\u062A\u0642\u0628\u0644 \u0623\u0641\u0636\u0644 \u0644\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629."
        },
        {
          "alias": "body",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003E\u064A\u064F\u0642\u062F\u0645 \u062A\u062C\u0645\u0639 \u0627\u0644\u0634\u0631\u0642\u064A\u0629 \u0627\u0644\u0635\u062D\u064A \u0645\u0646\u0638\u0648\u0645\u0629 \u0631\u0639\u0627\u064A\u0629 \u0635\u062D\u064A\u0629 \u0634\u0627\u0645\u0644\u0629 \u0648\u0645\u062A\u0643\u0627\u0645\u0644\u0629 \u062A\u0631\u062A\u0643\u0632 \u0639\u0644\u0649 \u0627\u0644\u062A\u0645\u064A\u0632 \u0648\u0627\u0644\u0627\u0628\u062A\u0643\u0627\u0631\u060C \u0648\u064A\u064F\u0639\u062F \u0623\u062D\u062F \u0627\u0644\u0631\u0643\u0627\u0626\u0632 \u0627\u0644\u0648\u0637\u0646\u064A\u0629 \u0641\u064A \u062A\u0646\u0641\u064A\u0630 \u0646\u0645\u0648\u0630\u062C \u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u062C\u062F\u064A\u062F.\u003C/p\u003E\u003Cp\u003E\u064A\u062E\u062F\u0645 \u0627\u0644\u062A\u062C\u0645\u0639 \u0633\u0643\u0627\u0646 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0634\u0631\u0642\u064A\u0629 \u0639\u0628\u0631 \u0634\u0628\u0643\u0629 \u0645\u062A\u0631\u0627\u0628\u0637\u0629 \u062A\u0636\u0645 22 \u0645\u0633\u062A\u0634\u0641\u0649 \u0639\u0627\u0645\u064B\u0627 \u0648\u062A\u062E\u0635\u0635\u064A\u064B\u0627\u060C \u0648\u0623\u0643\u062B\u0631 \u0645\u0646 120 \u0645\u0631\u0643\u0632\u064B\u0627 \u0644\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0627\u0644\u0623\u0648\u0644\u064A\u0629\u060C \u0644\u0636\u0645\u0627\u0646 \u062A\u0642\u062F\u064A\u0645 \u062E\u062F\u0645\u0627\u062A \u0635\u062D\u064A\u0629 \u0639\u0627\u0644\u064A\u0629 \u0627\u0644\u062C\u0648\u062F\u0629 \u062A\u064F\u0644\u0628\u064A \u0627\u062D\u062A\u064A\u0627\u062C\u0627\u062A \u0627\u0644\u0645\u062C\u062A\u0645\u0639\u060C \u0648\u062A\u064F\u0639\u0632\u0632 \u062A\u062C\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062A\u0641\u064A\u062F \u0645\u0646 \u062E\u0644\u0627\u0644 \u0631\u0639\u0627\u064A\u0629 \u062A\u062A\u0645\u062D\u0648\u0631 \u062D\u0648\u0644 \u0627\u0644\u0625\u0646\u0633\u0627\u0646.\u003C/p\u003E"
          }
        },
        {
          "alias": "imageAlt",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0637\u0628\u064A\u0628\u0629 \u062A\u0628\u062A\u0633\u0645 \u0644\u0637\u0641\u0644\u0629 \u0623\u062B\u0646\u0627\u0621 \u0627\u0644\u0641\u062D\u0635"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Building a *Healthier* Community"
        },
        {
          "alias": "lead",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "We share our expertise globally, influence health policies, and build strategic partnerships to create sustainable change for a better healthcare future."
        },
        {
          "alias": "body",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EThe Eastern Health Cluster delivers a comprehensive and integrated healthcare system, built on a foundation of innovation and excellence. As a key enabler of the new model of care, the Cluster serves the Eastern Province through a connected network of 22 general and specialized hospitals and over 120 primary healthcare centers.\u003C/p\u003E\u003Cp\u003EThis ensures the delivery of high-quality, patient-centered services tailored to the needs of the community and aligned with national healthcare transformation goals.\u003C/p\u003E"
          }
        },
        {
          "alias": "imageAlt",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "A doctor smiling with a young girl during a check-up"
        }
      ]
    },
