          "alias": "title",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Have a concern or complaint?"
        },
        {
          "alias": "text",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0623\u0631\u0633\u0644\u0647\u0627 \u0625\u0644\u064A\u0646\u0627 \u0648\u0633\u062A\u062D\u0635\u0644 \u0639\u0644\u0649 \u0631\u0642\u0645 \u0645\u0631\u062C\u0639\u064A \u0644\u0645\u062A\u0627\u0628\u0639\u062A\u0647\u0627."
