                    "alias": "resultTitle",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u062A\u0635\u0644 \u0639\u0644\u0649 997 \u0641\u0648\u0631\u064B\u0627 \u0623\u0648 \u062A\u0648\u062C\u0651\u0647 \u0644\u0623\u0642\u0631\u0628 \u0637\u0648\u0627\u0631\u0626"
