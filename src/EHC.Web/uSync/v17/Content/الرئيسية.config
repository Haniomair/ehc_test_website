          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0642\u0635\u0629 \u0645\u0631\u064A\u0636 \u00B7 \u0641\u064A\u062F\u064A\u0648 \u062A\u0648\u0636\u064A\u062D\u064A"
