      <Value><![CDATA[]]></Value>
    </reviewedDate>
    <risks>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u0627\u0644\u0645\u062E\u0627\u0637\u0631 \u0642\u0644\u064A\u0644\u0629 \u062C\u062F\u064B\u0627\u060C \u0648\u0642\u062F \u062A\u0638\u0647\u0631 \u0643\u062F\u0645\u0629 \u0628\u0633\u064A\u0637\u0629.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EThe risks are very small. You may get a slight bruise.\u003C/p\u003E"
}]]></Value>
    </risks>
