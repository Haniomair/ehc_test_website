        {
          "alias": "rules",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0632\u0627\u0626\u0631\u0627\u0646 \u0643\u062D\u062F \u0623\u0642\u0635\u0649 \u0644\u0643\u0644 \u0645\u0631\u064A\u0636\n\u0627\u0644\u062A\u0632\u0645 \u0628\u062A\u0639\u0644\u064A\u0645\u0627\u062A \u0645\u0643\u0627\u0641\u062D\u0629 \u0627\u0644\u0639\u062F\u0648\u0649\n\u062D\u0627\u0641\u0638 \u0639\u0644\u0649 \u0627\u0644\u0647\u062F\u0648\u0621"
        },
        {
          "alias": "rules",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "No more than two visitors per patient\nFollow infection-control instructions\nKeep noise to a minimum"
        },
        {
          "alias": "bring",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0627\u0644\u0647\u0648\u064A\u0629 \u0627\u0644\u0648\u0637\u0646\u064A\u0629 \u0623\u0648 \u0627\u0644\u0625\u0642\u0627\u0645\u0629\n\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0623\u062F\u0648\u064A\u0629 \u0627\u0644\u062D\u0627\u0644\u064A\u0629"
        },
        {
          "alias": "bring",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "National ID or Iqama\nA list of current medicines"
        },
        {
          "alias": "note",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0646\u0635 \u062A\u0648\u0636\u064A\u062D\u064A \u0644\u0645\u0644\u0627\u062D\u0638\u0629\u060C \u0645\u062B\u0644 \u0623\u0648\u0642\u0627\u062A \u0627\u0644\u0632\u064A\u0627\u0631\u0629 \u0641\u064A \u0631\u0645\u0636\u0627\u0646."
        },
