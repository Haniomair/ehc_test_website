    {
      "contentTypeKey": "cb9b4685-a265-419e-ab1e-632c0f240bb5",
      "key": "b8f79d6f-210b-4a01-af99-069c80f6a470",
      "values": [
        {
          "alias": "eyebrow",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u062A\u0637\u0628\u064A\u0642 \u0635\u062D\u062A\u064A"
        },
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0645\u0633\u062A\u0634\u0641\u0627\u0643 \u0641\u064A \u062C\u064A\u0628\u0643."
        },
        {
          "alias": "text",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0627\u062D\u062C\u0632 \u0645\u0648\u0627\u0639\u064A\u062F\u0643\u060C \u0627\u0637\u0651\u0644\u0639 \u0639\u0644\u0649 \u0646\u062A\u0627\u0626\u062C\u0643 \u0648\u0648\u0635\u0641\u0627\u062A\u0643\u060C \u0648\u0627\u0633\u062A\u0634\u0631 \u0637\u0628\u064A\u0628\u0643 \u0627\u0641\u062A\u0631\u0627\u0636\u064A\u064B\u0627\u060C \u0641\u064A \u0623\u064A \u0648\u0642\u062A \u0648\u0645\u0646 \u0623\u064A \u0645\u0643\u0627\u0646."
        },
        {
          "alias": "bullets",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u062D\u062C\u0632 \u0648\u0625\u0639\u0627\u062F\u0629 \u062C\u062F\u0648\u0644\u0629 \u062E\u0644\u0627\u0644 \u062B\u0648\u0627\u0646\u064D\n\u0646\u062A\u0627\u0626\u062C \u0627\u0644\u0645\u062E\u062A\u0628\u0631 \u0648\u0627\u0644\u0623\u0634\u0639\u0629 \u0641\u0648\u0631 \u0635\u062F\u0648\u0631\u0647\u0627\n\u0627\u0633\u062A\u0634\u0627\u0631\u0627\u062A \u0627\u0641\u062A\u0631\u0627\u0636\u064A\u0629 \u0645\u0639 \u0623\u0637\u0628\u0627\u0626\u0646\u0627"
        },
        {
          "alias": "eyebrow",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Sehhaty app"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Your hospital, in your pocket."
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Book appointments, see your results and prescriptions, and consult your doctor virtually, anytime, anywhere."
        },
        {
          "alias": "bullets",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Book and reschedule in seconds\nLab and radiology results as soon as they\u0027re ready\nVirtual consultations with our doctors"
        }
      ]
    },
