@* Top bar: advice / unified numbers, email, text-size + contrast controls, language switcher. *@
@using EHC.Web.Site
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<EHC.Web.Site.SiteData>
@{
    const string tool = "h-[26px] min-w-[30px] rounded-md border border-white/25 text-[.78rem] text-white hover:bg-white/10";
}
<div class="bg-deep-900 text-[.84rem] text-on-deep dark:border-b dark:border-white/10 dark:bg-night-950">
    <div class="wrap flex min-h-[38px] flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-[18px]">
            @if (Model.Advice is { } advice)
            {
                <a href="tel:@advice.Dial" class="inline-flex items-center gap-1.5 hover:text-white"><svg class="ico !h-[15px] !w-[15px]" aria-hidden="true"><use href="#i-phone" /></svg><span>@advice.Label</span> <b class="text-white">@advice.Number</b></a>
            }
            @if (Model.UnifiedNumber is { } unified)
            {
                <span class="hidden items-center gap-1.5 sm:inline-flex"><svg class="ico !h-[15px] !w-[15px]" aria-hidden="true"><use href="#i-phone" /></svg><span>@Umbraco.GetDictionaryValue("EHC.Utility.UnifiedNumber")</span> <b class="text-white">@unified</b></span>
            }
            @if (Model.Email is { } email)
            {
                <span class="hidden items-center gap-1.5 md:inline-flex"><svg class="ico !h-[15px] !w-[15px]" aria-hidden="true"><use href="#i-mail" /></svg>@email</span>
            }
        </div>
        <div class="flex items-center gap-3">
            <div class="hidden gap-1 sm:flex" role="group" aria-label="@Umbraco.GetDictionaryValue("EHC.Utility.Accessibility")">
                <button type="button" data-action="font" data-step="-1" class="@tool" aria-label="@Umbraco.GetDictionaryValue("EHC.Utility.SmallerText")">A−</button>
                <button type="button" data-action="font" data-step="1" class="@tool" aria-label="@Umbraco.GetDictionaryValue("EHC.Utility.LargerText")">A+</button>
                <button type="button" data-action="contrast" class="@tool" aria-label="@Umbraco.GetDictionaryValue("EHC.Utility.HighContrast")" aria-pressed="false">◐</button>
            </div>
            @if (Model.OtherLanguage is { } other)
            {
                <a href="@other.Url" hreflang="@other.Language" lang="@other.Language" class="rounded-full border border-white/25 bg-white/10 px-3 py-0.5 text-[.8rem] text-white hover:bg-white/20" aria-label="@Umbraco.GetDictionaryValue("EHC.Utility.OtherLanguageLabel")">@Umbraco.GetDictionaryValue("EHC.Utility.OtherLanguage")</a>
            }
        </div>
    </div>
</div>
