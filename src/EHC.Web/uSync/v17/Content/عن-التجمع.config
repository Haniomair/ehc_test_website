          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u062F. \u0639\u0628\u062F\u0627\u0644\u0639\u0632\u064A\u0632 \u0639\u0628\u062F\u0627\u0644\u0631\u062D\u0645\u0646 \u0627\u0644\u063A\u0627\u0645\u062F\u064A"
