                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0645\u0632\u0645\u0646\u0629"
                  },
                  {
                    "alias": "summary",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0643\u0634\u0641 \u0627\u0644\u0645\u0628\u0643\u0631 \u0639\u0646 \u0627\u0644\u0623\u0645\u0631\u0627\u0636 \u0648\u0627\u0644\u062A\u0634\u062E\u064A\u0635 \u0641\u064A \u0627\u0644\u0648\u0642\u062A \u0627\u0644\u0645\u0646\u0627\u0633\u0628"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0631\u0643\u0651\u0632 \u0639\u0644\u0649 \u0627\u0644\u0641\u062D\u0635 \u0648\u0627\u0644\u0643\u0634\u0641 \u0627\u0644\u0645\u0628\u0643\u0631 \u0639\u0646 \u0627\u0644\u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0634\u0627\u0626\u0639\u0629 \u0645\u062B\u0644 \u0627\u0644\u0633\u0631\u0637\u0627\u0646 \u0648\u0627\u0644\u0633\u0643\u0631\u064A \u0648\u0627\u0631\u062A\u0641\u0627\u0639 \u0636\u063A\u0637 \u0627\u0644\u062F\u0645 \u0648\u0627\u0644\u0633\u0645\u0646\u0629\u060C \u0645\u0639 \u0645\u062A\u0627\u0628\u0639\u0629 \u0645\u0633\u062A\u0645\u0631\u0629."
                  },
                  {
                    "alias": "points",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0641\u062D\u0635 \u0648\u0627\u0644\u0643\u0634\u0641 \u0627\u0644\u0645\u0628\u0643\u0631\n\u0645\u062A\u0627\u0628\u0639\u0629 \u0645\u0646\u0633\u0651\u0642\u0629 \u0648\u0645\u0633\u062A\u0645\u0631\u0629\n\u062F\u0639\u0645\u0643 \u0641\u064A \u0625\u062F\u0627\u0631\u0629 \u062D\u0627\u0644\u062A\u0643 \u0627\u0644\u0635\u062D\u064A\u0629"
                  },
                  {
                    "alias": "link",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "\u0627\u0644\u0641\u062D\u0635 \u0627\u0644\u0645\u0628\u0643\u0631 \u0644\u0644\u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0645\u0632\u0645\u0646\u0629",
