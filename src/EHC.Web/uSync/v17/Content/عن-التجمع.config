                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Founding council of the Eastern sector"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "The founding council of the Eastern sector was established to support governance, strengthen integration across the health system, and help shape the strategic direction of healthcare in the Eastern Province, in line with the national health transformation goals."
                  }
