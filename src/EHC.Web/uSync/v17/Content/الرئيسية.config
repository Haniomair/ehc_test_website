          "editorAlias": null,
          "segment": null,
          "value": "\u0627\u062E\u062A\u0631 \u0646\u0648\u0639 \u0627\u0644\u0645\u0646\u0634\u0623\u0629 \u0623\u0648 \u0627\u0633\u062A\u062E\u062F\u0645 \u0645\u0648\u0642\u0639\u0643 \u0644\u0639\u0631\u0636 \u0627\u0644\u0623\u0642\u0631\u0628."
