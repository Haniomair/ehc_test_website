                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "663d7efb-ebc9-4086-b038-3fa598f7921d",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "lab"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0643\u062A\u0634\u0627\u0641 \u0645\u0631\u0643\u0628 \u0637\u0628\u064A\u0639\u064A \u0644\u0645\u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u0628\u0643\u062A\u064A\u0631\u064A\u0627 \u0627\u0644\u0645\u0642\u0627\u0648\u0645\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Antibacterial peptide discovery in Staphylococcus epidermidis A487"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0645\u0643\u0651\u0646 \u0627\u0644\u0628\u0627\u062D\u062B\u0648\u0646 \u0645\u0646 \u0627\u0643\u062A\u0634\u0627\u0641 \u0645\u0631\u0643\u0628 \u0628\u0631\u0648\u062A\u064A\u0646\u064A \u062C\u062F\u064A\u062F \u0645\u0646 \u0628\u0643\u062A\u064A\u0631\u064A\u0627 \u0627\u0644\u062C\u0644\u062F \u0627\u0644\u0645\u0641\u064A\u062F\u0629 Staphylococcus epidermidis (\u0627\u0644\u0633\u0644\u0627\u0644\u0629 A487)\u060C \u064A\u062A\u0645\u062A\u0639 \u0628\u0642\u062F\u0631\u0629 \u0639\u0644\u0649 \u0645\u0642\u0627\u0648\u0645\u0629 \u0627\u0644\u0628\u0643\u062A\u064A\u0631\u064A\u0627 \u0627\u0644\u0636\u0627\u0631\u0629\u060C \u062E\u0627\u0635\u0629 MRSA \u0627\u0644\u0645\u0642\u0627\u0648\u0645\u0629 \u0644\u0644\u0645\u0636\u0627\u062F\u0627\u062A. \u0648\u0642\u062F \u062A\u0645 \u0627\u0644\u062A\u0639\u0631\u0641 \u0639\u0644\u064A\u0647 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u062A\u0642\u0646\u064A\u0627\u062A \u062A\u062D\u0644\u064A\u0644 \u0627\u0644\u062D\u0645\u0636 \u0627\u0644\u0646\u0648\u0648\u064A\u060C \u0648\u064A\u064F\u0639\u062A\u0642\u062F \u0623\u0646 \u0627\u0644\u062C\u064A\u0646 hlp \u0647\u0648 \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0639\u0646 \u0625\u0646\u062A\u0627\u062C\u0647."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "This study identified a novel haemolysin-like peptide from Staphylococcus epidermidis strain A487 with antibacterial activity, especially against MRSA. Using genome sequencing and mass spectrometry, researchers discovered a unique peptide encoded by the hlp gene. The findings demonstrate the value of genomic data in uncovering new antimicrobial agents."
                  },
                  {
                    "alias": "link",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "\u0627\u0642\u0631\u0623 \u0627\u0644\u0628\u062D\u062B \u0639\u0644\u0649 ResearchGate",
                        "target": "_blank",
                        "unique": null,
                        "type": "external",
                        "udi": null,
                        "url": "https://www.researchgate.net/publication/51095511_Identification_of_a_haemolysin-like_peptide_with_antibacterial_activity_using_the_draft_genome_sequence_of_Staphylococcus_epidermidis_strain_A487",
                        "queryString": null,
                        "culture": null
                      }
                    ]
                  },
                  {
                    "alias": "link",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "Read on ResearchGate",
                        "target": "_blank",
                        "unique": null,
                        "type": "external",
                        "udi": null,
                        "url": "https://www.researchgate.net/publication/51095511_Identification_of_a_haemolysin-like_peptide_with_antibacterial_activity_using_the_draft_genome_sequence_of_Staphylococcus_epidermidis_strain_A487",
                        "queryString": null,
                        "culture": null
                      }
                    ]
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "7fec2ab1-d185-4885-94f9-af78465e3896",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "lab"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0643\u062A\u0634\u0627\u0641 \u0645\u0636\u0627\u062F \u0628\u0643\u062A\u064A\u0631\u064A \u062C\u062F\u064A\u062F \u0645\u0646 \u0628\u0643\u062A\u064A\u0631\u064A\u0627 \u0646\u0627\u0641\u0639\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Purification and characterization of a novel \u03B4-lysin variant from Staphylococcus epidermidis"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0646\u062C\u062D \u0641\u0631\u064A\u0642 \u0645\u0646 \u0627\u0644\u0628\u0627\u062D\u062B\u064A\u0646 \u0641\u064A \u0627\u0643\u062A\u0634\u0627\u0641 \u0645\u0631\u0643\u0628 \u0637\u0628\u064A\u0639\u064A \u062C\u062F\u064A\u062F \u064A\u064F\u0639\u0631\u0641 \u0628\u0627\u0633\u0645 \u03B4-\u0644\u064A\u0633\u064A\u0646\u060C \u062A\u0645 \u0627\u0633\u062A\u062E\u0644\u0627\u0635\u0647 \u0645\u0646 \u0628\u0643\u062A\u064A\u0631\u064A\u0627 \u0645\u0641\u064A\u062F\u0629 \u062A\u0639\u064A\u0634 \u0639\u0644\u0649 \u0627\u0644\u062C\u0644\u062F \u062A\u064F\u0633\u0645\u0649 Staphylococcus epidermidis (\u0627\u0644\u0633\u0644\u0627\u0644\u0629 A87). \u0623\u0638\u0647\u0631 \u0627\u0644\u0645\u0631\u0643\u0628 \u0642\u062F\u0631\u0629 \u0639\u0644\u0649 \u0645\u0642\u0627\u0648\u0645\u0629 \u0628\u0639\u0636 \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0628\u0643\u062A\u064A\u0631\u064A\u0627 \u0627\u0644\u0636\u0627\u0631\u0629\u060C \u0645\u0627 \u0642\u062F \u064A\u0645\u0647\u0651\u062F \u0627\u0644\u0637\u0631\u064A\u0642 \u0644\u0627\u0633\u062A\u062E\u062F\u0627\u0645\u0647 \u0645\u0633\u062A\u0642\u0628\u0644\u064B\u0627 \u0641\u064A \u062A\u0637\u0648\u064A\u0631 \u0645\u0636\u0627\u062F\u0627\u062A \u062D\u064A\u0648\u064A\u0629 \u0637\u0628\u064A\u0639\u064A\u0629."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Researchers successfully identified and purified a novel \u03B4-lysin peptide from S. epidermidis strain A87, demonstrating antibacterial activity against Gram-positive bacteria. Structural analysis revealed similarities to known cytolytic peptides, indicating a potential role in microbial competition and skin colonization."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "e0b613d4-ad37-4c5f-8fe2-ef001ef490cd",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "shield"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0628\u062A\u0643\u0627\u0631 \u062C\u062F\u064A\u062F \u0644\u062A\u0633\u0631\u064A\u0639 \u0643\u0634\u0641 \u0628\u0643\u062A\u064A\u0631\u064A\u0627 MRSA"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Rapid and cost-effective subtyping of MRSA using denaturing HPLC"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0628\u062A\u0643\u0631 \u0627\u0644\u0628\u0627\u062D\u062B\u0648\u0646 \u0637\u0631\u064A\u0642\u0629 \u0641\u0639\u0627\u0644\u0629 \u0648\u0633\u0631\u064A\u0639\u0629 \u0644\u062A\u062D\u062F\u064A\u062F \u0623\u0646\u0648\u0627\u0639 \u0628\u0643\u062A\u064A\u0631\u064A\u0627 MRSA \u0627\u0644\u0645\u0642\u0627\u0648\u0645\u0629 \u0644\u0644\u0645\u0636\u0627\u062F\u0627\u062A\u060C \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u062A\u0642\u0646\u064A\u0629 DHPLC \u062F\u0648\u0646 \u0627\u0644\u062D\u0627\u062C\u0629 \u0644\u062A\u062D\u0644\u064A\u0644 \u0627\u0644\u062D\u0645\u0636 \u0627\u0644\u0646\u0648\u0648\u064A \u0627\u0644\u0643\u0627\u0645\u0644. \u0646\u062C\u062D\u062A \u0627\u0644\u0637\u0631\u064A\u0642\u0629 \u0641\u064A \u062A\u0635\u0646\u064A\u0641 99 \u0639\u064A\u0646\u0629 \u062E\u0644\u0627\u0644 \u0623\u0642\u0644 \u0645\u0646 5 \u0633\u0627\u0639\u0627\u062A\u060C \u0645\u0645\u0627 \u064A\u062C\u0639\u0644\u0647\u0627 \u062E\u064A\u0627\u0631\u064B\u0627 \u0639\u0645\u0644\u064A\u064B\u0627 \u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u0639\u062F\u0648\u0649 \u0648\u0627\u0644\u062D\u062F \u0645\u0646 \u0627\u0646\u062A\u0634\u0627\u0631\u0647\u0627 \u0641\u064A \u0627\u0644\u0645\u0633\u062A\u0634\u0641\u064A\u0627\u062A."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "This study presents a novel method for rapidly and affordably subtyping methicillin-resistant Staphylococcus aureus (MRSA) using denaturing high-performance liquid chromatography (DHPLC). The method differentiated 99 S. aureus isolates, identified outbreak-related strains within 5 hours, and offers a faster, cheaper alternative to conventional spa typing for controlling hospital-acquired infections."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "ec1170cc-6f97-450b-912d-9b778170e4b7",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "shield"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u062A\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0639\u064A\u0646\u0627\u062A \u0627\u0644\u0645\u0639\u062F\u064A\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Safety and decontamination procedures for infectious sample handling"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u062A\u0646\u0627\u0648\u0644 \u0647\u0630\u0647 \u0627\u0644\u062F\u0631\u0627\u0633\u0629 \u0637\u0631\u0642\u064B\u0627 \u062D\u062F\u064A\u062B\u0629 \u0644\u0636\u0645\u0627\u0646 \u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u0645\u062E\u062A\u0628\u0631\u0627\u062A \u0639\u0646\u062F \u0627\u0644\u062A\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0639\u064A\u0646\u0627\u062A \u0627\u0644\u0645\u0639\u062F\u064A\u0629\u060C \u0648\u062A\u0634\u0645\u0644 \u062A\u0642\u0646\u064A\u0627\u062A \u062A\u0637\u0647\u064A\u0631 \u0645\u062A\u0642\u062F\u0645\u0629 \u0645\u062B\u0644 \u0627\u0644\u0628\u0644\u0627\u0632\u0645\u0627 \u0627\u0644\u0628\u0627\u0631\u062F\u0629 \u0648\u0627\u0644\u0623\u0634\u0639\u0629 \u0641\u0648\u0642 \u0627\u0644\u0628\u0646\u0641\u0633\u062C\u064A\u0629 \u0648\u0627\u0644\u0645\u0630\u064A\u0628\u0627\u062A \u0627\u0644\u0628\u064A\u0626\u064A\u0629 \u0627\u0644\u0622\u0645\u0646\u0629\u060C \u0648\u062A\u0624\u0643\u062F \u0639\u0644\u0649 \u0623\u0647\u0645\u064A\u0629 \u062A\u0642\u064A\u064A\u0645 \u0627\u0644\u0645\u062E\u0627\u0637\u0631 \u0648\u0627\u0644\u062A\u062F\u0631\u064A\u0628 \u0627\u0644\u0645\u0633\u062A\u0645\u0631 \u0648\u0627\u0644\u0627\u0644\u062A\u0632\u0627\u0645 \u0628\u0627\u0644\u0645\u0639\u0627\u064A\u064A\u0631 \u0627\u0644\u062F\u0648\u0644\u064A\u0629 \u0641\u064A \u0627\u0644\u0645\u062E\u062A\u0628\u0631\u0627\u062A \u0639\u0627\u0644\u064A\u0629 \u0627\u0644\u062E\u0637\u0648\u0631\u0629 (BSL-3 \u0648 BSL-4)."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "This review explores modern strategies for the safe handling of infectious samples in laboratories, including cold atmospheric plasma, UV-C light and deep eutectic solvents, alongside structured risk assessment, continuous training and international regulatory compliance in high-containment labs (BSL-3 and BSL-4)."
                  }
                ]
              }
            ],
            "settingsData": [],
