                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u062D\u062C\u0632 \u0645\u0648\u0639\u062F\u064B\u0627 \u0645\u0639 \u0637\u0628\u064A\u0628 \u0627\u0644\u0623\u0633\u0631\u0629"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0645\u0631\u0643\u0632\u0643 \u0627\u0644\u0635\u062D\u064A \u0647\u0648 \u0627\u0644\u0645\u0643\u0627\u0646 \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u0644\u0647\u0630\u0647 \u0627\u0644\u062D\u0627\u0644\u0629."
                  },
                  {
                    "alias": "ctaLabel",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u062D\u062C\u0632 \u0639\u0628\u0631 \u0635\u062D\u062A\u064A"
                  },
