    {
      "contentTypeKey": "2fc8d2cd-e594-4acf-a4f4-82059c7b3a3a",
      "key": "d59ceeba-a600-4eeb-bec2-3ea1b76acd07",
      "values": [
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0625\u0630\u0627 \u0643\u0627\u0646\u062A \u0644\u062F\u064A\u0643 \u0645\u0644\u0627\u062D\u0638\u0629 \u0623\u0648 \u0634\u0643\u0648\u0649"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "If you have a concern or complaint"
        },
        {
          "alias": "layout",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "horizontal"
          ]
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "cf7a2e92-d24f-4c50-bed0-3622e0ef7e0d",
                "key": "204d46ff-88ec-4316-a4fb-a7930c52123e",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "chat"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u062D\u062F\u0651\u062B \u0625\u0644\u064A\u0646\u0627 \u0641\u064A \u0627\u0644\u0645\u0646\u0634\u0623\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Talk to us at the facility"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u062D\u062F\u0651\u062B \u0645\u0639 \u0627\u0644\u0637\u0627\u0642\u0645 \u0623\u0648 \u0645\u0643\u062A\u0628 \u062A\u062C\u0631\u0628\u0629 \u0627\u0644\u0645\u0631\u064A\u0636 \u0641\u064A \u0627\u0644\u0645\u0633\u062A\u0634\u0641\u0649 \u0623\u0648 \u0627\u0644\u0645\u0631\u0643\u0632 \u0627\u0644\u0635\u062D\u064A."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Speak to the staff or the patient experience office at the hospital or health centre."
                  }
                ]
              },
              {
                "contentTypeKey": "cf7a2e92-d24f-4c50-bed0-3622e0ef7e0d",
                "key": "99d1bce3-b2d7-46eb-a9b1-1d8b44690bc0",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "note"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0623\u0631\u0633\u0644 \u0645\u0644\u0627\u062D\u0638\u062A\u0643 \u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A\u064B\u0627"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Send it online"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0633\u062A\u062E\u062F\u0645 \u0646\u0645\u0648\u0630\u062C \u062A\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627\u060C \u0648\u0633\u062A\u062D\u0635\u0644 \u0639\u0644\u0649 \u0631\u0642\u0645 \u0645\u0631\u062C\u0639\u064A \u0644\u0645\u062A\u0627\u0628\u0639\u062A\u0647\u0627."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Use the contact form and you will get a reference number to follow it up."
                  }
                ]
              },
              {
                "contentTypeKey": "cf7a2e92-d24f-4c50-bed0-3622e0ef7e0d",
                "key": "9514ec16-d71e-46a1-8546-0f51ff4a6819",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "phone"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u062A\u0635\u0644 \u0639\u0644\u0649 937"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Call 937"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0645\u0631\u0643\u0632 \u0627\u0644\u0627\u062A\u0635\u0627\u0644 \u0627\u0644\u0645\u0648\u062D\u062F \u0644\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0635\u062D\u0629 \u064A\u0633\u062A\u0642\u0628\u0644 \u0627\u0644\u0627\u0633\u062A\u0641\u0633\u0627\u0631\u0627\u062A \u0648\u0627\u0644\u0634\u0643\u0627\u0648\u0649."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "The Ministry of Health\u0027s unified call centre takes questions and complaints."
                  }
                ]
              }
            ],
