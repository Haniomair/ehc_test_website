@* Table: editors type or paste plain text (one row per line, cells split by | or pasted from a spreadsheet).
   Options: first row is header, first column bold, striped rows. Scrolls sideways on small screens; never HTML. *@
@using EHC.Web.Blocks
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var c = Model.Content;
    var table = TableData.Parse(c.Value<string>("tableData"), c.Value<bool>("headerRow"));
    if (table.IsEmpty) { return; }
    var firstCol = c.Value<bool>("firstColumnBold");
    var striped = c.Value<bool>("striped");
    var caption = c.Value<string>("caption");
    var id = "tb-" + Model.ContentKey.ToString("N")[..8];
}
<div class="wrap">
    <div class="rv sec-head">@await Html.PartialAsync("blocklist/_SectionHeader", new SectionHeader(c.Value<string>("eyebrow"), c.Value<string>("heading"), c.Value<string>("intro")))</div>
    <div class="rv overflow-x-auto rounded-[22px] bg-white ring-1 ring-slate-200 dark:bg-night-900 dark:ring-white/10" role="region" tabindex="0" aria-labelledby="@id">
        <table class="w-full min-w-[560px] border-collapse text-start text-[.95rem]">
            <caption id="@id" class="@(string.IsNullOrWhiteSpace(caption) ? "sr-only" : "caption-bottom border-t border-slate-100 px-5 py-3 text-start text-sm text-slate-600 dark:border-white/10 dark:text-slate-400")">@(string.IsNullOrWhiteSpace(caption) ? Text.Plain(c.Value<string>("heading")) : caption)</caption>
            @if (table.Header.Count > 0)
            {
                <thead class="bg-deep-900 text-white dark:bg-deep-950">
                    <tr>@foreach (var h in table.Header) { <th scope="col" class="px-5 py-3.5 text-start font-semibold">@h</th> }</tr>
                </thead>
            }
            <tbody class="divide-y divide-slate-100 dark:divide-white/10">
                @foreach (var row in table.Rows)
                {
                    <tr class="@(striped ? "even:bg-soft dark:even:bg-white/5" : "") hover:bg-brand-50/60 dark:hover:bg-brand-500/10">
                        @for (var i = 0; i < row.Count; i++)
                        {
                            if (i == 0 && firstCol)
                            {
                                <th scope="row" class="px-5 py-3.5 text-start font-semibold text-deep-900 dark:text-white">@row[i]</th>
                            }
                            else
                            {
                                <td class="px-5 py-3.5 text-slate-700 dark:text-slate-300">@row[i]</td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
