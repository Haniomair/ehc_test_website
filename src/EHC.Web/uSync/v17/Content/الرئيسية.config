                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u062A\u0637\u0648\u0639"
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0633\u0627\u0639\u0629 \u0645\u0646 \u0648\u0642\u062A\u0643 \u062A\u0635\u0646\u0639 \u0641\u0631\u0642\u064B\u0627"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0637\u0648\u0651\u0639 \u0641\u064A \u062D\u0645\u0644\u0627\u062A\u0646\u0627 \u0648\u0645\u0646\u0634\u0622\u062A\u0646\u0627 \u0639\u0628\u0631 \u0627\u0644\u0645\u0646\u0635\u0629 \u0627\u0644\u0648\u0637\u0646\u064A\u0629 \u0644\u0644\u0639\u0645\u0644 \u0627\u0644\u062A\u0637\u0648\u0639\u064A."
                  },
                  {
                    "alias": "cta",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "\u0633\u062C\u0651\u0644 \u0643\u0645\u062A\u0637\u0648\u0639",
                        "target": "_blank",
                        "unique": null,
                        "type": null,
                        "udi": null,
                        "url": "https://www.ehc.med.sa/ar/\u0627\u0644\u062A\u0637\u0648\u0639/",
                        "queryString": null,
                        "culture": null
                      }
                    ]
                  },
                  {
                    "alias": "eyebrow",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Volunteering"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "One hour of your time makes a difference"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Volunteer at our campaigns and facilities through the national volunteering platform."
                  },
                  {
                    "alias": "cta",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
