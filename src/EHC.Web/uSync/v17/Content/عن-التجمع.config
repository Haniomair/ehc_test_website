                    "value": "\u062E\u0645\u0633 \u0642\u064A\u0645 \u062A\u0648\u062C\u0651\u0647 \u0639\u0645\u0644\u0646\u0627 \u0643\u0644 \u064A\u0648\u0645."
                  },
                  {
                    "alias": "bullets",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0646\u062E\u062F\u0645 \u0628\u062A\u0639\u0627\u0637\u0641\r\n\u0634\u063A\u0641 \u0646\u062D\u0648 \u0627\u0644\u062A\u0645\u064A\u0632\r\n\u0627\u0644\u062A\u0641\u0643\u064A\u0631 \u0627\u0644\u0625\u0628\u062F\u0627\u0639\u064A\r\n\u0627\u0644\u062A\u0645\u0643\u064A\u0646 \u0628\u062B\u0642\u0629\r\n\u0627\u0644\u0639\u0645\u0644 \u0643\u0641\u0631\u064A\u0642 \u0648\u0627\u062D\u062F"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Values"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Five values that guide our work every day."
                  },
                  {
                    "alias": "bullets",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Deliver with compassion\r\nPassion for excellence\r\nLead with innovation\r\nEmpower with trust\r\nAct as one"
                  }
                ]
              },
              {
                "contentTypeKey": "1e5bccd1-ea24-41e0-bcf4-4a6e13904991",
                "key": "81c30397-475c-43d2-9476-8047ff3a5bda",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "hand"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0648\u0639\u0648\u062F"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0623\u0631\u0628\u0639\u0629 \u0648\u0639\u0648\u062F \u0646\u0644\u062A\u0632\u0645 \u0628\u0647\u0627 \u0644\u0643\u0644 \u0645\u0646 \u0646\u062E\u062F\u0645\u0647\u0645."
                  },
                  {
                    "alias": "bullets",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0644\u0645\u0633\u062A\u0641\u064A\u062F\u064A\u0646\u0627: \u0648\u0636\u0639 \u0635\u062D\u062A\u0643\u0645 \u0641\u064A \u0635\u062F\u0627\u0631\u0629 \u0623\u0648\u0644\u0648\u064A\u0627\u062A\u0646\u0627\r\n\u0644\u062D\u0643\u0648\u0645\u062A\u0646\u0627: \u0636\u0645\u0627\u0646 \u062C\u0648\u062F\u0629 \u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0627\u0644\u0645\u0633\u062A\u062F\u0627\u0645\u0629\r\n\u0644\u0645\u0648\u0638\u0641\u064A\u0646\u0627: \u0646\u0643\u0648\u0646 \u062C\u0647\u0629 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u062A\u064A \u062A\u0641\u0636\u0644\u0648\u0646\u0647\u0627\r\n\u0644\u0648\u0637\u0646\u0646\u0627: \u0648\u0636\u0639 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0639\u0644\u0649 \u062E\u0631\u064A\u0637\u0629 \u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0627\u0644\u0639\u0627\u0644\u0645\u064A\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Promises"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Four promises we keep to everyone we serve."
                  },
                  {
                    "alias": "bullets",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "To Our Beneficiaries: Make your health our priority\r\nTo Our Government: Ensure sustainable quality healthcare\r\nTo Our Employees: Be an employer of choice\r\nTo Our Nation: Put Saudi on the global healthcare map"
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
              {
                "contentKey": "15c36a0f-c262-4def-8a0c-629a3670fd30",
