    <sources>
      <Value Culture="ar-SA"><![CDATA[[
  {
    "name": "\u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0635\u062D\u0629 \u0627\u0644\u0639\u0627\u0644\u0645\u064A\u0629: \u0627\u0644\u0633\u0643\u0631\u064A",
    "target": "_blank",
    "unique": null,
    "type": "external",
