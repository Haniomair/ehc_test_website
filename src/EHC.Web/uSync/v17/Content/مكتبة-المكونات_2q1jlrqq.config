          "value": ""
        },
        {
          "alias": "intro",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0645\u062D\u062A\u0648\u0649 \u062A\u0648\u0636\u064A\u062D\u064A\u061B \u062A\u064F\u0639\u062A\u0645\u062F \u0623\u0648\u0642\u0627\u062A \u0627\u0644\u0632\u064A\u0627\u0631\u0629 \u0648\u0627\u0644\u062A\u0639\u0644\u064A\u0645\u0627\u062A \u0645\u0646 \u0627\u0644\u0645\u0646\u0634\u0623\u0629."
        },
        {
          "alias": "intro",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Placeholder content; visiting hours and guidelines must be approved by the facility."
