@* Block 7 "Care near you" (facility finder): one panel with a toolbar (facility type, optional health network, "use my
   location"), a compact list and the map (GET /api/facilities). The list is server-rendered, so it works without JS.
   Tablets and desktop: the list scrolls beside the map. Phones: the map, then the first "Rows on phones" facilities with "Show more".
   "Use my location" sorts the list by distance (browser geolocation, computed client-side; nothing is sent to the server).
   Options: health networks (a dropdown with facility counts, linking to the chosen network's page) and live ER wait
   times on emergency departments (components/er-wait.js, GET /api/er-wait; nothing is shown until a real feed exists).
   JS: components/map.js + components/facility-finder.js. *@
@using EHC.Web.Blocks
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var c = Model.Content;
    var home = Umbraco.AssignedContentItem.AncestorOrSelf("home");
    var facilities = home?.DescendantsOfType("facility").OrderBy(f => f.Name).ToList() ?? [];
    if (facilities.Count == 0) { return; }
    var max = c.Value<int>("maxListItems");
    if (max <= 0) { max = 6; }
    string[] filters = ["all", "hospital", "primaryCare", "specialist", "emergency"];
    var initial = c.Value<string>("defaultFilter") is { } d && filters.Contains(d) ? d : "all";
    bool Match(IPublishedContent f, string filter) =>
        filter == "all" || (filter == "emergency" ? f.Value<bool>("hasEmergency") : f.Value<string>("facilityType") == filter);
    var folder = home?.Children().FirstOrDefault(x => x.ContentType.Alias == "facilityFolder");
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var id = "ff-" + Model.ContentKey.ToString("N")[..8];
    string D(string k) => Umbraco.GetDictionaryValue(k) ?? "";

    // health networks: each facility's network page (facilities sit under their network)
    IPublishedContent? NetworkOf(IPublishedContent f) => f.Ancestors().FirstOrDefault(a => a.ContentType.Alias == "healthNetwork");
    var networks = c.Value<bool>("showNetworks")
        ? facilities.Select(NetworkOf).OfType<IPublishedContent>().DistinctBy(n => n.Key).Where(n => n.IsVisible()).OrderBy(n => n.SortOrder).ToList()
        : [];
    var showWait = c.Value<bool>("showErWait") && facilities.Any(f => f.Value<bool>("hasEmergency") && !string.IsNullOrWhiteSpace(f.Value<string>("erFeedId")));
    var waitLabels = showWait ? System.Text.Json.JsonSerializer.Serialize(new { quiet = D("EHC.Er.Quiet"), moderate = D("EHC.Er.Moderate"), busy = D("EHC.Er.Busy") }) : null;
    var initialCount = facilities.Count(f => Match(f, initial));
    var countText = D("EHC.Finder.Count");
    if (!countText.Contains("{0}")) { countText = "{0}"; }
}
<div class="wrap" data-finder="@id" data-filter="@initial" data-max="@max" data-count-text="@countText"@HtmlAttributes.Data("er", showWait ? "1" : null)@HtmlAttributes.Data("api", showWait ? "/api/er-wait" : null)@HtmlAttributes.Data("labels", waitLabels)>
    <div class="rv sec-head-row">
        @await Html.PartialAsync("blocklist/_SectionHeader", new SectionHeader(D("EHC.Finder.Eyebrow"), c.Value<string>("heading"), c.Value<string>("intro")))
        @if (folder is not null) { <a class="link" href="@folder.Url()"><span>@D("EHC.Finder.All")</span><svg class="ico flip" aria-hidden="true"><use href="#i-arrow" /></svg></a> }
    </div>
    <div class="rv md:overflow-hidden md:rounded-[28px] md:border md:border-slate-200/80 md:bg-white md:shadow-subtle dark:md:border-white/10 dark:md:bg-night-900 dark:shadow-none">
        @* toolbar *@
        <div class="flex flex-wrap items-center gap-2.5 pb-4 md:border-b md:border-slate-200 md:p-4 dark:md:border-white/10">
            <div class="seg max-w-full overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="group" aria-label="@D("EHC.Facility.Filter")">
                @foreach (var f in filters)
                {
                    <button type="button" data-finder-filter="@f" aria-pressed="@(f == initial ? "true" : "false")">@if (f == "emergency") {<svg class="ico !h-4 !w-4 text-emerg-600 dark:text-red-300" aria-hidden="true"><use href="#i-er" /></svg>}@D(f switch { "all" => "EHC.Common.All", "emergency" => "EHC.Facility.Emergency", _ => "EHC.Facility.Type." + f })</button>
                }
            </div>
            @if (networks.Count > 1)
            {
                <label class="sr-only" for="@id-net">@D("EHC.Finder.Networks")</label>
                <span class="relative inline-flex max-md:min-w-0 max-md:flex-1">
                    <select id="@id-net" class="field-select max-md:w-full max-md:max-w-none" data-finder-network>
                        <option value="all">@D("EHC.Finder.AllNetworks")</option>
                        @foreach (var n in networks)
                        {
                            <option value="@n.Key">@n.Name (@facilities.Count(f => NetworkOf(f)?.Key == n.Key))</option>
                        }
                    </select>
                    <svg class="ico pointer-events-none absolute end-3 top-1/2 !h-4 !w-4 -translate-y-1/2 text-slate-500" aria-hidden="true"><use href="#i-chev" /></svg>
                </span>
                @foreach (var n in networks)
                {
                    <a class="link hidden text-sm" href="@n.Url()" data-finder-network-link="@n.Key"><span>@D("EHC.Finder.NetworkPage") @n.Name</span><svg class="ico flip !h-4 !w-4" aria-hidden="true"><use href="#i-arrow" /></svg></a>
                }
            }
            <button type="button" class="ms-auto inline-flex items-center gap-1.5 rounded-full px-3 py-2 text-sm font-semibold text-brand-600 transition hover:bg-brand-50 dark:text-brand-300 dark:hover:bg-white/5" data-finder-locate><svg class="ico !h-4 !w-4" aria-hidden="true"><use href="#i-locate" /></svg>@D("EHC.Finder.Locate")</button>
        </div>
        <div class="grid grid-cols-[minmax(0,1fr)] md:grid-cols-[minmax(0,320px)_minmax(0,1fr)] lg:grid-cols-[minmax(0,400px)_minmax(0,1fr)]">
            @* list (start side) *@
            <div class="order-2 flex min-h-0 min-w-0 flex-col md:order-1 md:h-[520px] md:border-e md:border-slate-200 lg:h-[560px] dark:md:border-white/10">
                <p class="pb-1 pt-4 text-xs font-semibold text-slate-500 md:px-5 dark:text-slate-400" role="status" data-finder-status>@string.Format(countText, initialCount)</p>
                <ul class="min-h-0 flex-1 divide-y divide-slate-100 md:overflow-y-auto scrollbar-thin dark:divide-white/5" data-finder-list>
                    @{ var shown = 0; }
                    @foreach (var f in facilities)
                    {
                        var visible = Match(f, initial) && shown < max;
                        if (visible) { shown++; }
                        var type = f.Value<string>("facilityType") ?? "";
                        var icon = type switch { "hospital" => "hosp", "primaryCare" => "clinic", _ => "star" };
                        var er = f.Value<bool>("hasEmergency");
                        var feed = f.Value<string>("erFeedId");
                        var city = f.Value<string>("city");
                        <li class="@(!Match(f, initial) ? "hidden" : visible ? "" : "max-md:hidden")" data-type="@type" data-emergency="@(er ? "1" : "0")" data-network="@(NetworkOf(f)?.Key.ToString() ?? "")" data-lat="@(f.Value<decimal?>("latitude")?.ToString(System.Globalization.CultureInfo.InvariantCulture))" data-lng="@(f.Value<decimal?>("longitude")?.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                            <a href="@f.Url()" class="finder-row group flex items-center gap-3 px-1 py-3 transition md:px-5 hover:bg-soft focus-visible:bg-soft dark:hover:bg-white/5 dark:focus-visible:bg-white/5" data-facility="@f.Key">
                                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl @(er ? "bg-emerg-50 text-emerg-600 dark:bg-emerg-500/15 dark:text-red-300" : "bg-brand-50 text-brand-500 dark:bg-brand-500/15 dark:text-brand-300")"><svg class="ico !h-5 !w-5" aria-hidden="true"><use href="#i-@icon" /></svg></span>
                                <span class="min-w-0 flex-1">
                                    <b class="block truncate text-[.95rem] font-semibold text-deep-900 dark:text-white">@f.Name</b>
                                    <span class="block truncate text-xs text-slate-500 dark:text-slate-400">@D("EHC.Facility.Type." + (string.IsNullOrEmpty(type) ? "hospital" : type))@if (!string.IsNullOrWhiteSpace(city)) {<text> · @city</text>}@if (er) {<text> · <span class="font-semibold text-emerg-600 dark:text-red-300">@D("EHC.Facility.Emergency")</span></text>}</span>
                                    @if (showWait && er && !string.IsNullOrWhiteSpace(feed))
                                    {
                                        @* live ER wait (er-wait.js); stays hidden until the feed has a value for this department *@
                                        <span class="mt-1.5 flex items-center gap-1.5 whitespace-nowrap text-xs" data-er-feed="@feed">
                                            <span class="hidden" data-er-badge></span>
                                            <span class="hidden items-baseline gap-1 text-slate-500 dark:text-slate-400" data-er-value><b class="font-semibold text-deep-900 dark:text-white" data-er-min></b>@D("EHC.Er.MinutesShort")</span>
                                        </span>
                                    }
                                </span>
                                <span class="hidden shrink-0 whitespace-nowrap text-xs font-semibold text-slate-500 dark:text-slate-400" data-finder-distance></span>
                                <svg class="ico flip !h-4 !w-4 shrink-0 text-slate-300 transition group-hover:text-brand-500 dark:text-slate-600" aria-hidden="true"><use href="#i-arrow" /></svg>
                            </a>
                        </li>
                    }
                </ul>
                <p class="hidden px-5 py-10 text-center text-sm text-slate-500 dark:text-slate-400" data-finder-empty>@D("EHC.Common.NoResults")</p>
                <div class="border-t border-slate-100 pt-4 text-center md:hidden dark:border-white/5">
                    <button type="button" class="btn btn-ghost btn-sm @(initialCount > max ? "" : "hidden")" data-finder-more>@D("EHC.Finder.More")</button>
                </div>
            </div>
            @* map (end side; first on phones) *@
            <div class="order-1 h-[320px] overflow-hidden rounded-[22px] sm:h-[380px] md:order-2 md:h-[520px] md:rounded-none lg:h-[560px]" data-map data-src="/api/facilities?culture=@culture" role="region" aria-label="@D("EHC.Facility.Map")"></div>
        </div>
    </div>
</div>
@await Html.PartialAsync("site/_MapAssets")
<script src="~/assets/js/components/facility-finder.js" asp-append-version="true" defer></script>
@if (showWait) { <script src="~/assets/js/components/er-wait.js" asp-append-version="true" defer></script> }
