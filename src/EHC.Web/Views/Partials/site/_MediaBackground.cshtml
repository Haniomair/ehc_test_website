@* Shared media layer for heroes using mediaComposition. The caller renders the wrapper:
     <section class="media-hero …" data-overlay="@bg.Overlay" data-strength="@bg.Strength" style="@bg.FocalStyle">
         @await Html.PartialAsync("site/_MediaBackground", bg)
   Video: muted loop, no autoplay under prefers-reduced-motion, pause button wired by components/hero-video.js
   (the caller places a [data-video-toggle] button). Overlay colours come from the active theme. *@
@model EHC.Web.Blocks.MediaBackground
@if (Model.HasVideo)
{
    <video class="media-bg" muted loop playsinline preload="metadata" poster="@Model.PosterUrl" aria-hidden="true" data-hero-video>
        <source src="@Model.VideoUrl" type="@Model.VideoType">
    </video>
}
else if (Model.HasImage)
{
    <picture class="media-bg">
        <source media="(max-width: 767px)" srcset="@Model.ImageMobile">
        <img src="@Model.ImageDesktop" alt="@Model.Alt" fetchpriority="@(Model.Lazy ? null : "high")" loading="@(Model.Lazy ? "lazy" : null)" decoding="async">
    </picture>
}
@if (Model.ShowPattern)
{
    <div class="mark-bg mark-white pointer-events-none absolute -end-32 top-[calc(50%-340px)] h-[680px] w-[680px] opacity-[.10]" aria-hidden="true"></div>
}
