    <results>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u062A\u064F\u0642\u0627\u0631\u0646 \u0627\u0644\u0646\u062A\u0627\u0626\u062C \u0628\u0627\u0644\u0642\u064A\u0645 \u0627\u0644\u0645\u062A\u0648\u0642\u0639\u0629 \u0644\u0639\u0645\u0631\u0643 \u0648\u0637\u0648\u0644\u0643 \u0648\u062C\u0646\u0633\u0643\u060C \u0648\u0633\u064A\u0634\u0631\u062D\u0647\u0627 \u0644\u0643 \u0627\u0644\u0637\u0628\u064A\u0628.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EThe results are compared with the values expected for your age, height and sex, and your doctor will explain them.\u003C/p\u003E"
}]]></Value>
    </results>
