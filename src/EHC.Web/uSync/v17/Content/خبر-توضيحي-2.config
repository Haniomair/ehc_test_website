      <Name Culture="ar-SA">مجمع الدمام الطبي يطلق مختبرًا لاضطرابات النوم</Name>
      <Name Culture="en-US">Dammam Medical Complex opens a Sleep Disorders Laboratory</Name>
    </NodeName>
    <SortOrder>1</SortOrder>
    <Published Default="true">
      <Published Culture="ar-SA">true</Published>
      <Published Culture="en-US">true</Published>
