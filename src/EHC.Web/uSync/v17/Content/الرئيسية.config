                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0646\u0645\u0637 \u0627\u0644\u062D\u064A\u0627\u0629 \u0627\u0644\u0635\u062D\u064A"
                  },
                  {
                    "alias": "summary",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u062A\u0648\u0639\u064A\u0629 \u0648\u0627\u0644\u0648\u0642\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0648\u062A\u0645\u0643\u064A\u0646 \u0627\u0644\u0645\u0633\u062A\u0641\u064A\u062F\u064A\u0646"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u064A\u0639\u0632\u0651\u0632 \u0627\u0644\u0648\u0642\u0627\u064A\u0629 \u0648\u0623\u0646\u0645\u0627\u0637 \u0627\u0644\u062D\u064A\u0627\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0645\u0646 \u062E\u0644\u0627\u0644 \u0645\u0628\u0627\u062F\u0631\u0627\u062A \u0645\u062B\u0644 \u0627\u0644\u062A\u0648\u0639\u064A\u0629 \u0628\u0627\u0644\u062A\u063A\u0630\u064A\u0629\u060C \u0648\u062D\u0645\u0644\u0627\u062A \u0627\u0644\u0646\u0634\u0627\u0637 \u0627\u0644\u0628\u062F\u0646\u064A\u060C \u0648\u0627\u0644\u0625\u0642\u0644\u0627\u0639 \u0639\u0646 \u0627\u0644\u062A\u062F\u062E\u064A\u0646."
                  },
                  {
                    "alias": "points",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u062A\u062B\u0642\u064A\u0641 \u0648\u0627\u0644\u062A\u0648\u0639\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629\n\u0627\u0644\u062A\u063A\u0630\u064A\u0629 \u0627\u0644\u0633\u0644\u064A\u0645\u0629 \u0648\u0627\u0644\u0646\u0634\u0627\u0637 \u0627\u0644\u0628\u062F\u0646\u064A\n\u0627\u0644\u0625\u0642\u0644\u0627\u0639 \u0639\u0646 \u0627\u0644\u062A\u062F\u062E\u064A\u0646"
                  },
                  {
                    "alias": "link",
