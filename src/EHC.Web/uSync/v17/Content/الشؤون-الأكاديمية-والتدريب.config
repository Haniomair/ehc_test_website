    {
      "contentTypeKey": "1a42d957-7e10-4666-91fa-0d0b08dbe775",
      "key": "c66fe32b-2d3c-4409-a543-88d4e54bf3b2",
      "values": [
        {
          "alias": "title",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0644\u0644\u062A\u0648\u0627\u0635\u0644 \u0645\u0639 \u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u0623\u0643\u0627\u062F\u064A\u0645\u064A\u0629 \u0648\u0627\u0644\u062A\u062F\u0631\u064A\u0628"
        },
        {
          "alias": "title",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Contact academic and training affairs"
        },
        {
          "alias": "text",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0644\u0627\u0633\u062A\u0641\u0633\u0627\u0631\u0627\u062A \u0627\u0644\u062F\u0631\u0627\u0633\u0627\u062A \u0627\u0644\u0639\u0644\u064A\u0627 \u0648\u0627\u0644\u062A\u062F\u0631\u064A\u0628 \u0627\u0644\u062C\u0627\u0645\u0639\u064A \u0648\u0627\u0644\u0627\u0628\u062A\u0639\u0627\u062B\u060C \u0623\u0631\u0633\u0644 \u0631\u0633\u0627\u0644\u062A\u0643 \u0648\u0633\u0646\u062D\u0648\u0651\u0644\u0647\u0627 \u0625\u0644\u0649 \u0627\u0644\u0641\u0631\u064A\u0642 \u0627\u0644\u0645\u062E\u062A\u0635."
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "For postgraduate, university training and scholarship enquiries, send us a message and we will pass it to the team responsible."
        },
        {
          "alias": "primaryCta",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "\u062A\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627",
