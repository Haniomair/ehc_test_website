    <prepare>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u0644\u0627 \u064A\u062D\u062A\u0627\u062C \u0639\u0627\u062F\u0629 \u0625\u0644\u0649 \u0635\u064A\u0627\u0645. \u0623\u062E\u0628\u0631 \u0637\u0628\u064A\u0628\u0643 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0644\u062F\u064A\u0643 \u0641\u0642\u0631 \u062F\u0645 \u0623\u0648 \u0627\u0636\u0637\u0631\u0627\u0628 \u0641\u064A \u0627\u0644\u062F\u0645 \u0645\u062B\u0644 \u0641\u0642\u0631 \u0627\u0644\u062F\u0645 \u0627\u0644\u0645\u0646\u062C\u0644\u064A\u060C \u0644\u0623\u0646\u0647 \u0642\u062F \u064A\u0624\u062B\u0631 \u0639\u0644\u0649 \u0627\u0644\u0646\u062A\u064A\u062C\u0629.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EYou usually don\u0026#39;t need to fast. Tell your doctor if you have anaemia or a blood disorder such as sickle cell disease, as it can affect the result.\u003C/p\u003E"
}]]></Value>
    </prepare>
    <relatedConditions>
      <Value><![CDATA[umb://document/74c3669938c94f0c878b708411aad0f4]]></Value>
    </relatedConditions>
    <results>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u062A\u0638\u0647\u0631 \u0627\u0644\u0646\u062A\u064A\u062C\u0629 \u0643\u0646\u0633\u0628\u0629 \u0645\u0626\u0648\u064A\u0629. \u0648\u0628\u0634\u0643\u0644 \u0639\u0627\u0645 \u0639\u0646\u062F \u0627\u0644\u062A\u0634\u062E\u064A\u0635:\u003C/p\u003E\u003Cul\u003E\u003Cli\u003E\u0623\u0642\u0644 \u0645\u0646 5.7%: \u0637\u0628\u064A\u0639\u064A\u003C/li\u003E\u003Cli\u003E\u0645\u0646 5.7% \u0625\u0644\u0649 6.4%: \u0645\u0627 \u0642\u0628\u0644 \u0627\u0644\u0633\u0643\u0631\u064A\u003C/li\u003E\u003Cli\u003E6.5% \u0623\u0648 \u0623\u0643\u062B\u0631: \u0633\u0643\u0631\u064A\u060C \u0648\u064A\u064F\u0624\u0643\u064E\u0651\u062F \u0628\u0641\u062D\u0635 \u062B\u0627\u0646\u064D\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003E\u0625\u0630\u0627 \u0643\u0646\u062A \u0645\u0635\u0627\u0628\u064B\u0627 \u0628\u0627\u0644\u0633\u0643\u0631\u064A \u0641\u0633\u064A\u062A\u0641\u0642 \u0645\u0639\u0643 \u0637\u0628\u064A\u0628\u0643 \u0639\u0644\u0649 \u0647\u062F\u0641 \u0634\u062E\u0635\u064A.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EThe result is a percentage. As a general guide for diagnosis:\u003C/p\u003E\u003Cul\u003E\u003Cli\u003Ebelow 5.7%: normal\u003C/li\u003E\u003Cli\u003E5.7% to 6.4%: prediabetes\u003C/li\u003E\u003Cli\u003E6.5% or higher: diabetes, confirmed with a second test\u003C/li\u003E\u003C/ul\u003E\u003Cp\u003EIf you have diabetes, your doctor will agree a personal target with you.\u003C/p\u003E"
}]]></Value>
    </results>
    <reviewedBy>
      <Value Culture="ar-SA"><![CDATA[اسم الطبيب]]></Value>
      <Value Culture="en-US"><![CDATA[Doctor Name]]></Value>
    </reviewedBy>
    <reviewedDate>
      <Value><![CDATA[]]></Value>
    </reviewedDate>
    <risks>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u0627\u0644\u0645\u062E\u0627\u0637\u0631 \u0642\u0644\u064A\u0644\u0629 \u062C\u062F\u064B\u0627\u060C \u0648\u0642\u062F \u062A\u0638\u0647\u0631 \u0643\u062F\u0645\u0629 \u0628\u0633\u064A\u0637\u0629 \u0645\u0643\u0627\u0646 \u0633\u062D\u0628 \u0627\u0644\u062F\u0645.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EThe risks are very small. You may get a slight bruise where the blood was taken.\u003C/p\u003E"
}]]></Value>
    </risks>
    <sources>
      <Value Culture="ar-SA"><![CDATA[[
  {
    "name": "\u0645\u064A\u062F\u0644\u0627\u064A\u0646 \u0628\u0644\u0633 (\u0627\u0644\u0645\u0643\u062A\u0628\u0629 \u0627\u0644\u0648\u0637\u0646\u064A\u0629 \u0627\u0644\u0623\u0645\u0631\u064A\u0643\u064A\u0629 \u0644\u0644\u0637\u0628): \u0641\u062D\u0635 \u0627\u0644\u0633\u0643\u0631 \u0627\u0644\u062A\u0631\u0627\u0643\u0645\u064A",
    "target": "_blank",
