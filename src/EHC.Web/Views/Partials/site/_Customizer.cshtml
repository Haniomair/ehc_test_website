@* Look customizer for reviewers (only when Ehc:Customizer:Enabled, Site/Customizer.cs). A form whose values
   components/customizer.js writes to the "ehc-customize" cookie; the server applies them to this browser only.
   Look options apply at once; theme, hero and section changes reload the page, and that reload is rendered with the
   panel already open ("ehc-customize-open" cookie, a few seconds) so it does not slide in again. Hero groups show only
   when that hero is on the page. Nothing here is saved to Umbraco. *@
@using EHC.Web.Blocks
@using EHC.Web.Site
@using EHC.Web.Themes
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<SiteData>
@inject IPublishedValueFallback Fallback
@inject TimeProvider Clock
@if (Customizer.IsOn(Context))
{
    string D(string k) => Umbraco.GetDictionaryValue("EHC.Customizer." + k) ?? "";
    var state = Customizer.Current(Context) ?? new CustomizerState();
    var reopened = Context.Request.Cookies[Customizer.OpenCookieName] == "1";
    var culture = Model.Culture;

    var settings = Model.Home?.Value<IPublishedContent>("settings");   // Theme nodes live under Site settings › Themes
    var themes = settings?.Descendants().Where(n => n.ContentType.Alias == "theme").ToList() ?? [];

    // this page's own sections, in the reviewer's order (the ones an editor hid or scheduled away are left out)
    var now = Clock.GetUtcNow().UtcDateTime;
    var pageBlocks = Model.Page.Value<BlockListModel>("blocks");
    var embedded = HeroNavigator.Embedded(pageBlocks, state.HeroPanel);
    var hasNavigator = pageBlocks?.Any(b => b.Content.ContentType.Alias == "careNavigatorBlock") ?? false;
    var all = pageBlocks?.Where(b => b?.Content is not null && b.ContentKey != embedded?.ContentKey && BlockSection.From(b.Settings, Fallback, now).Visible).ToList() ?? [];
    var sections = state.Arrange(all, b => b.ContentKey);
    var aliases = all.Select(b => b.Content.ContentType.Alias).ToHashSet();
    string Label(BlockListItem b)
    {
        var name = ComponentCatalog.Find(b.Content.ContentType.Alias)?.Name(culture) ?? b.Content.ContentType.Alias;
        var detail = new[] { "heading", "title", "eyebrow" }.Select(a => b.Content.Value<string>(a)).FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));
        if (detail is null && b.Content.ContentType.Alias == "heroCampaignBlock")
        {
            detail = b.Content.Value<BlockListModel>("slides")?.Select(s => s.Content.Value<string>("title")).FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));
        }
        return detail is null ? name : $"{name} · {detail.Replace("*", "")}";   // *…* marks the highlighted words in headings
    }

    void Options(string name, string legend, IEnumerable<(string Value, string Label)> options, string? current)
    {
        <fieldset class="cz-group">
            <legend class="cz-legend">@legend</legend>
            <div class="cz-opts">
                @foreach (var o in options)
                {
                    <label class="cz-opt"><input type="radio" class="sr-only" name="@name" value="@o.Value" checked="@(o.Value == (current ?? ""))"><span>@o.Label</span></label>
                }
            </div>
        </fieldset>
    }
    void Look(string name, string legend)
    {
        var values = Customizer.Looks[name];
        Options(name, legend, values.Select(v => (v, D(char.ToUpperInvariant(name[0]) + name[1..] + char.ToUpperInvariant(v[0]) + v[1..]))), state.Looks.GetValueOrDefault(name) ?? Model.Looks.GetValueOrDefault(name) ?? values[0]);
    }

    <button type="button" data-action="customizer-open" aria-controls="customizer" aria-expanded="@(reopened ? "true" : "false")" aria-haspopup="dialog" class="cz-trigger print:hidden">
        <svg class="ico" aria-hidden="true"><use href="#i-sliders" /></svg><span>@D("Open")</span>
    </button>

    <div id="customizer" class="panel fixed inset-0 z-[86] @(reopened ? "is-open" : "hidden")"@HtmlAttributes.Data("reopened", reopened ? "1" : null) role="dialog" aria-modal="true" aria-labelledby="customizer-title">
        <div class="panel-backdrop absolute inset-0 bg-deep-950/40" data-action="customizer-close"></div>
        <div class="panel-sheet panel-sheet-start absolute inset-y-0 start-0 flex w-[min(380px,100%)] flex-col bg-white dark:bg-night-900">
            <span class="cz-busy z-10" data-cz-busy aria-hidden="true"></span>
            <div class="flex items-center justify-between gap-3 bg-deep-900 px-4 py-3 text-white dark:bg-deep-950">
                <h2 id="customizer-title" class="flex items-center gap-2 text-base font-bold"><svg class="ico !h-5 !w-5" aria-hidden="true"><use href="#i-sliders" /></svg>@D("Title")</h2>
                <button type="button" data-action="customizer-close" class="grid h-10 w-10 place-items-center rounded-full bg-white/10 ring-1 ring-white/20 hover:bg-white/20" aria-label="@D("Close")"><svg class="ico !h-5 !w-5" aria-hidden="true"><use href="#i-x" /></svg></button>
            </div>

            @* autocomplete off: the browser must not restore old radio states on reload, the server's state is the truth *@
            <form class="flex-1 overflow-y-auto overscroll-contain p-4" data-customizer data-site-looks="@System.Text.Json.JsonSerializer.Serialize(Model.Looks)" novalidate autocomplete="off">
                <p class="mb-4 flex gap-2 rounded-xl bg-soft px-3 py-2.5 text-[.78rem] leading-relaxed text-slate-600 dark:bg-white/5 dark:text-slate-300"><svg class="ico mt-0.5 !h-4 !w-4 shrink-0" aria-hidden="true"><use href="#i-eye" /></svg><span>@D("Intro")</span></p>

                @if (themes.Count > 0)
                {
                    <fieldset class="cz-group">
                        <legend class="cz-legend">@D("Theme")</legend>
                        <div class="grid grid-cols-2 gap-2">
                            <label class="cz-theme"><input type="radio" class="sr-only" name="theme" value="" checked="@(state.Theme is null)"><span class="cz-swatch cz-swatch-auto" aria-hidden="true"></span><span>@D("ThemeAuto")</span></label>
                            @foreach (var t in themes)
                            {
                                <label class="cz-theme"><input type="radio" class="sr-only" name="theme" value="@t.Key" checked="@(state.Theme == t.Key)"><span class="cz-swatch" style="@Customizer.SwatchStyle(ThemeResolver.Build(t, Fallback))" aria-hidden="true"><i></i><i></i><i></i></span><span>@t.Name</span></label>
                            }
                        </div>
                    </fieldset>
                }

                @{ Options("pattern", D("Pattern"), [("", D("PatternTheme")), ("star", D("PatternStar")), ("ramadan", D("PatternRamadan")), ("eid-fitr", D("PatternEidFitr")), ("eid-adha", D("PatternEidAdha")), ("hajj", D("PatternHajj")), ("none", D("PatternNone"))], state.Pattern); }

                @if (aliases.Contains("heroCampaignBlock"))
                {
                    Options("panel", D("HeroPanel"), [("", D("AsDesigned")), ("art", D("PanelArt")), .. (hasNavigator ? new[] { ("navigator", D("PanelNavigator")) } : Array.Empty<(string, string)>()), ("cards", D("PanelCards")), ("none", D("PanelNone"))], state.HeroPanel);
                    <label class="cz-check mb-5"><input type="checkbox" name="rotate" value="1" checked="@(state.HeroRotate is not false)"><span>@D("Rotate")</span></label>
                }
                @if (aliases.Contains("heroSplitBlock"))
                {
                    Options("side", D("ImageSide"), [("", D("AsDesigned")), ("start", D("SideStart")), ("end", D("SideEnd"))], state.HeroSide);
                    Options("frame", D("Frame"), [("", D("AsDesigned")), ("tilted", D("FrameTilted")), ("plain", D("FramePlain"))], state.HeroFrame);
                }
                @if (aliases.Contains("heroImageBlock"))
                {
                    Options("align", D("Align"), [("", D("AsDesigned")), ("start", D("AlignStart")), ("center", D("AlignCenter"))], state.HeroAlign);
                }

                @{
                    Look("corners", D("Corners"));
                    Look("shadows", D("Shadows"));
                    Look("density", D("Density"));
                    Look("buttons", D("Buttons"));
                }

                @if (sections.Count > 0)
                {
                    <fieldset class="cz-group">
                        <legend class="cz-legend">@D("Sections")</legend>
                        <ol class="grid grid-cols-1 gap-1.5" data-cz-sections>
                            @foreach (var b in sections)
                            {
                                var key = Customizer.ShortKey(b.ContentKey);
                                var label = Label(b);
                                <li class="cz-section" data-key="@key">
                                    <label class="flex min-w-0 flex-1 items-center gap-2.5"><input type="checkbox" name="show" value="@key" checked="@(!state.Hidden.Contains(key))"><span class="truncate" title="@label">@label</span></label>
                                    <button type="button" data-move="-1" class="cz-move" aria-label="@D("MoveUp") — @label"><svg class="ico rotate-180" aria-hidden="true"><use href="#i-chev" /></svg></button>
                                    <button type="button" data-move="1" class="cz-move" aria-label="@D("MoveDown") — @label"><svg class="ico" aria-hidden="true"><use href="#i-chev" /></svg></button>
                                </li>
                            }
                        </ol>
                    </fieldset>
                }

                <button type="button" data-cz-reset class="btn btn-ghost btn-sm w-full"><svg class="ico !h-[18px] !w-[18px]" aria-hidden="true"><use href="#i-reset" /></svg><span>@D("Reset")</span></button>
            </form>
        </div>
    </div>
    @* not deferred: it restores the scroll position before the reopened page is shown (render waits for #cz-ready) *@
    <script src="~/assets/js/components/customizer.js" asp-append-version="true"></script>
    <span id="cz-ready" hidden></span>
}
