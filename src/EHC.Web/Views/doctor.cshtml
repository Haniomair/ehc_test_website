@* Doctor profile: photo, name, title, specialty, facilities, languages, bio, booking link.
   Only publish real doctors with approved, consented data; demo profiles stay "Doctor Name". *@
@using System.Globalization
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Strings
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "master.cshtml";
    var name = Model.Value<string>("fullName");
    if (string.IsNullOrWhiteSpace(name)) { name = Model.Name; }
    var photo = Model.Value<MediaWithCrops>("photo");
    var specialty = Model.Value<IPublishedContent>("specialty");
    var facilities = Model.Value<IEnumerable<IPublishedContent>>("facilities")?.ToList() ?? [];
    var languages = (Model.Value<IEnumerable<string>>("languages") ?? [])
        .Select(code => { try { return CultureInfo.GetCultureInfo(code).NativeName; } catch (CultureNotFoundException) { return code; } })
        .ToList();
    var bio = Model.Value<IHtmlEncodedString>("bio")?.ToHtmlString();
    var booking = Model.Value<Link>("bookingUrl");
    var crumbs = Model.Ancestors().Reverse().ToList();
}
<div class="bg-soft dark:bg-night-900/60">
    <div class="wrap py-10 lg:py-14">
        <nav aria-label="@Umbraco.GetDictionaryValue("EHC.Common.Breadcrumb")" class="mb-8 text-sm">
            <ol class="flex flex-wrap items-center gap-1.5 text-slate-500 dark:text-slate-400">
                @foreach (var a in crumbs) { <li class="flex items-center gap-1.5"><a href="@a.Url()" class="hover:underline">@a.Name</a><svg class="ico flip !h-3.5 !w-3.5 opacity-60" aria-hidden="true"><use href="#i-arrow" /></svg></li> }
                <li aria-current="page" class="font-semibold text-deep-900 dark:text-white">@name</li>
            </ol>
        </nav>
        <div class="grid items-center gap-8 md:grid-cols-[260px_1fr]">
            <div class="aspect-square overflow-hidden rounded-[28px] bg-linear-to-br from-brand-100 to-brand-50 dark:from-deep-800 dark:to-deep-900">
                @if (photo is not null) { <img src="@photo.GetCropUrl(520, 520)" alt="@name" class="h-full w-full object-cover"> }
                else { <span class="grid h-full place-items-center text-7xl font-bold text-brand-300" aria-hidden="true">@name.Trim().FirstOrDefault()</span> }
            </div>
            <div>
                @if (specialty is not null) { <a href="@specialty.Url()" class="eyebrow hover:underline">@specialty.Name</a> }
                <h1 class="text-[clamp(2rem,4.5vw,3.2rem)] font-bold leading-tight text-deep-900 dark:text-white">@name</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Value<string>("title"))) { <p class="mt-2 text-lg text-slate-600 dark:text-slate-400">@(Model.Value<string>("title"))</p> }
                <dl class="mt-6 grid gap-3 text-sm sm:grid-cols-2">
                    @if (facilities.Count > 0)
                    {
                        <div><dt class="font-semibold text-deep-900 dark:text-white">@Umbraco.GetDictionaryValue("EHC.Doctor.Facilities")</dt><dd class="text-slate-600 dark:text-slate-400">@for (var i = 0; i < facilities.Count; i++) { if (i > 0) {<text> · </text>} <a href="@facilities[i].Url()" class="hover:underline">@facilities[i].Name</a> }</dd></div>
                    }
                    @if (languages.Count > 0)
                    {
                        <div><dt class="font-semibold text-deep-900 dark:text-white">@Umbraco.GetDictionaryValue("EHC.Doctor.Languages")</dt><dd class="text-slate-600 dark:text-slate-400">@string.Join(" · ", languages)</dd></div>
                    }
                </dl>
                @if (booking is not null) { <a href="@booking.Url" target="@booking.Target" class="btn btn-primary mt-7"><svg class="ico" aria-hidden="true"><use href="#i-cal" /></svg><span>@(string.IsNullOrWhiteSpace(booking.Name) ? Umbraco.GetDictionaryValue("EHC.Header.Book") : booking.Name)</span></a> }
            </div>
        </div>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(bio))
{
    <div class="wrap py-12 lg:py-16"><div class="rte max-w-[760px]">@Html.Raw(bio)</div></div>
}
