@* Right panel item "Emergency numbers": tap-to-call numbers from Site settings. Emergency numbers use the fixed
   emergency red (never themed); others are glass tiles. *@
@using EHC.Web.Site
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@inject ISiteContext Site
@{
    var c = Model.Content;
    var phones = Site.Get(Umbraco.AssignedContentItem).Phones
        .Where(p => p.Dial.Length > 0 && (p.IsEmergency || !c.Value<bool>("emergencyOnly"))).Take(4).ToList();
    if (phones.Count == 0) { return; }
    var heading = c.Value<string>("heading");
    var call = Umbraco.GetDictionaryValue("EHC.Emergency.Call");
}
<div>
    @if (!string.IsNullOrWhiteSpace(heading)) { <b class="mb-2 block text-lg leading-tight text-white">@heading</b> }
    <ul class="grid gap-2 @(phones.Count > 1 ? "grid-cols-2" : "")">
        @foreach (var p in phones)
        {
            <li>
                <a href="tel:@p.Dial" class="flex h-full items-center gap-3 rounded-2xl p-3 text-white transition @(p.IsEmergency ? "bg-emerg-600 hover:bg-emerg-600/90" : "border border-white/20 bg-white/10 backdrop-blur-xl hover:bg-white/20")"
                   aria-label="@call @p.Label @p.Number">
                    <svg class="ico shrink-0" aria-hidden="true"><use href="#i-@(p.IsEmergency ? "er" : "phone")" /></svg>
                    <span class="min-w-0"><b class="block text-2xl font-extrabold leading-none" dir="ltr">@p.Number</b><span class="block truncate text-xs text-white/90">@p.Label</span></span>
                </a>
            </li>
        }
    </ul>
</div>
