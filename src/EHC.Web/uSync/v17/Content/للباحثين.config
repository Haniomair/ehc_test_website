          "value": [
            "2"
          ]
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "adf49a56-2812-4ef3-b30a-dd54b6cb8992",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "shield"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0645\u0631\u0627\u062C\u0639\u0629 \u0627\u0644\u0623\u062E\u0644\u0627\u0642\u064A\u0629 \u0648\u0627\u0644\u062D\u0648\u0643\u0645\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Ethics oversight"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0639\u0628\u0631 \u0645\u062C\u0644\u0633 \u0627\u0644\u0645\u0631\u0627\u062C\u0639\u0629 \u0627\u0644\u0645\u0624\u0633\u0633\u064A\u0629 (IRB) \u0627\u0644\u0645\u0639\u062A\u0645\u062F\u060C \u0648\u0627\u0644\u0630\u064A \u064A\u0634\u0631\u0641 \u0639\u0644\u0649 \u0643\u0627\u0641\u0629 \u0627\u0644\u062F\u0631\u0627\u0633\u0627\u062A\u060C \u0648\u064A\u063A\u0637\u064A \u0645\u0646\u0634\u0622\u062A \u0627\u0644\u062A\u062C\u0645\u0639 \u0645\u0646 \u062E\u0644\u0627\u0644 \u0644\u062C\u0627\u0646 \u0645\u062D\u0644\u064A\u0629 \u0646\u0634\u0637\u0629."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Central IRB with local site committees."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "b3267ba9-33bd-4dd6-88a9-9b1d2a0d1820",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "hosp"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062F\u0639\u0645 \u0627\u0644\u062A\u062C\u0627\u0631\u0628 \u0627\u0644\u0633\u0631\u064A\u0631\u064A\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Clinical trials support"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u064A\u0634\u0645\u0644 \u062A\u0646\u0633\u064A\u0642 \u0627\u0644\u062F\u0631\u0627\u0633\u0627\u062A \u0645\u0639 \u0627\u0644\u0631\u0639\u0627\u0629\u060C \u0648\u062A\u0648\u0641\u064A\u0631 \u0645\u0648\u0627\u0642\u0639 \u0628\u062D\u062B\u064A\u0629 \u0646\u0634\u0637\u0629 \u0645\u062B\u0644 \u0645\u0633\u062A\u0634\u0641\u0649 \u0627\u0644\u0642\u0637\u064A\u0641\u060C \u0645\u0631\u0643\u0632 \u0633\u0639\u0648\u062F \u0627\u0644\u0628\u0627\u0628\u0637\u064A\u0646\u060C \u0648\u062A\u062C\u0645\u0639 \u0627\u0644\u062F\u0645\u0627\u0645."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Coordination with sponsors; active sites include Qatif Hospital, Saud Al-Babtain Center, and Dammam Medical Complex."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "01d7f089-7bb6-413d-ab30-d32aa93ee819",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "lab"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u062F\u0639\u0645 \u0627\u0644\u0645\u062E\u062A\u0628\u0631\u064A \u0648\u0627\u0644\u062A\u0642\u0646\u064A"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Laboratory \u0026 technical services"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0639\u0628\u0631 \u0645\u062E\u062A\u0628\u0631\u0627\u062A \u0645\u062A\u0642\u062F\u0645\u0629 \u062A\u0648\u0641\u0631 \u062A\u062D\u0627\u0644\u064A\u0644 \u062C\u064A\u0646\u064A\u0629 \u0648\u062A\u0634\u062E\u064A\u0635\u0627\u062A \u062F\u0642\u064A\u0642\u0629 \u062A\u062F\u0639\u0645 \u0627\u0644\u062A\u062C\u0627\u0631\u0628 \u0627\u0644\u0633\u0631\u064A\u0631\u064A\u0629 \u0648\u0627\u0644\u0628\u062D\u0648\u062B \u0627\u0644\u062D\u064A\u0648\u064A\u0629."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Advanced genomic testing and diagnostics."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "575f5a80-7119-4694-994b-e8b33f60a74f",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "grid"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u062D\u0644\u064A\u0644 \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A \u0648\u0627\u0644\u0625\u062D\u0635\u0627\u0621"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Data \u0026 statistical analysis"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0635\u0645\u064A\u0645 \u0623\u062F\u0648\u0627\u062A \u062C\u0645\u0639 \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A\u060C \u062A\u062D\u0644\u064A\u0644\u0647\u0627\u060C \u0648\u062A\u0642\u062F\u064A\u0645 \u062A\u0642\u0627\u0631\u064A\u0631 \u0645\u0648\u062B\u0648\u0642\u0629 \u062A\u062F\u0639\u0645 \u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062A \u0627\u0644\u0628\u062D\u062B\u064A\u0629."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Tool design, result analysis, and evidence-based reporting."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "822a6ce9-6f0b-4c42-b37b-4cb21ef2e55e",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "chat"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0627\u0633\u062A\u0634\u0627\u0631\u0627\u062A \u0627\u0644\u0645\u0646\u0647\u062C\u064A\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Methodological consultation"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062F\u0639\u0645 \u0635\u064A\u0627\u063A\u0629 \u0627\u0644\u0645\u0642\u062A\u0631\u062D\u0627\u062A \u0648\u0645\u0631\u0627\u062C\u0639\u0629 \u0627\u0644\u062A\u0635\u0627\u0645\u064A\u0645 \u0627\u0644\u0628\u062D\u062B\u064A\u0629 \u0648\u062A\u0633\u062C\u064A\u0644\u0647\u0627 \u0641\u064A \u0627\u0644\u0645\u0646\u0635\u0627\u062A \u0627\u0644\u0648\u0637\u0646\u064A\u0629."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Proposal development and registration."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "4e214de9-b18c-4369-ad3e-16709dafb24b",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "book"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u062A\u062F\u0631\u064A\u0628 \u0648\u0627\u0644\u062A\u0623\u0647\u064A\u0644"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Training programs"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0646\u0638\u064A\u0645 \u0648\u0631\u0634 \u0639\u0645\u0644 \u0648\u0628\u0631\u0627\u0645\u062C \u062A\u062F\u0631\u064A\u0628\u064A\u0629 \u0641\u064A \u0623\u062E\u0644\u0627\u0642\u064A\u0627\u062A \u0627\u0644\u0628\u062D\u062B \u0648\u0627\u0644\u0643\u062A\u0627\u0628\u0629 \u0627\u0644\u0639\u0644\u0645\u064A\u0629."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Research ethics, GCP, and scientific writing."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "dafd15b1-c802-4f92-8e72-9b9389282b82",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "target"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0636\u0628\u0637 \u0627\u0644\u062C\u0648\u062F\u0629 \u0648\u0627\u0644\u0645\u062A\u0627\u0628\u0639\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Quality monitoring"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0637\u0628\u064A\u0642 \u0622\u0644\u064A\u0627\u062A \u062A\u062F\u0642\u064A\u0642 \u062F\u0627\u062E\u0644\u064A\u0629 \u0648\u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u062A\u0632\u0627\u0645 \u0627\u0644\u062F\u0631\u0627\u0633\u0627\u062A \u0628\u0627\u0644\u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u0645\u062D\u0644\u064A\u0629 \u0648\u0627\u0644\u062F\u0648\u0644\u064A\u0629."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Internal audits to ensure full compliance."
                  }
                ]
              }
            ],
