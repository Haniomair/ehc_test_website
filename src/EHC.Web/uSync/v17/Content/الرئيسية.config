                      "emergency"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u062A\u0635\u0644 \u0628\u0640 997 \u0623\u0648 \u062A\u0648\u062C\u0651\u0647 \u0625\u0644\u0649 \u0623\u0642\u0631\u0628 \u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0622\u0646"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0644\u0627 \u062A\u0646\u062A\u0638\u0631: \u0642\u062F \u062A\u0643\u0648\u0646 \u0647\u0630\u0647 \u0639\u0644\u0627\u0645\u0629 \u0639\u0644\u0649 \u062D\u0627\u0644\u0629 \u062E\u0637\u064A\u0631\u0629."
                  },
                  {
                    "alias": "ctaLabel",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u062A\u0635\u0644 \u0628\u0640 997"
                  },
                  {
                    "alias": "ctaLink",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "997",
                        "target": null,
                        "unique": null,
                        "type": null,
                        "udi": null,
                        "url": "tel:997",
                        "queryString": null,
                        "culture": null
                      }
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Call 997 or go to the nearest emergency department now"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Don\u0027t wait: this can be a sign of something serious."
                  },
                  {
                    "alias": "ctaLabel",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Call 997"
