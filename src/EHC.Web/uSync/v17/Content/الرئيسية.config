                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0635\u0646\u0639 \u0623\u062B\u0631\u064B\u0627 \u0641\u064A \u062D\u064A\u0627\u0629 \u0627\u0644\u0645\u0644\u0627\u064A\u064A\u0646"
