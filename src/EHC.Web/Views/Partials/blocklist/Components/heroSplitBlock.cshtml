@* Hero 7 "Split": light hero with text + framed photo (services, a specialty). imageSide = start | end,
   frameStyle = tilted | plain, optional badge (icon, title, subtitle). Give the block spacing "none". *@
@using EHC.Web.Blocks
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@inject System.Text.Encodings.Web.HtmlEncoder Encoder
@{
    var c = Model.Content;
    var title = c.Value<string>("title");
    if (string.IsNullOrWhiteSpace(title)) { return; }
    var bg = MediaBackground.From(c);
    var imageFirst = c.Value<string>("imageSide") == "start";
    var tilted = c.Value<string>("frameStyle") != "plain";
    var highlight = c.Value<string>("titleHighlight");
    var primary = c.Value<Link>("primaryCta");
    var secondary = c.Value<Link>("secondaryCta");
    var badgeTitle = c.Value<string>("badgeTitle");
    var badgeIcon = c.Value<string>("badgeIcon");
}
<div class="relative overflow-hidden bg-soft dark:bg-night-900">
    <div class="mark-bg pointer-events-none absolute -start-24 -top-24 h-[420px] w-[420px] opacity-[.06] dark:opacity-[.12]" aria-hidden="true"></div>
    <div class="wrap relative grid items-center gap-12 py-14 lg:py-20 @(bg.HasImage ? "lg:grid-cols-2" : "")">
        <div class="@(imageFirst ? "lg:order-2" : "")">
            @if (!string.IsNullOrWhiteSpace(c.Value<string>("kicker"))) { <div class="eyebrow">@(c.Value<string>("kicker"))</div> }
            @Heading.Hero(Heading.IsFirstBlock(Umbraco.AssignedContentItem, Model.ContentKey), "text-[clamp(2.2rem,4.6vw,3.8rem)] font-bold leading-[1.1] text-deep-900 rtl:leading-[1.3] dark:text-white", title, highlight, "not-italic text-brand-600 dark:text-brand-300", Encoder)
            @if (!string.IsNullOrWhiteSpace(c.Value<string>("lead"))) { <p class="mt-4 max-w-lg text-lg text-slate-600 dark:text-slate-300">@(c.Value<string>("lead"))</p> }
            @if (primary is not null || secondary is not null)
            {
                <div class="mt-7 flex flex-wrap gap-3">
                    @if (primary is not null) { <a class="btn btn-primary btn-lg" href="@primary.Url" target="@primary.Target">@primary.Name</a> }
                    @if (secondary is not null) { <a class="btn btn-ghost btn-lg" href="@secondary.Url" target="@secondary.Target">@secondary.Name</a> }
                </div>
            }
        </div>
        @if (bg.HasImage)
        {
            <div class="relative @(imageFirst ? "lg:order-1" : "")">
                @if (tilted) { <div class="absolute -inset-3 rotate-2 rounded-[36px] bg-linear-to-br from-brand-400 to-accent-400 opacity-60 rtl:-rotate-2" aria-hidden="true"></div> }
                <div class="media-frame relative aspect-[4/3.4] rounded-[32px]" style="@bg.FocalStyle"><img src="@bg.FrameImage" alt="@bg.Alt" loading="eager"></div>
                @if (!string.IsNullOrWhiteSpace(badgeTitle))
                {
                    <div class="absolute -bottom-5 start-6 flex items-center gap-3 rounded-2xl bg-white px-4 py-3 text-sm shadow-soft dark:bg-night-950">
                        @if (!string.IsNullOrWhiteSpace(badgeIcon)) { <span class="grid h-10 w-10 place-items-center rounded-xl bg-support-50 text-support-500 dark:bg-support-500/15 dark:text-support-300"><svg class="ico" aria-hidden="true"><use href="#i-@badgeIcon" /></svg></span> }
                        <div><b class="block text-deep-900 dark:text-white">@badgeTitle</b>@if (!string.IsNullOrWhiteSpace(c.Value<string>("badgeSubtitle"))) {<span class="text-xs text-slate-500">@(c.Value<string>("badgeSubtitle"))</span>}</div>
                    </div>
                }
            </div>
        }
    </div>
</div>
