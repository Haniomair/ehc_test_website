                      }
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Safe Birth"
                  },
                  {
                    "alias": "summary",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Comprehensive care from before pregnancy to early childhood"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Comprehensive support for mothers and children, from preconception through pregnancy, delivery and post-delivery care."
                  },
                  {
                    "alias": "points",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Premarital screening and preconception care\nPregnancy follow-up and a safe delivery\nPostnatal care and well-baby check-ups"
                  },
                  {
                    "alias": "link",
                    "culture": "en-US",
                    "editorAlias": null,
