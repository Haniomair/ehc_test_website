@* REFERENCE CODE — renders every block through ONE wrapper that applies the shared blockSettings:
   hide, showFrom/showUntil, variant, spacing, anchorId, themeOverride. Components never repeat this logic. *@
@using EHC.Web.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListModel>
@inject IPublishedValueFallback Fallback
@inject TimeProvider Clock
@{
    if (Model is null || !Model.Any()) { return; }
    var now = Clock.GetUtcNow().UtcDateTime;
}
@foreach (var block in Model)
{
    if (block?.Content is null) { continue; }
    var section = BlockSection.From(block.Settings, Fallback, now);
    if (!section.Visible) { continue; }
    var alias = block.Content.ContentType.Alias;

    <section id="@section.AnchorId" data-theme="@section.ThemeOverride" data-block="@alias" class="@section.CssClass">
        @await Html.PartialAsync("blocklist/Components/" + alias, block)
    </section>
}
