    <NodeName Default="المؤتمر الدولي الثاني لأمراض الدم والسيولة ينطلق في الخبر">
      <Name Culture="ar-SA">المؤتمر الدولي الثاني لأمراض الدم والسيولة ينطلق في الخبر</Name>
      <Name Culture="en-US">2nd International Hematology and Bleeding Disorders Conference opens in Al Khobar</Name>
    </NodeName>
    <SortOrder>3</SortOrder>
    <Published Default="true">
      <Published Culture="ar-SA">true</Published>
      <Published Culture="en-US">true</Published>
    </Published>
