                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u062A\u0644\u0637\u064A\u0641\u064A\u0629"
                  },
                  {
                    "alias": "summary",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062F\u0639\u0645 \u062C\u0633\u062F\u064A \u0648\u0646\u0641\u0633\u064A \u0648\u0627\u062C\u062A\u0645\u0627\u0639\u064A \u0648\u0631\u0648\u062D\u064A \u0641\u064A \u0627\u0644\u0645\u0631\u0627\u062D\u0644 \u0627\u0644\u0623\u062E\u064A\u0631\u0629"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u064F\u0639\u0646\u0649 \u0628\u0627\u0644\u0631\u0627\u062D\u0629 \u0627\u0644\u062C\u0633\u062F\u064A\u0629 \u0648\u0627\u0644\u0646\u0641\u0633\u064A\u0629 \u0648\u0627\u0644\u0631\u0648\u062D\u064A\u0629 \u0648\u0627\u0644\u0627\u062C\u062A\u0645\u0627\u0639\u064A\u0629 \u0644\u0644\u0645\u0631\u0636\u0649 \u0641\u064A \u0627\u0644\u0645\u0631\u0627\u062D\u0644 \u0627\u0644\u0645\u062A\u0642\u062F\u0645\u0629 \u0645\u0646 \u0627\u0644\u0645\u0631\u0636\u060C \u0648\u0628\u062F\u0639\u0645 \u0623\u0633\u0631\u0647\u0645."
                  },
                  {
                    "alias": "points",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0641\u0631\u064A\u0642 \u0631\u0639\u0627\u064A\u0629 \u0645\u062A\u0639\u062F\u062F \u0627\u0644\u062A\u062E\u0635\u0635\u0627\u062A\n\u0631\u0639\u0627\u064A\u0629 \u0641\u064A \u0627\u0644\u0645\u0646\u0632\u0644 \u0623\u0648 \u0641\u064A \u0627\u0644\u0645\u0646\u0634\u0623\u0629\n\u062F\u0639\u0645 \u0627\u0644\u0645\u0631\u064A\u0636 \u0648\u0623\u0633\u0631\u062A\u0647"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Palliative Care"
                  },
                  {
                    "alias": "summary",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Physical, emotional, social and spiritual support in the last phase"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Prioritises the physical, emotional, spiritual and social well-being of patients in advanced stages of illness, and supports their families."
                  },
                  {
                    "alias": "points",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "A multidisciplinary care team\nCare at home or in a facility\nSupport for patients and their families"
                  }
                ]
              }
