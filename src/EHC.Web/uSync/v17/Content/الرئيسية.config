        {
          "alias": "eyebrow",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0631\u062D\u0644\u062A\u0643 \u0627\u0644\u0635\u062D\u064A\u0629"
        },
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0631\u0639\u0627\u064A\u0629 \u062A\u0646\u0627\u0633\u0628 *\u0643\u0644 \u0645\u0631\u062D\u0644\u0629* \u0645\u0646 \u0627\u0644\u0639\u0645\u0631"
        },
        {
          "alias": "intro",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0627\u062E\u062A\u0631 \u0645\u0631\u062D\u0644\u062A\u0643 \u0644\u062A\u0631\u0649 \u0627\u0644\u0641\u062D\u0648\u0635\u0627\u062A \u0648\u0627\u0644\u062E\u062F\u0645\u0627\u062A \u0627\u0644\u0645\u0648\u0635\u0649 \u0628\u0647\u0627\u060C \u062B\u0645 \u0627\u062D\u062C\u0632 \u0628\u062E\u0637\u0648\u0629 \u0648\u0627\u062D\u062F\u0629."
        },
        {
          "alias": "disclaimer",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0625\u0631\u0634\u0627\u062F\u0627\u062A \u0639\u0627\u0645\u0629\u061B \u064A\u062D\u062F\u062F \u0637\u0628\u064A\u0628\u0643 \u0645\u0627 \u064A\u0646\u0627\u0633\u0628\u0643."
        },
        {
          "alias": "eyebrow",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Your health journey"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Care for *every stage* of life"
        },
        {
          "alias": "intro",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Pick a life stage to see recommended check-ups and services, then book in one step."
        },
        {
          "alias": "disclaimer",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "General guidance only; your doctor will advise what\u0027s right for you."
        }
      ]
    },
