          "editorAlias": null,
          "segment": null,
          "value": "\u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A\u0629"
        },
        {
          "alias": "eyebrow",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "E-participation"
        },
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0635\u0648\u062A\u0643 \u064A\u0635\u0646\u0639 *\u0627\u0644\u0641\u0631\u0642*"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Your voice makes *a difference*"
        },
        {
          "alias": "intro",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0634\u0627\u0631\u0643\u0646\u0627 \u0622\u0631\u0627\u0621\u0643 \u0648\u0623\u0641\u0643\u0627\u0631\u0643 \u0644\u0646\u0637\u0648\u0651\u0631 \u062E\u062F\u0645\u0627\u062A\u0646\u0627 \u0645\u0639\u064B\u0627."
        },
        {
          "alias": "intro",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Share your views and ideas so we can improve our services together."
        },
