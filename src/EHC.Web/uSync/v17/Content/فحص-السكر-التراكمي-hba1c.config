  <Properties>
    <about>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u064A\u0642\u064A\u0633 \u0627\u0644\u0641\u062D\u0635 \u0646\u0633\u0628\u0629 \u0627\u0644\u0633\u0643\u0631 \u0627\u0644\u0645\u0644\u062A\u0635\u0642 \u0628\u0627\u0644\u0647\u064A\u0645\u0648\u062C\u0644\u0648\u0628\u064A\u0646 \u0641\u064A \u062E\u0644\u0627\u064A\u0627 \u0627\u0644\u062F\u0645 \u0627\u0644\u062D\u0645\u0631\u0627\u0621\u060C \u0641\u064A\u0639\u0637\u064A \u0635\u0648\u0631\u0629 \u0639\u0646 \u0645\u062A\u0648\u0633\u0637 \u0627\u0644\u0633\u0643\u0631 \u0644\u0639\u062F\u0629 \u0623\u0634\u0647\u0631 \u0628\u062F\u0644\u064B\u0627 \u0645\u0646 \u0644\u062D\u0638\u0629 \u0648\u0627\u062D\u062F\u0629.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EIt measures how much sugar is attached to the haemoglobin in your red blood cells. This gives a picture of your average blood sugar over several months rather than at one moment.\u003C/p\u003E"
}]]></Value>
    </about>
    <alsoKnownAs>
      <Value Culture="ar-SA"><![CDATA[السكر التراكمي، الهيموجلوبين السكري، A1c]]></Value>
