# Copy to deploy/oracle.env (not committed) for deploy-oracle.ps1.
# Public IP address of the VM (Oracle console: Compute > Instances > the instance > Public IP address)
EHC_ORACLE_HOST=203.0.113.10
# SSH user: ubuntu on Oracle's Ubuntu images
EHC_ORACLE_USER=ubuntu
# Private key saved when the instance was created
EHC_ORACLE_KEY=C:\Users\me\.ssh\ehc-oracle.key
# Site address; its DNS A record must point to the VM before -Setup so the HTTPS certificate can be issued
EHC_ORACLE_DOMAIN=ehctest.site
# linux-arm64 for Ampere (Always Free) shapes, linux-x64 for AMD/Intel shapes
# EHC_ORACLE_RUNTIME=linux-arm64
