                              "culture": "ar-SA",
                              "editorAlias": null,
                              "segment": null,
                              "value": "\u062A\u0648\u0635\u064A \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0635\u062D\u0629 \u0628\u0641\u062D\u0635 \u0627\u0644\u0645\u0627\u0645\u0648\u062C\u0631\u0627\u0645 \u0643\u0644 \u0633\u0646\u062A\u064A\u0646 \u0644\u0644\u0646\u0633\u0627\u0621 \u0645\u0646 \u0639\u0645\u0631 40 \u0639\u0627\u0645\u064B\u0627."
