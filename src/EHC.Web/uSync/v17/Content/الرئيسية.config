                    "alias": "ctaLabel",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0641\u062A\u062D \u0635\u062D\u062A\u064A"
                  },
                  {
                    "alias": "ctaLink",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "\u0635\u062D\u062A\u064A",
                        "target": "_blank",
                        "unique": null,
                        "type": null,
                        "udi": null,
