        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u062D\u064A\u062B \u064A\u0644\u062A\u0642\u064A *\u0627\u0644\u062E\u0628\u0631\u0629* \u0628\u0627\u0644\u062A\u0642\u0646\u064A\u0629"
        },
        {
          "alias": "intro",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0645\u0631\u0627\u0643\u0632 \u0645\u062A\u062E\u0635\u0635\u0629 \u0628\u0645\u0639\u0627\u064A\u064A\u0631 \u0639\u0627\u0644\u0645\u064A\u0629\u060C \u062F\u0648\u0646 \u0627\u0644\u062D\u0627\u062C\u0629 \u0644\u0644\u0633\u0641\u0631 \u0628\u0639\u064A\u062F\u064B\u0627 \u0639\u0646 \u0627\u0644\u0645\u0646\u0637\u0642\u0629."
        },
        {
          "alias": "eyebrow",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Centers of excellence"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Where *expertise* meets technology"
        },
        {
          "alias": "intro",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Specialist centers built to international standards, without leaving the region."
