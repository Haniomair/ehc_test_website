          "editorAlias": null,
          "segment": null,
          "value": "\u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0627\u0641\u062A\u0631\u0627\u0636\u064A\u0629\n\u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0627\u0644\u0645\u0646\u0632\u0644\u064A\u0629\n\u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0627\u0644\u0623\u0648\u0644\u064A\u0629\n\u0627\u0644\u0645\u0633\u062A\u0634\u0641\u064A\u0627\u062A"
        },
        {
          "alias": "eyebrow",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "The Saudi Model of Care"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Integrated care for *your needs*, at every stage"
        },
        {
          "alias": "intro",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "A person-centred model: six systems of care that meet your physical, psychological and social needs, from before pregnancy to the last phase of life."
        },
        {
          "alias": "centerLabel",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "You"
        },
        {
          "alias": "centerText",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "at the centre of care"
        },
        {
          "alias": "layersHeading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Care reaches you through"
        },
        {
          "alias": "layers",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Virtual care\nHome health care\nPrimary health care\nHospitals"
        }
      ]
    }
  ],
