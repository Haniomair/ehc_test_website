                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Keep Well"
                  },
                  {
                    "alias": "summary",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Prevention, health awareness and empowering people"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Promotes prevention and healthy living through initiatives like nutrition awareness, physical activity campaigns and smoking cessation."
                  },
                  {
                    "alias": "points",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Health education and awareness\nHealthy eating and physical activity\nQuitting smoking"
                  },
                  {
                    "alias": "link",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
