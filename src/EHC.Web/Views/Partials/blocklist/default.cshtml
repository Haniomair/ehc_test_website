@* Renders every block through ONE wrapper that applies the shared blockSettings:
   hide, showFrom/showUntil, variant, spacing, anchorId, themeOverride (a Theme node: its colours as inline CSS variables). Components never repeat this logic.
   With the look customizer on (Site/Customizer.cs), a reviewer's hidden/reordered sections apply here and each section
   carries data-block-key so the panel can list it. *@
@using EHC.Web.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListModel>
@inject IPublishedValueFallback Fallback
@inject TimeProvider Clock
@inject System.Text.Encodings.Web.HtmlEncoder Encoder
@{
    if (Model is null || !Model.Any()) { return; }
    var now = Clock.GetUtcNow().UtcDateTime;
    var customizing = EHC.Web.Site.Customizer.IsOn(Context);
    var custom = EHC.Web.Site.Customizer.Current(Context);
    var embedded = HeroNavigator.Embedded(Model, custom?.HeroPanel);   // care navigator shown inside the hero instead
    var blocks = custom is null ? Model.ToList() : custom.Arrange(Model.ToList(), b => b.ContentKey);
}
@foreach (var block in blocks)
{
    if (block?.Content is null) { continue; }
    if (custom is not null && custom.IsHidden(block.ContentKey)) { continue; }
    var wrap = BlockSection.From(block.Settings, Fallback, now);
    if (!wrap.Visible) { continue; }
    if (embedded is not null && block.ContentKey == embedded.ContentKey) { continue; }
    var alias = block.Content.ContentType.Alias;

    @* render first: a block with no usable content produces no wrapper (and no empty padding) *@
    var inner = await Html.PartialAsync("blocklist/Components/" + alias, block);
    using var writer = new System.IO.StringWriter();
    inner.WriteTo(writer, Encoder);
    var html = writer.ToString();
    if (string.IsNullOrWhiteSpace(html)) { continue; }

    <section id="@wrap.AnchorId" data-block="@alias"@HtmlAttributes.Data("block-key", customizing ? EHC.Web.Site.Customizer.ShortKey(block.ContentKey) : null) class="@wrap.CssClass" style="@wrap.ThemeStyle">
        @Html.Raw(html)
    </section>
}
