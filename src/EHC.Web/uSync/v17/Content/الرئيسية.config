        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0631\u0639\u0627\u064A\u0629 *\u0642\u0631\u064A\u0628\u0629 \u0645\u0646\u0643* \u0641\u064A \u0643\u0644 \u0645\u062D\u0627\u0641\u0638\u0629"
