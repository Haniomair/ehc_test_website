    {
      "contentTypeKey": "4c866ca3-1898-4534-b496-ae2c1924bf3f",
      "key": "22c670c6-58d6-4605-b0be-c1333bf166ff",
      "values": [
        {
          "alias": "quotes",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "e3f4aa85-9567-4164-acf3-eb6aa004d9ba",
                "key": "6a9bd537-5c00-418f-b8d4-7384527e3d0f",
                "values": [
                  {
                    "alias": "rating",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "5"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u00AB\u0627\u0633\u062A\u0642\u0628\u0627\u0644 \u0631\u0627\u0642\u064D \u0648\u0645\u062A\u0627\u0628\u0639\u0629 \u062F\u0642\u064A\u0642\u0629. \u0634\u0639\u0631\u062A \u0623\u0646\u0646\u064A \u0628\u064A\u0646 \u0623\u0647\u0644\u064A.\u00BB"
                  },
                  {
                    "alias": "attribution",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0645\u0631\u0627\u062C\u0639 (\u0627\u0642\u062A\u0628\u0627\u0633 \u062A\u0648\u0636\u064A\u062D\u064A)"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u201CWarm welcome and careful follow-up. I felt like I was among family.\u201D"
                  },
                  {
                    "alias": "attribution",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Visitor (illustrative)"
                  }
                ]
              },
              {
                "contentTypeKey": "e3f4aa85-9567-4164-acf3-eb6aa004d9ba",
                "key": "59073d3e-b7d0-4acf-b7ad-388bdd64e5d8",
                "values": [
                  {
                    "alias": "rating",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": "5"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u00AB\u062D\u062C\u0632\u062A \u0639\u0628\u0631 \u0635\u062D\u062A\u064A \u0648\u062E\u0644\u0627\u0644 \u0623\u064A\u0627\u0645 \u0643\u0646\u062A \u0639\u0646\u062F \u0627\u0644\u0627\u0633\u062A\u0634\u0627\u0631\u064A.\u00BB"
                  },
                  {
                    "alias": "attribution",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0645\u0631\u064A\u0636 (\u0627\u0642\u062A\u0628\u0627\u0633 \u062A\u0648\u0636\u064A\u062D\u064A)"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u201CI booked through Sehhaty and saw the consultant within days.\u201D"
                  },
                  {
                    "alias": "attribution",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Patient (illustrative)"
                  }
                ]
              }
            ],
            "settingsData": [],
