@* Find a doctor: filter by specialty, facility and language (query string, works without JS), 12 per page. *@
@using System.Globalization
@using EHC.Web.Site
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "master.cshtml";
    var req = Context.Request;
    var all = Model.Children().Where(c => c.ContentType.Alias == "doctor").ToList();
    var home = Model.AncestorOrSelf("home");
    var specialties = home?.DescendantsOfType("specialty").OrderBy(s => s.Name).ToList() ?? [];
    var facilities = home?.DescendantsOfType("facility").OrderBy(f => f.Name).ToList() ?? [];
    var languages = all.SelectMany(d => d.Value<IEnumerable<string>>("languages") ?? []).Distinct().OrderBy(l => l).ToList();

    var fSpec = ListingQuery.Key(req, "specialty");
    var fFac = ListingQuery.Key(req, "facility");
    string? fLang = req.Query["language"];
    if (fLang is not null && !languages.Contains(fLang)) { fLang = null; }

    var list = all
        .Where(d => fSpec is null || d.Value<IPublishedContent>("specialty")?.Key == fSpec)
        .Where(d => fFac is null || (d.Value<IEnumerable<IPublishedContent>>("facilities") ?? []).Any(f => f.Key == fFac))
        .Where(d => fLang is null || (d.Value<IEnumerable<string>>("languages") ?? []).Contains(fLang))
        .OrderBy(d => d.Name).ToList();
    const int size = 12;
    var pages = Math.Max(1, (int)Math.Ceiling(list.Count / (double)size));
    var page = Math.Min(ListingQuery.CurrentPage(req), pages);
    string Lang(string code) { try { return CultureInfo.GetCultureInfo(code).NativeName; } catch (CultureNotFoundException) { return code; } }
}
@await Html.PartialAsync("site/_PageHeader", Model)
<div class="wrap py-10 lg:py-14">
    <form method="get" class="card mb-8 grid gap-4 p-5 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1fr_auto] lg:items-end" aria-label="@Umbraco.GetDictionaryValue("EHC.Doctors.Filter")">
        <label class="grid gap-1.5 text-sm font-semibold">@Umbraco.GetDictionaryValue("EHC.Doctors.Specialty")
            <select name="specialty" class="h-11 rounded-xl border border-slate-200 bg-white px-3 font-normal dark:border-white/15 dark:bg-night-900">
                <option value="">@Umbraco.GetDictionaryValue("EHC.Common.All")</option>
                @foreach (var s in specialties) { <option value="@s.Key" selected="@(s.Key == fSpec)">@s.Name</option> }
            </select>
        </label>
        <label class="grid gap-1.5 text-sm font-semibold">@Umbraco.GetDictionaryValue("EHC.Doctors.Facility")
            <select name="facility" class="h-11 rounded-xl border border-slate-200 bg-white px-3 font-normal dark:border-white/15 dark:bg-night-900">
                <option value="">@Umbraco.GetDictionaryValue("EHC.Common.All")</option>
                @foreach (var f in facilities) { <option value="@f.Key" selected="@(f.Key == fFac)">@f.Name</option> }
            </select>
        </label>
        <label class="grid gap-1.5 text-sm font-semibold">@Umbraco.GetDictionaryValue("EHC.Doctors.Language")
            <select name="language" class="h-11 rounded-xl border border-slate-200 bg-white px-3 font-normal dark:border-white/15 dark:bg-night-900">
                <option value="">@Umbraco.GetDictionaryValue("EHC.Common.All")</option>
                @foreach (var l in languages) { <option value="@l" selected="@(l == fLang)">@Lang(l)</option> }
            </select>
        </label>
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary !py-2.5">@Umbraco.GetDictionaryValue("EHC.Common.Apply")</button>
            @if (fSpec is not null || fFac is not null || fLang is not null) { <a href="@req.Path" class="btn btn-ghost !py-2.5">@Umbraco.GetDictionaryValue("EHC.Common.Clear")</a> }
        </div>
    </form>
    <p class="mb-5 text-sm text-slate-500" role="status">@string.Format(Umbraco.GetDictionaryValue("EHC.Common.ResultCount") ?? "{0}", list.Count)</p>
    @if (list.Count == 0)
    {
        <p class="card p-10 text-center text-slate-500">@Umbraco.GetDictionaryValue("EHC.Common.NoResults")</p>
    }
    else
    {
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var d in list.Skip((page - 1) * size).Take(size)) { @await Html.PartialAsync("cards/_DoctorCard", d) }
        </div>
        @await Html.PartialAsync("site/_Pager", (page, pages))
    }
</div>
