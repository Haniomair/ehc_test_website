@* Share & print bar: plain share links (WhatsApp, X, LinkedIn, email) built on the server — no third-party scripts or
   trackers — plus copy link, print, and the device share sheet where the browser supports it (components/share.js). *@
@using System.Text.Encodings.Web
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var c = Model.Content;
    var page = Umbraco.AssignedContentItem;
    var url = page.Url(mode: global::Umbraco.Cms.Core.Models.PublishedContent.UrlMode.Absolute);
    var title = page.Name ?? "";
    var u = UrlEncoder.Default.Encode(url);
    var t = UrlEncoder.Default.Encode(title);
    var label = c.Value<string>("label");
    if (string.IsNullOrWhiteSpace(label)) { label = Umbraco.GetDictionaryValue("EHC.Share.Title"); }
    var align = c.Value<string>("align") == "center" ? "justify-center" : "";
    var btn = "grid h-11 w-11 place-items-center rounded-full border border-slate-200 bg-white text-deep-900 transition hover:border-brand-500 hover:text-brand-600 dark:border-white/15 dark:bg-white/5 dark:text-slate-100 dark:hover:border-brand-400 dark:hover:text-brand-300";
    var newWindow = Umbraco.GetDictionaryValue("EHC.Common.NewWindow");
}
<div class="wrap">
    <div class="rv flex flex-wrap items-center gap-3 border-y border-slate-200 py-4 dark:border-white/10 @align" data-share>
        <b class="me-2 text-sm text-deep-900 dark:text-white">@label</b>
        <button type="button" class="@btn" data-share-native hidden aria-label="@Umbraco.GetDictionaryValue("EHC.Share.Device")"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v7a1 1 0 001 1h14a1 1 0 001-1v-7M16 6l-4-4-4 4M12 2v14" /></svg></button>
        <a class="@btn" href="https://wa.me/?text=@t%20@u" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp @newWindow"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 01-3.3-2.9c-.3-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 00-.7.3 3 3 0 00-.9 2.2 5.2 5.2 0 001.1 2.8 11.9 11.9 0 004.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 001.9-1.3 2.3 2.3 0 00.2-1.3c-.1-.1-.2-.2-.4-.3z" /></svg></a>
        <a class="@btn" href="https://x.com/intent/post?url=@u&amp;text=@t" target="_blank" rel="noopener noreferrer" aria-label="X @newWindow"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.2 2h3.4l-7.4 8.5L23 22h-6.8l-5.3-7-6.1 7H1.4l7.9-9L1 2h7l4.8 6.4zm-1.2 18h1.9L7.1 4H5.1z" /></svg></a>
        <a class="@btn" href="https://www.linkedin.com/sharing/share-offsite/?url=@u" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn @newWindow"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.1a4.2 4.2 0 013.8-2c4 0 4.8 2.6 4.8 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V21H9z" /></svg></a>
        <a class="@btn" href="mailto:?subject=@t&amp;body=@u" aria-label="@Umbraco.GetDictionaryValue("EHC.Share.Email")"><svg class="ico !h-5 !w-5" aria-hidden="true"><use href="#i-mail" /></svg></a>
        <button type="button" class="@btn" data-share-copy aria-label="@Umbraco.GetDictionaryValue("EHC.Share.Copy")" data-done="@Umbraco.GetDictionaryValue("EHC.Share.Copied")" hidden><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1M14 10a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1" /></svg></button>
        <button type="button" class="@btn" data-share-print aria-label="@Umbraco.GetDictionaryValue("EHC.Share.Print")" hidden><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6M6 18H4a1 1 0 01-1-1v-6a2 2 0 012-2h14a2 2 0 012 2v6a1 1 0 01-1 1h-2M6 14h12v7H6z" /></svg></button>
        <span class="text-sm font-semibold text-brand-700 dark:text-brand-300" role="status" data-share-status></span>
    </div>
</div>
<script src="~/assets/js/components/share.js" asp-append-version="true" defer></script>
