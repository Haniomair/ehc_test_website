                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0642\u062F\u0651\u0645 \u0641\u0643\u0631\u062A\u0643"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Submit your idea"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0642\u062F\u0651\u0645 \u0641\u0643\u0631\u062A\u0643 \u0627\u0644\u0628\u062D\u062B\u064A\u0629 \u0645\u0646 \u062E\u0644\u0627\u0644 \u0627\u0644\u0645\u0646\u0635\u0629 \u0627\u0644\u0645\u0648\u062D\u062F\u0629 \u0644\u0644\u0623\u0628\u062D\u0627\u062B."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Submit your research idea through our unified platform."
                  }
                ]
              },
              {
                "contentTypeKey": "cf7a2e92-d24f-4c50-bed0-3622e0ef7e0d",
                "key": "ad14ad22-0d15-4d0c-a345-7423e89b561e",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "search"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u062A\u0642\u064A\u064A\u0645"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Review"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u062E\u0636\u0639 \u0627\u0644\u0641\u0643\u0631\u0629 \u0644\u0644\u062A\u0642\u064A\u064A\u0645 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0644\u062C\u0646\u0629 \u0627\u0644\u0639\u0644\u0645\u064A\u0629 \u0648\u0627\u0644\u062C\u0647\u0627\u062A \u0627\u0644\u0645\u062E\u062A\u0635\u0629."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Undergo scientific and regulatory review."
                  }
                ]
              },
              {
                "contentTypeKey": "cf7a2e92-d24f-4c50-bed0-3622e0ef7e0d",
                "key": "bd780cd8-7bc5-4cc9-9353-0427d3a54c48",
                "values": [
