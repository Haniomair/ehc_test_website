@* Bottom action bar on small screens: emergency call, primary action, nearest facility. *@
@using EHC.Web.Site
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<EHC.Web.Site.SiteData>
@if (Model.Emergency is not null || Model.HeaderCta is not null || Model.NearestLink is not null)
{
    <nav class="fixed inset-x-0 bottom-0 z-50 grid auto-cols-fr grid-flow-col border-t border-slate-200 bg-white shadow-[0_-8px_24px_rgba(10,42,79,.08)] sm:hidden dark:border-white/10 dark:bg-night-900" aria-label="@Umbraco.GetDictionaryValue("EHC.Mobile.QuickActions")">
        @if (Model.Emergency is { } e)
        {
            <a class="flex flex-col items-center gap-0.5 px-1 py-2.5 text-[.72rem] font-semibold text-emerg-600 dark:text-red-300" href="tel:@e.Dial"><svg class="ico" aria-hidden="true"><use href="#i-er" /></svg><span>@Umbraco.GetDictionaryValue("EHC.Mobile.Emergency") @e.Number</span></a>
        }
        @if (Model.HeaderCta is { } cta)
        {
            <a class="flex flex-col items-center gap-0.5 px-1 py-2.5 text-[.72rem] font-semibold text-brand-600 dark:text-brand-300" href="@cta.Url" target="@cta.Target"><svg class="ico" aria-hidden="true"><use href="#i-cal" /></svg><span>@cta.Name</span></a>
        }
        @if (Model.NearestLink is { } near)
        {
            <a class="flex flex-col items-center gap-0.5 px-1 py-2.5 text-[.72rem] font-semibold text-slate-600 dark:text-slate-300" href="@near.Url" target="@near.Target"><svg class="ico" aria-hidden="true"><use href="#i-pin" /></svg><span>@near.Name</span></a>
        }
    </nav>
    <div class="h-[68px] sm:hidden"></div>
}
