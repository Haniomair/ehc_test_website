          "segment": null,
          "value": "\u0634\u0627\u0631\u0643\u0646\u0627 \u0631\u0623\u064A\u0643"
        },
        {
          "alias": "eyebrow",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Share your feedback"
        },
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0646\u0633\u062A\u0642\u0628\u0644 \u0631\u0633\u0627\u0644\u062A\u0643 *\u0628\u0627\u0647\u062A\u0645\u0627\u0645*"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Every message *matters to us*"
        },
        {
          "alias": "intro",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u064A\u0633\u0631\u0651\u0646\u0627 \u062A\u0648\u0627\u0635\u0644\u0643 \u0645\u0639\u0646\u0627\u060C \u0648\u0646\u0633\u0639\u062F \u0628\u062E\u062F\u0645\u062A\u0643 \u0648\u0627\u0644\u0625\u062C\u0627\u0628\u0629 \u0639\u0644\u0649 \u0623\u064A \u0627\u0633\u062A\u0641\u0633\u0627\u0631. \u0645\u0646 \u0641\u0636\u0644\u0643\u060C \u0634\u0627\u0631\u0643\u0646\u0627 \u0645\u0639\u0644\u0648\u0645\u0627\u062A\u0643\u060C \u0648\u0633\u064A\u062A\u0648\u0627\u0635\u0644 \u0645\u0639\u0643 \u0641\u0631\u064A\u0642\u0646\u0627 \u0641\u064A \u0623\u0642\u0631\u0628 \u0648\u0642\u062A \u0645\u0645\u0643\u0646."
        },
        {
          "alias": "intro",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "We are glad to hear from you and happy to answer any question. Please share your details and our team will contact you as soon as possible."
