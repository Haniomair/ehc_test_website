    {
      "contentTypeKey": "4fa0d635-4129-440d-a044-6c8c8aeeb204",
      "key": "625f8e34-8eda-4ef1-a274-21e2ecebc54f",
      "values": [
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0641\u0631\u064A\u0642\u0646\u0627 \u0627\u0644\u0628\u062D\u062B\u064A"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Meet our research team"
        },
        {
          "alias": "columns",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "2"
          ]
        },
        {
          "alias": "marker",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "dot"
          ]
        },
        {
          "alias": "items",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0645\u062C\u0645\u0648\u0639\u0629 \u0645\u0646 \u0627\u0644\u0627\u0633\u062A\u0634\u0627\u0631\u064A\u064A\u0646 \u0648\u0627\u0644\u0639\u0644\u0645\u0627\u0621 \u0627\u0644\u0625\u0643\u0644\u064A\u0646\u064A\u0643\u064A\u064A\u0646 \u0648\u0627\u0644\u0628\u0627\u062D\u062B\u064A\u0646 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u064A\u0646\n\u0642\u0627\u062F\u0629 \u0645\u0646 \u0627\u0644\u0645\u062A\u062E\u0635\u0635\u064A\u0646 \u0641\u064A \u0645\u062C\u0627\u0644 \u0627\u0644\u0625\u062F\u0627\u0631\u0629 \u0648\u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0648\u0627\u0644\u0634\u0631\u0627\u0643\u0627\u062A \u0627\u0644\u0625\u0642\u0644\u064A\u0645\u064A\u0629 \u0648\u0627\u0644\u062F\u0648\u0644\u064A\u0629\n\u0623\u062E\u0635\u0627\u0626\u064A\u0648 \u0627\u0644\u0628\u064A\u0627\u0646\u0627\u062A \u0648\u0627\u0644\u062A\u062D\u0644\u064A\u0644 \u0627\u0644\u0625\u062D\u0635\u0627\u0626\u064A \u0644\u062F\u0639\u0645 \u0627\u0644\u0645\u062E\u0631\u062C\u0627\u062A \u0627\u0644\u0639\u0644\u0645\u064A\u0629 \u0627\u0644\u062F\u0642\u064A\u0642\u0629\n\u0645\u062E\u062A\u0635\u0648 \u0648\u0641\u0646\u064A\u0648 \u0627\u0644\u0645\u062E\u062A\u0628\u0631\u0627\u062A \u0627\u0644\u0637\u0628\u064A\u0629 \u0627\u0644\u062D\u064A\u0648\u064A\u0629 \u0627\u0644\u0628\u062D\u062B\u064A\u0629 \u0641\u064A \u0645\u062C\u0627\u0644\u0627\u062A \u0627\u0644\u062C\u0632\u064A\u0626\u0627\u062A \u0648\u0627\u0644\u0648\u0631\u0627\u062B\u0629 \u0648\u0627\u0644\u062A\u0642\u0646\u064A\u0627\u062A \u0627\u0644\u0645\u062A\u0642\u062F\u0645\u0629\n\u062E\u0628\u0631\u0627\u0621 \u0623\u062E\u0644\u0627\u0642\u064A\u0627\u062A \u0627\u0644\u0628\u062D\u062B \u0648\u062D\u0645\u0627\u064A\u0629 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u064A\u0646 \u0644\u0636\u0645\u0627\u0646 \u0623\u0639\u0644\u0649 \u0645\u0633\u062A\u0648\u064A\u0627\u062A \u0627\u0644\u0627\u0645\u062A\u062B\u0627\u0644 \u0648\u0627\u0644\u0633\u0644\u0627\u0645\u0629\n\u0645\u062E\u062A\u0635\u0648\u0646 \u0641\u064A \u0639\u0644\u0645 \u0627\u0644\u0623\u062F\u0648\u064A\u0629 \u0648\u0627\u0644\u062A\u0637\u0628\u064A\u0642\u0627\u062A \u0627\u0644\u0633\u0631\u064A\u0631\u064A\u0629 \u0644\u0644\u0635\u064A\u062F\u0644\u0629"
        },
        {
          "alias": "items",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Senior consultants and clinical scientists\nProject leaders and research coordinators\nData analysts and statisticians\nBiomedical lab experts\nEthics and compliance specialists\nClinical pharmacists and regulatory officers"
        }
      ]
    },
    {
      "contentTypeKey": "1a42d957-7e10-4666-91fa-0d0b08dbe775",
      "key": "189f61ff-f861-42dd-a92d-af0eec970b31",
      "values": [
        {
          "alias": "title",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0644\u062F\u064A\u0643 \u0641\u0643\u0631\u0629 \u0628\u062D\u062B\u064A\u0629\u061F"
        },
        {
          "alias": "title",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Have a research idea?"
        },
        {
          "alias": "text",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u062A\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 \u0648\u0633\u0646\u0631\u0634\u062F\u0643 \u0625\u0644\u0649 \u0627\u0644\u062E\u0637\u0648\u0629 \u0627\u0644\u062A\u0627\u0644\u064A\u0629."
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Get in touch and we will guide you to the next step."
        },
        {
          "alias": "primaryCta",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": [
