        {
          "alias": "intro",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0646\u062F\u0639\u0645 \u0627\u0644\u0628\u0627\u062D\u062B\u064A\u0646 \u0641\u064A \u062C\u0645\u064A\u0639 \u0645\u0631\u0627\u062D\u0644 \u0645\u0634\u0627\u0631\u064A\u0639\u0647\u0645."
