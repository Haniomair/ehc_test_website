    <NodeName Default="تجمع الشرقية الصحي يطلق حملة «تعلّم بصحة» مع العودة إلى المدارس">
      <Name Culture="ar-SA">تجمع الشرقية الصحي يطلق حملة «تعلّم بصحة» مع العودة إلى المدارس</Name>
      <Name Culture="en-US">EHC launches “Learn Healthy” as students head back to school</Name>
    </NodeName>
    <SortOrder>0</SortOrder>
    <Published Default="true">
      <Published Culture="ar-SA">true</Published>
      <Published Culture="en-US">true</Published>
    </Published>
