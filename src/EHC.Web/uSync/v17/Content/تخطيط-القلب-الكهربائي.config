    <prepare>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u0644\u0627 \u064A\u062D\u062A\u0627\u062C \u0625\u0644\u0649 \u062A\u062D\u0636\u064A\u0631 \u062E\u0627\u0635. \u0627\u0631\u062A\u062F\u0650 \u0645\u0644\u0627\u0628\u0633 \u064A\u0633\u0647\u0644 \u062E\u0644\u0639 \u0627\u0644\u062C\u0632\u0621 \u0627\u0644\u0639\u0644\u0648\u064A \u0645\u0646\u0647\u0627\u060C \u0648\u062A\u062C\u0646\u0651\u0628 \u0627\u0644\u0643\u0631\u064A\u0645\u0627\u062A \u0639\u0644\u0649 \u0627\u0644\u0635\u062F\u0631.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EYou don\u0026#39;t need to prepare. Wear clothes that make it easy to uncover your chest, and avoid creams on your chest.\u003C/p\u003E"
}]]></Value>
    </prepare>
    <relatedConditions>
      <Value><![CDATA[umb://document/2e10e53bbd58421a8f9ba46ad3532feb]]></Value>
    </relatedConditions>
    <results>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u064A\u0642\u0631\u0623 \u0627\u0644\u0637\u0628\u064A\u0628 \u0627\u0644\u062A\u062E\u0637\u064A\u0637\u060C \u0648\u0642\u062F \u064A\u0637\u0644\u0628 \u0641\u062D\u0648\u0635\u0627\u062A \u0623\u062E\u0631\u0649 \u0645\u062B\u0644 \u062A\u062E\u0637\u064A\u0637 \u0635\u062F\u0649 \u0627\u0644\u0642\u0644\u0628 \u0623\u0648 \u0627\u062E\u062A\u0628\u0627\u0631 \u0627\u0644\u062C\u0647\u062F.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EA doctor reads the ECG and may ask for other tests, such as an echocardiogram or an exercise test.\u003C/p\u003E"
}]]></Value>
    </results>
    <reviewedBy>
      <Value Culture="ar-SA"><![CDATA[اسم الطبيب]]></Value>
      <Value Culture="en-US"><![CDATA[Doctor Name]]></Value>
