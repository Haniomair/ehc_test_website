  "contentData": [
    {
      "contentTypeKey": "7f2469b8-9405-4339-9fd8-0de2eeb7a5aa",
      "key": "a0d88c92-7d54-4bb5-9375-74229edc78c1",
      "values": [
        {
          "alias": "eyebrow",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u062D\u0642\u0648\u0642 \u0627\u0644\u0645\u0631\u0636\u0649"
        },
        {
          "alias": "eyebrow",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Patient rights"
        },
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u062D\u0642\u0648\u0642\u0643 *\u0645\u062D\u0641\u0648\u0638\u0629*"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Your rights are *protected*"
        },
        {
          "alias": "body",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003E\u062A\u0648\u0644\u064A \u0627\u0644\u0645\u0646\u0638\u0648\u0645\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0641\u064A \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064A\u0629 \u0627\u0644\u0633\u0639\u0648\u062F\u064A\u0629 \u0627\u0647\u062A\u0645\u0627\u0645\u064B\u0627 \u0628\u0627\u0644\u063A\u064B\u0627 \u0628\u062D\u0642\u0648\u0642 \u0627\u0644\u0645\u0631\u0636\u0649\u060C \u0625\u062F\u0631\u0627\u0643\u064B\u0627 \u0644\u0623\u0647\u0645\u064A\u0629 \u062A\u0639\u0632\u064A\u0632 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0628\u064A\u0646 \u0627\u0644\u0645\u0631\u064A\u0636 \u0648\u0645\u0642\u062F\u0651\u0645 \u0627\u0644\u062E\u062F\u0645\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0639\u0644\u0649 \u0623\u0633\u0633 \u0645\u0646 \u0627\u0644\u0643\u0631\u0627\u0645\u0629 \u0627\u0644\u0625\u0646\u0633\u0627\u0646\u064A\u0629\u060C \u0648\u0627\u0644\u0639\u062F\u0627\u0644\u0629\u060C \u0648\u0627\u0644\u0634\u0641\u0627\u0641\u064A\u0629\u060C \u0648\u0627\u0644\u0627\u062D\u062A\u0631\u0627\u0645 \u0627\u0644\u0645\u062A\u0628\u0627\u062F\u0644.\u003C/p\u003E\u003Cp\u003E\u0648\u0644\u0627 \u062A\u0642\u062A\u0635\u0631 \u062D\u0642\u0648\u0642 \u0627\u0644\u0645\u0631\u0636\u0649 \u0639\u0644\u0649 \u0627\u0644\u062C\u0648\u0627\u0646\u0628 \u0627\u0644\u0639\u0644\u0627\u062C\u064A\u0629 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629 \u0641\u062D\u0633\u0628\u060C \u0628\u0644 \u062A\u0634\u0645\u0644 \u0625\u0637\u0627\u0631\u064B\u0627 \u0623\u0648\u0633\u0639 \u064A\u062A\u0646\u0627\u0648\u0644 \u0645\u062E\u062A\u0644\u0641 \u0623\u0648\u062C\u0647 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0628\u064A\u0646 \u0627\u0644\u0645\u0631\u064A\u0636 \u0648\u0627\u0644\u0645\u0646\u0638\u0648\u0645\u0629 \u0627\u0644\u0635\u062D\u064A\u0629.\u003C/p\u003E"
          }
        },
        {
          "alias": "body",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EThe healthcare system in the Kingdom of Saudi Arabia places great importance on patients\u0027 rights, recognizing that safeguarding these rights is a fundamental cornerstone in the delivery of humane, safe, and comprehensive healthcare.\u003C/p\u003E\u003Cp\u003EPatients\u0027 rights go far beyond receiving medical treatment. They encompass a broad spectrum of protections and entitlements designed to uphold the patient\u0027s autonomy, respect their privacy, and ensure fair and dignified treatment throughout their healthcare journey.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "aad399dd-0ff9-4dee-ba97-bd96d57fdbcd",
      "key": "5ef83e84-4913-4c92-a919-0c32de91c6c5",
      "values": [
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0645\u0627 \u062A\u0634\u0645\u0644\u0647 \u062D\u0642\u0648\u0642\u0643"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "What your rights cover"
        },
        {
          "alias": "intro",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0643\u0645\u0627 \u062A\u0648\u0636\u062D\u0647\u0627 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0635\u062D\u0629."
        },
        {
          "alias": "intro",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "As set out by the Ministry of Health."
        },
        {
          "alias": "style",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "cards"
          ]
        },
        {
          "alias": "columns",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "3"
          ]
        },
        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "546f6fb0-eabb-4e10-becb-824274e5ad85",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "hosp"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0631\u0639\u0627\u064A\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Access to care"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062D\u0642\u0643 \u0641\u064A \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u062E\u062F\u0645\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0628\u064A\u0633\u0631."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Your right to access healthcare easily."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "df11866f-2c8d-4677-99ec-78f5199ff597",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "doc"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0645\u0639\u0644\u0648\u0645\u0627\u062A \u0648\u0627\u0636\u062D\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Clear information"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0645\u0639\u0644\u0648\u0645\u0627\u062A \u062F\u0642\u064A\u0642\u0629 \u0648\u0648\u0627\u0636\u062D\u0629 \u062D\u0648\u0644 \u062D\u0627\u0644\u062A\u0643 \u0627\u0644\u0635\u062D\u064A\u0629 \u0648\u062A\u0634\u062E\u064A\u0635\u0643 \u0648\u062E\u064A\u0627\u0631\u0627\u062A \u0627\u0644\u0639\u0644\u0627\u062C \u0627\u0644\u0645\u062A\u0627\u062D\u0629."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Clear and accurate information about your condition, your diagnosis and the treatment options available."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "4ffe68e9-654d-4e62-86ee-502fa477700b",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "hand"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0642\u0631\u0627\u0631 \u0644\u0643"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Your decision"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u062A\u062E\u0627\u0630 \u0642\u0631\u0627\u0631\u0627\u062A \u0645\u0633\u062A\u0646\u064A\u0631\u0629 \u0628\u0634\u0623\u0646 \u0631\u0639\u0627\u064A\u062A\u0643\u060C \u0628\u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0623\u0648 \u0627\u0644\u0631\u0641\u0636\u060C \u062F\u0648\u0646 \u0623\u064A \u0636\u063A\u0637 \u0623\u0648 \u062A\u0645\u064A\u064A\u0632."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Making informed decisions about your care, to consent or refuse, without pressure or discrimination."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "4eb75539-92c2-47a9-9bc2-43f53e54a08c",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "shield"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u062E\u0635\u0648\u0635\u064A\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Privacy"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0636\u0645\u0627\u0646 \u062E\u0635\u0648\u0635\u064A\u0629 \u0645\u0639\u0644\u0648\u0645\u0627\u062A\u0643 \u0627\u0644\u0635\u062D\u064A\u0629."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Confidentiality of your health information."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "be763085-2297-47b6-ae46-2a487e308421",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "users"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0627\u062D\u062A\u0631\u0627\u0645 \u0648\u0627\u0644\u0639\u062F\u0627\u0644\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Respect and fairness"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0627\u062D\u062A\u0631\u0627\u0645 \u0627\u0644\u0643\u0627\u0645\u0644 \u0644\u062B\u0642\u0627\u0641\u062A\u0643 \u0648\u0645\u0639\u062A\u0642\u062F\u0627\u062A\u0643\u060C \u0648\u062A\u0642\u062F\u064A\u0645 \u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0628\u0639\u062F\u0627\u0644\u0629 \u0648\u0634\u0641\u0627\u0641\u064A\u0629."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Full respect for your culture and beliefs, and care given fairly and transparently."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "4e02d032-5751-403a-a6dc-ae4694f9492d",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "chat"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0634\u0643\u0648\u0649 \u0648\u0627\u0644\u0631\u062F"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Complaints and answers"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0642\u062F\u064A\u0645 \u0627\u0644\u0634\u0643\u0627\u0648\u0649 \u0648\u0627\u0644\u0627\u0639\u062A\u0631\u0627\u0636\u0627\u062A \u0648\u062A\u0644\u0642\u064A \u0627\u0644\u0631\u062F\u0648\u062F \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u0639\u0644\u064A\u0647\u0627 \u0636\u0645\u0646 \u0622\u0644\u064A\u0627\u062A \u0648\u0627\u0636\u062D\u0629."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Making complaints and objections and receiving appropriate answers through clear procedures."
                  }
                ]
              }
            ],
            "settingsData": [],
            "expose": [
