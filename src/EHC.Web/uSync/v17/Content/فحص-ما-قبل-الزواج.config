    </careFacilities>
    <during>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u062A\u064F\u0633\u062D\u0628 \u0639\u064A\u0646\u0629 \u062F\u0645 \u0645\u0646 \u0643\u0644 \u0645\u0646 \u0627\u0644\u062E\u0627\u0637\u0628\u064A\u0646 \u0641\u064A \u0645\u0631\u0643\u0632 \u0635\u062D\u064A \u0645\u0639\u062A\u0645\u062F.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EA blood sample is taken from each partner at an approved health centre.\u003C/p\u003E"
}]]></Value>
    </during>
