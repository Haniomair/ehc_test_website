                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0646\u0636\u0645 \u0625\u0644\u0649 \u0623\u0643\u0628\u0631 \u0641\u0631\u064A\u0642 \u0631\u0639\u0627\u064A\u0629 \u0635\u062D\u064A\u0629 \u0641\u064A \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0634\u0631\u0642\u064A\u0629."
