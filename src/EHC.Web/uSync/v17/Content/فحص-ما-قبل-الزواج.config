    <prepare>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u064A\u064F\u0646\u0635\u062D \u0628\u0625\u062C\u0631\u0627\u0621 \u0627\u0644\u0641\u062D\u0635 \u0642\u0628\u0644 \u0645\u0648\u0639\u062F \u0627\u0644\u0632\u0648\u0627\u062C \u0628\u062B\u0644\u0627\u062B\u0629 \u0623\u0634\u0647\u0631 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644\u060C \u0644\u0623\u0646 \u0627\u0644\u0634\u0647\u0627\u062F\u0629 \u0635\u0627\u0644\u062D\u0629 \u0644\u0645\u062F\u0629 \u0645\u062D\u062F\u0648\u062F\u0629. \u0644\u0627 \u064A\u062D\u062A\u0627\u062C \u0625\u0644\u0649 \u0635\u064A\u0627\u0645.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EHave the test at least 3 months before the wedding, as the certificate is valid for a limited time. You don\u0026#39;t need to fast.\u003C/p\u003E"
}]]></Value>
    </prepare>
    <relatedConditions>
      <Value><![CDATA[umb://document/e001f6a5b59b44d28477ce67d3ad8580]]></Value>
    </relatedConditions>
    <results>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u064A\u062D\u0635\u0644 \u0627\u0644\u062E\u0627\u0637\u0628\u0627\u0646 \u0639\u0644\u0649 \u0634\u0647\u0627\u062F\u0629 \u0627\u0644\u0641\u062D\u0635. \u0648\u0625\u0630\u0627 \u062A\u0628\u064A\u0651\u0646 \u0627\u062D\u062A\u0645\u0627\u0644 \u0644\u0625\u0646\u062C\u0627\u0628 \u0623\u0637\u0641\u0627\u0644 \u0645\u0635\u0627\u0628\u064A\u0646 \u0623\u0648 \u0627\u0643\u062A\u064F\u0634\u0641 \u0645\u0631\u0636 \u0645\u0639\u062F\u064D\u060C \u062A\u064F\u0642\u062F\u064E\u0651\u0645 \u0644\u0647\u0645\u0627 \u0627\u0644\u0627\u0633\u062A\u0634\u0627\u0631\u0629 \u0627\u0644\u0648\u0631\u0627\u062B\u064A\u0629 \u0623\u0648 \u0627\u0644\u0639\u0644\u0627\u062C \u0627\u0644\u0645\u0646\u0627\u0633\u0628.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EThe couple receive a screening certificate. If there is a chance of having affected children, or an infection is found, they are offered genetic counselling or treatment.\u003C/p\u003E"
}]]></Value>
    </results>
    <reviewedBy>
      <Value Culture="ar-SA"><![CDATA[اسم الطبيب]]></Value>
      <Value Culture="en-US"><![CDATA[Doctor Name]]></Value>
