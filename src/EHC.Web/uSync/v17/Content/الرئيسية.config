                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Chronic Care"
                  },
                  {
                    "alias": "summary",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Early detection and timely diagnosis"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Focuses on screening and early detection of common conditions such as cancer, diabetes, hypertension and obesity, with ongoing follow-up."
                  },
                  {
                    "alias": "points",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Screening and early detection\nCoordinated, continuous follow-up\nSupport to manage your condition"
                  },
                  {
                    "alias": "link",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "Early screening for chronic diseases",
