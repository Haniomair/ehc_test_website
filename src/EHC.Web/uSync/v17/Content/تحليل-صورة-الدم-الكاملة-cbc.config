  <Properties>
    <about>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u0645\u0646 \u0623\u0643\u062B\u0631 \u062A\u062D\u0627\u0644\u064A\u0644 \u0627\u0644\u062F\u0645 \u0634\u064A\u0648\u0639\u064B\u0627. \u064A\u0642\u064A\u0633 \u0639\u062F\u062F \u062E\u0644\u0627\u064A\u0627 \u0627\u0644\u062F\u0645 \u0627\u0644\u062D\u0645\u0631\u0627\u0621 \u0648\u0627\u0644\u0628\u064A\u0636\u0627\u0621 \u0648\u0627\u0644\u0635\u0641\u0627\u0626\u062D \u0627\u0644\u062F\u0645\u0648\u064A\u0629\u060C \u0648\u0646\u0633\u0628\u0629 \u0627\u0644\u0647\u064A\u0645\u0648\u062C\u0644\u0648\u0628\u064A\u0646 \u0627\u0644\u0630\u064A \u064A\u0646\u0642\u0644 \u0627\u0644\u0623\u0643\u0633\u062C\u064A\u0646.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EOne of the most common blood tests. It measures the number of red cells, white cells and platelets, and the haemoglobin that carries oxygen.\u003C/p\u003E"
}]]></Value>
    </about>
    <alsoKnownAs>
