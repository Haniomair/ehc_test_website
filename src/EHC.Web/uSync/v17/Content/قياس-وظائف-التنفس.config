    <prepare>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cul\u003E\u003Cli\u003E\u062A\u062C\u0646\u0651\u0628 \u0627\u0644\u062A\u062F\u062E\u064A\u0646 \u0648\u0627\u0644\u0648\u062C\u0628\u0627\u062A \u0627\u0644\u062B\u0642\u064A\u0644\u0629 \u0648\u0627\u0644\u0645\u062C\u0647\u0648\u062F \u0627\u0644\u0634\u062F\u064A\u062F \u0642\u0628\u0644 \u0627\u0644\u0641\u062D\u0635 \u0628\u0633\u0627\u0639\u0627\u062A\u003C/li\u003E\u003Cli\u003E\u0627\u0631\u062A\u062F\u0650 \u0645\u0644\u0627\u0628\u0633 \u0645\u0631\u064A\u062D\u0629\u003C/li\u003E\u003Cli\u003E\u0642\u062F \u064A\u064F\u0637\u0644\u0628 \u0645\u0646\u0643 \u0627\u0644\u062A\u0648\u0642\u0641 \u0639\u0646 \u0628\u0639\u0636 \u0627\u0644\u0628\u062E\u0627\u062E\u0627\u062A \u0642\u0628\u0644 \u0627\u0644\u0641\u062D\u0635\u060C \u0641\u0627\u062A\u0628\u0639 \u0627\u0644\u062A\u0639\u0644\u064A\u0645\u0627\u062A\u003C/li\u003E\u003C/ul\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cul\u003E\u003Cli\u003EAvoid smoking, heavy meals and hard exercise in the hours before the test\u003C/li\u003E\u003Cli\u003EWear loose, comfortable clothes\u003C/li\u003E\u003Cli\u003EYou may be asked to stop some inhalers beforehand: follow the instructions you are given\u003C/li\u003E\u003C/ul\u003E"
}]]></Value>
    </prepare>
    <relatedConditions>
      <Value><![CDATA[umb://document/a5892b084d2f4d6a94592a97e3a7d729]]></Value>
