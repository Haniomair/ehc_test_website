    <NodeName Default="سمو أمير المنطقة الشرقية يكرّم التجمع لجهوده في مبادرة «سحابة أمل»">
      <Name Culture="ar-SA">سمو أمير المنطقة الشرقية يكرّم التجمع لجهوده في مبادرة «سحابة أمل»</Name>
      <Name Culture="en-US">Eastern Province Governor honors EHC for the “Cloud of Hope” initiative</Name>
    </NodeName>
    <SortOrder>7</SortOrder>
    <Published Default="true">
      <Published Culture="ar-SA">true</Published>
      <Published Culture="en-US">true</Published>
    </Published>
