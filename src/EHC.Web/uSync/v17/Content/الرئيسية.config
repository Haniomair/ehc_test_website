                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0645\u062C\u062F\u0648\u0644\u0629"
                  },
                  {
                    "alias": "summary",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0642\u0644\u064A\u0644 \u0639\u062F\u062F \u0632\u064A\u0627\u0631\u0627\u062A \u0627\u0644\u0645\u0633\u062A\u0634\u0641\u064A\u0627\u062A \u0648\u062A\u0642\u0644\u064A\u0644 \u0645\u062F\u0629 \u0627\u0644\u0625\u0642\u0627\u0645\u0629"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u062F\u0639\u0645 \u0645\u0646 \u064A\u062D\u062A\u0627\u062C\u0648\u0646 \u0625\u0644\u0649 \u062A\u062F\u062E\u0644\u0627\u062A \u062C\u0631\u0627\u062D\u064A\u0629 \u0645\u062E\u0637\u0637 \u0644\u0647\u0627\u060C \u0645\u0639 \u062A\u0642\u0644\u064A\u0644 \u0632\u064A\u0627\u0631\u0627\u062A \u0627\u0644\u0645\u0633\u062A\u0634\u0641\u0649 \u0648\u062A\u062D\u0633\u064A\u0646 \u0627\u0644\u062A\u0639\u0627\u0641\u064A."
                  },
                  {
                    "alias": "points",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0645\u0633\u0627\u0631\u0627\u062A \u0639\u0644\u0627\u062C\u064A\u0629 \u0648\u0627\u0636\u062D\u0629\n\u0639\u064A\u0627\u062F\u0627\u062A \u062A\u0642\u062F\u0651\u0645 \u0627\u0644\u062E\u062F\u0645\u0629 \u0641\u064A \u0632\u064A\u0627\u0631\u0629 \u0648\u0627\u062D\u062F\u0629\n\u0625\u0642\u0627\u0645\u0629 \u0623\u0642\u0635\u0631 \u0648\u062A\u0639\u0627\u0641\u064D \u0623\u0641\u0636\u0644"
                  },
                  {
                    "alias": "link",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "\u0627\u062D\u062C\u0632 \u0645\u0648\u0639\u062F\u064B\u0627",
                        "target": null,
