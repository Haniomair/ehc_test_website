                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Planned Care"
                  },
                  {
                    "alias": "summary",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Fewer hospital visits and shorter stays"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Supports people who need planned surgical interventions, while optimising hospital visits and recovery."
                  },
                  {
                    "alias": "points",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Clear care pathways\nOne-stop clinics\nShorter stays and better recovery"
                  },
                  {
                    "alias": "link",
                    "culture": "en-US",
                    "editorAlias": null,
