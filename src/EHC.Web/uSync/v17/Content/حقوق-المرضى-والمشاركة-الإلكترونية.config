          "alias": "title",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0644\u062F\u064A\u0643 \u0645\u0644\u0627\u062D\u0638\u0629 \u0623\u0648 \u0634\u0643\u0648\u0649\u061F"
