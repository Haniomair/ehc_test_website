@* Accessibility settings (opened from the utility bar). Every option is a class on <html> set by site.js and remembered
   on this device only (theme-init.js re-applies it before paint). Options complement assistive technology; none of them
   rewrites page content. Text size and contrast keep the data-action hooks used before this panel existed. *@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<EHC.Web.Site.SiteData>
@{
    string D(string k) => Umbraco.GetDictionaryValue("EHC.A11y." + k) ?? "";
    const string tile = "a11y-tile";
    var toggles = new (string Key, string Icon, string Label)[]
    {
        ("links", "link", D("Links")),
        ("spacing", "spacing", D("Spacing")),
        ("still", "pause", D("Still")),
        ("cursor", "cursor", D("Cursor")),
        ("guide", "guide", D("Guide")),
    };
}
<div id="a11y" class="panel fixed inset-0 z-[85] hidden" role="dialog" aria-modal="true" aria-labelledby="a11y-title">
    <div class="panel-backdrop absolute inset-0 bg-deep-950/50" data-action="a11y-close"></div>
    <div class="panel-sheet absolute inset-y-0 end-0 flex w-[min(360px,100%)] flex-col bg-white dark:bg-night-900">
        <div class="flex items-center justify-between gap-3 bg-deep-900 px-4 py-3 text-white dark:bg-deep-950">
            <h2 id="a11y-title" class="flex items-center gap-2 text-base font-bold"><svg class="ico !h-5 !w-5" aria-hidden="true"><use href="#i-a11y" /></svg>@D("Title")</h2>
            <button type="button" data-action="a11y-close" class="grid h-10 w-10 place-items-center rounded-full bg-white/10 ring-1 ring-white/20 hover:bg-white/20" aria-label="@D("Close")"><svg class="ico !h-5 !w-5" aria-hidden="true"><use href="#i-x" /></svg></button>
        </div>
        <div class="flex-1 overflow-y-auto overscroll-contain p-4">
            <p class="mb-4 text-[.8rem] leading-relaxed text-slate-600 dark:text-slate-400">@D("Intro")</p>

            <div class="mb-2.5 flex items-center gap-2.5 rounded-xl border border-slate-200 px-3 py-2 dark:border-white/10" role="group" aria-labelledby="a11y-size-label">
                <svg class="ico !h-5 !w-5 text-brand-600 dark:text-brand-300" aria-hidden="true"><use href="#i-type" /></svg>
                <span class="flex-1 text-[.85rem] font-semibold text-deep-900 dark:text-white" id="a11y-size-label">@D("TextSize")</span>
                <button type="button" data-action="font" data-step="-1" class="a11y-step" aria-label="@Umbraco.GetDictionaryValue("EHC.Utility.SmallerText")"><span aria-hidden="true">A−</span></button>
                <span class="w-11 text-center text-[.8rem] font-bold tabular-nums text-deep-900 dark:text-white" data-a11y-size aria-live="polite">100%</span>
                <button type="button" data-action="font" data-step="1" class="a11y-step" aria-label="@Umbraco.GetDictionaryValue("EHC.Utility.LargerText")"><span aria-hidden="true" class="text-base">A+</span></button>
            </div>

            <div class="grid grid-cols-2 gap-2.5">
                <button type="button" data-action="contrast" aria-pressed="false" class="@tile"><svg class="ico" aria-hidden="true"><use href="#i-contrast" /></svg><span>@Umbraco.GetDictionaryValue("EHC.Utility.HighContrast")</span></button>
                <button type="button" data-action="dark" aria-pressed="false" class="@tile"><svg class="ico" aria-hidden="true"><use href="#i-moon" /></svg><span>@D("Dark")</span></button>
                @foreach (var t in toggles)
                {
                    <button type="button" data-a11y="@t.Key" aria-pressed="false" class="@tile"><svg class="ico" aria-hidden="true"><use href="#i-@t.Icon" /></svg><span>@t.Label</span></button>
                }
            </div>

            <button type="button" data-action="a11y-reset" class="btn btn-ghost btn-sm mt-4 w-full"><svg class="ico !h-[18px] !w-[18px]" aria-hidden="true"><use href="#i-reset" /></svg><span>@D("Reset")</span></button>
            <p class="mt-4 flex gap-2 text-[.72rem] leading-relaxed text-slate-500 dark:text-slate-400"><svg class="ico mt-0.5 !h-4 !w-4" aria-hidden="true"><use href="#i-shield" /></svg><span>@D("Note")</span></p>
        </div>
    </div>
</div>
