  "contentData": [
    {
      "contentTypeKey": "7f2469b8-9405-4339-9fd8-0de2eeb7a5aa",
      "key": "99ad3292-8edc-4924-ae35-8451751550de",
      "values": [
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0627\u0644\u0627\u0631\u062A\u0642\u0627\u0621 \u0628\u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0645\u0646 \u062E\u0644\u0627\u0644 *\u0627\u0644\u0628\u062D\u062B \u0627\u0644\u0639\u0644\u0645\u064A*"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Advancing healthcare through *research*"
        },
        {
          "alias": "body",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003E\u0641\u064A \u062A\u062C\u0645\u0639 \u0627\u0644\u0634\u0631\u0642\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u060C \u0644\u0627 \u0646\u0631\u0649 \u0627\u0644\u0628\u062D\u062B \u0645\u062C\u0631\u062F \u0639\u0645\u0644\u064A\u0629 \u0639\u0644\u0645\u064A\u0629\u060C \u0628\u0644 \u0642\u0648\u0629 \u062F\u0627\u0641\u0639\u0629 \u0644\u0644\u062A\u063A\u064A\u064A\u0631 \u0648\u0627\u0644\u0627\u0628\u062A\u0643\u0627\u0631. \u0646\u0639\u0631\u0636 \u0644\u0643\u0645 \u0623\u0647\u0645 \u0627\u0644\u0645\u0634\u0627\u0631\u064A\u0639 \u0648\u0627\u0644\u062F\u0631\u0627\u0633\u0627\u062A \u0627\u0644\u062A\u064A \u062A\u0639\u0643\u0633 \u0634\u063A\u0641\u0646\u0627 \u0628\u0627\u0644\u062A\u0645\u064A\u0632\u060C \u0648\u0627\u0644\u062A\u0632\u0627\u0645\u0646\u0627 \u0628\u0631\u0639\u0627\u064A\u0629 \u0635\u062D\u064A\u0629 \u0642\u0627\u0626\u0645\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u062F\u0644\u0629\u060C \u0648\u0645\u0633\u062A\u0646\u062F\u0629 \u0639\u0644\u0649 \u0627\u0644\u0645\u0639\u0631\u0641\u0629.\u003C/p\u003E\u003Cp\u003E\u0627\u0633\u062A\u0643\u0634\u0641 \u0645\u0639\u0646\u0627 \u0645\u062C\u0645\u0648\u0639\u0629 \u0645\u062E\u062A\u0627\u0631\u0629 \u0645\u0646 \u0627\u0644\u0623\u0628\u062D\u0627\u062B \u0627\u0644\u0645\u0646\u0634\u0648\u0631\u0629\u060C \u0645\u062F\u0639\u0648\u0645\u0629 \u0628\u0645\u0644\u062E\u0635\u0627\u062A \u0645\u0648\u062C\u0632\u0629\u060C \u062A\u0641\u062A\u062D \u0644\u0643 \u0623\u0628\u0648\u0627\u0628 \u0627\u0644\u0645\u0639\u0631\u0641\u0629\u060C \u0648\u062A\u0644\u0647\u0645\u0643 \u0644\u062A\u0643\u0648\u0646 \u062C\u0632\u0621\u064B\u0627 \u0645\u0646 \u0645\u0633\u062A\u0642\u0628\u0644 \u0623\u0643\u062B\u0631 \u0635\u062D\u0629.\u003C/p\u003E"
          }
        },
        {
          "alias": "body",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EAt Eastern Health Cluster, we view research as the engine of progress and excellence in healthcare. This page highlights key scientific contributions that reflect our commitment to evidence-based innovation.\u003C/p\u003E\u003Cp\u003EExplore a curated selection of published studies, each with a brief summary. Through this platform, we aim to empower talent, share knowledge, and drive impactful research partnerships locally and globally.\u003C/p\u003E"
          }
        }
      ]
    },
    {
