      "values": [
        {
          "alias": "eyebrow",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0627\u0644\u0628\u0627\u062D\u062B\u0648\u0646"
        },
        {
          "alias": "eyebrow",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Researchers"
        },
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0643\u0646 \u0634\u0631\u064A\u0643\u0627\u064B \u0641\u064A *\u0635\u0646\u0627\u0639\u0629 \u0627\u0644\u062A\u063A\u064A\u064A\u0631*"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Be a partner in *change*"
        },
        {
          "alias": "body",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003E\u0641\u064A \u062A\u062C\u0645\u0639 \u0627\u0644\u0634\u0631\u0642\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u060C \u0646\u0624\u0645\u0646 \u0623\u0646 \u0627\u0644\u0628\u062D\u062B \u0644\u064A\u0633 \u0645\u062C\u0631\u062F \u0623\u062F\u0627\u0629 \u0628\u0644 \u0647\u0648 \u0631\u0643\u064A\u0632\u0629 \u0644\u0644\u062A\u062D\u0648\u0644. \u0646\u0648\u0641\u0651\u0631 \u0628\u064A\u0626\u0629 \u0645\u062D\u0641\u0651\u0632\u0629 \u0644\u0644\u0643\u0641\u0627\u0621\u0627\u062A \u0627\u0644\u0635\u062D\u064A\u0629 \u0644\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0641\u064A \u0623\u0628\u062D\u0627\u062B \u062A\u064F\u0633\u0647\u0645 \u0641\u064A \u062A\u062D\u0633\u064A\u0646 \u062C\u0648\u062F\u0629 \u0627\u0644\u062D\u064A\u0627\u0629\u060C \u0648\u062A\u064F\u0639\u0632\u0632 \u0645\u0646 \u0641\u0627\u0639\u0644\u064A\u0629 \u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0635\u062D\u064A.\u003C/p\u003E\u003Cp\u003E\u0646\u062D\u0646 \u0646\u062D\u0648\u0644 \u0627\u0644\u062A\u062D\u062F\u064A\u0627\u062A \u0625\u0644\u0649 \u0641\u0631\u0635 \u0648\u0646\u062F\u0645\u062C \u0627\u0644\u0627\u0628\u062A\u0643\u0627\u0631 \u0641\u064A \u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062A \u0627\u0644\u0633\u0631\u064A\u0631\u064A\u0629 \u0648\u062A\u0635\u0645\u064A\u0645 \u0627\u0644\u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u0645\u0633\u062A\u0642\u0628\u0644\u064A\u0629.\u003C/p\u003E"
          }
        },
        {
          "alias": "body",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe provide an environment that inspires healthcare professionals to engage in impactful research that transforms lives.\u003C/p\u003E\u003Cp\u003EWe transform challenges into opportunities and embed innovation into clinical decisions and future system design.\u003C/p\u003E"
          }
        }
      ]
    },
