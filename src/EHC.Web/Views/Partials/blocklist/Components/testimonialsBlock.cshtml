@* Testimonials: patient / visitor feedback as a carousel (scroll-snap rail with previous/next — components/rail.js)
   or a grid. Optional star rating (1–5), portrait, name and role. Only publish real feedback with consent. *@
@using EHC.Web.Blocks
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var c = Model.Content;
    var items = c.Value<BlockListModel>("items")?.Select(i => i.Content).Where(i => !string.IsNullOrWhiteSpace(i.Value<string>("quote"))).ToList() ?? [];
    if (items.Count == 0) { return; }
    var carousel = c.Value<string>("layout") != "grid";
    var id = "tm-" + Model.ContentKey.ToString("N")[..8];
    var header = new SectionHeader(c.Value<string>("eyebrow"), c.Value<string>("heading"), c.Value<string>("intro"));
    var card = "card";
}
<div class="wrap">
    <div class="rv sec-head-row">
        @await Html.PartialAsync("blocklist/_SectionHeader", header)
        @if (carousel && items.Count > 1)
        {
            <div class="flex gap-2">
                <button type="button" class="grid h-12 w-12 place-items-center rounded-full border border-slate-200 hover:bg-soft dark:border-white/10 dark:hover:bg-white/5" data-rail-prev="@id" aria-controls="@id" aria-label="@Umbraco.GetDictionaryValue("EHC.Common.Previous")"><svg class="ico flip rotate-180" aria-hidden="true"><use href="#i-arrow" /></svg></button>
                <button type="button" class="grid h-12 w-12 place-items-center rounded-full border border-slate-200 hover:bg-soft dark:border-white/10 dark:hover:bg-white/5" data-rail-next="@id" aria-controls="@id" aria-label="@Umbraco.GetDictionaryValue("EHC.Common.Next")"><svg class="ico flip" aria-hidden="true"><use href="#i-arrow" /></svg></button>
            </div>
        }
    </div>
    <ul id="@id" class="@(carousel ? "rail -mx-2 flex snap-x snap-mandatory gap-5 overflow-x-auto [scrollbar-width:none] scroll-smooth px-2 pb-4 [&>li]:w-[min(88%,420px)] [&>li]:shrink-0 [&>li]:snap-start" : "grid gap-5 md:grid-cols-2 lg:grid-cols-3")" @(carousel ? "tabindex=0" : "") aria-label="@(carousel ? Text.Plain(c.Value<string>("heading")) : null)">
        @foreach (var it in items)
        {
            var rating = Math.Clamp(it.Value<int>("rating"), 0, 5);
            var photo = it.Value<MediaWithCrops>("image");
            var name = it.Value<string>("personName");
            <li class="rv">
                <figure class="flex h-full flex-col gap-5 rounded-[22px] p-7 @card">
                    @if (rating > 0)
                    {
                        <div class="flex gap-0.5 text-amber-500" role="img" aria-label="@string.Format(Umbraco.GetDictionaryValue("EHC.Testimonials.Rating") ?? "{0}/5", rating)">
                            @for (var s = 1; s <= 5; s++) { <svg class="h-4 w-4 fill-current @(s <= rating ? "" : "opacity-25")" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" /></svg> }
                        </div>
                    }
                    <blockquote class="flex-1 text-[1.05rem] leading-relaxed text-slate-700 dark:text-slate-300">@(it.Value<string>("quote"))</blockquote>
                    @if (!string.IsNullOrWhiteSpace(name))
                    {
                        <figcaption class="flex items-center gap-3 border-t pt-4 border-slate-100 dark:border-white/10">
                            @if (photo is not null)
                            {
                                <img src="@photo.GetCropUrl(96, 96, furtherOptions: "format=webp&quality=80")" alt="" class="h-12 w-12 rounded-full object-cover" loading="lazy">
                            }
                            else
                            {
                                <span class="grid h-12 w-12 place-items-center rounded-full font-bold bg-brand-50 text-brand-700 dark:bg-brand-500/15 dark:text-brand-300" aria-hidden="true">@name.Trim()[0]</span>
                            }
                            <span><b class="block">@name</b>@if (!string.IsNullOrWhiteSpace(it.Value<string>("role"))) {<span class="text-sm text-slate-600 dark:text-slate-400">@(it.Value<string>("role"))</span>}</span>
                        </figcaption>
                    }
                </figure>
            </li>
        }
    </ul>
    @if (carousel && items.Count > 1) { <div class="mt-6 flex justify-center gap-3.5" data-rail-dots="@id" data-label="@Umbraco.GetDictionaryValue("EHC.Common.PageOf")" hidden></div> }
</div>
@if (carousel && items.Count > 1) { <script src="~/assets/js/components/rail.js" asp-append-version="true" defer></script> }
