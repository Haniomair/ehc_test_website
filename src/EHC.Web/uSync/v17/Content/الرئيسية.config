                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0633\u062A\u0634\u0627\u0631\u0629 \u0639\u0646 \u0628\u064F\u0639\u062F"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u064A\u0645\u0643\u0646 \u0644\u0637\u0628\u064A\u0628 \u0645\u0633\u0627\u0639\u062F\u062A\u0643 \u062F\u0648\u0646 \u0632\u064A\u0627\u0631\u0629: \u0627\u0633\u062A\u0634\u0627\u0631\u0629 \u0639\u0628\u0631 \u062A\u0637\u0628\u064A\u0642 \u0635\u062D\u062A\u064A \u0623\u0648 \u0627\u062A\u0635\u0644 \u0639\u0644\u0649 937."
