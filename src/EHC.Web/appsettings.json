{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "fb4cdfb7-9113-44b4-bf90-cef53d3cfcf1"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      }
    }
  },
  "uSync": {
    "Settings": {
      "ExportOnSave": "All",
      "ImportAtStartup": "None",
      "ImportOnFirstBoot": true
    }
  },
  "Ehc": {
    "Customizer": {
      "Enabled": false
    },
    "Assistant": {
      "Demo": false
    },
    "ErWait": {
      "UseDemoData": false
    },
    "Embed": {
      "FrappeHosts": []
    },
    "Feedback": {
      "RetentionMonths": 12
    }
  }
}
