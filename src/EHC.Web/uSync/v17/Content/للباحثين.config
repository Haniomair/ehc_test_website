                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Implementation"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0628\u0639\u062F \u0627\u0639\u062A\u0645\u0627\u062F\u0647\u0627\u060C \u062A\u062D\u0635\u0644 \u0639\u0644\u0649 \u0627\u0644\u062F\u0639\u0645 \u0627\u0644\u0643\u0627\u0645\u0644 \u0644\u062A\u0646\u0641\u064A\u0630 \u062F\u0631\u0627\u0633\u062A\u0643 \u0648\u0641\u0642 \u0623\u0639\u0644\u0649 \u0627\u0644\u0645\u0639\u0627\u064A\u064A\u0631."
