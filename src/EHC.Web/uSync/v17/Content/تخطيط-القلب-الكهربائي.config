    <risks>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u0644\u0627 \u062A\u0648\u062C\u062F \u0645\u062E\u0627\u0637\u0631\u060C \u0648\u0642\u062F \u062A\u0633\u0628\u0628 \u0627\u0644\u0644\u0635\u0642\u0627\u062A \u062A\u0647\u064A\u062C\u064B\u0627 \u0628\u0633\u064A\u0637\u064B\u0627 \u0641\u064A \u0627\u0644\u062C\u0644\u062F.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EThere are no risks. The sticky pads may slightly irritate the skin.\u003C/p\u003E"
}]]></Value>
    </risks>
    <sources>
