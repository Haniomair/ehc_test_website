@* Right panel item "ER wait times": up to three emergency departments, filled by components/er-wait.js from
   /api/er-wait (matched by facility.erFeedId). No feed → the "coming soon" note and no numbers (never fake numbers). *@
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var c = Model.Content;
    var facilities = c.Value<IEnumerable<IPublishedContent>>("facilities")?.Where(f => f.Value<bool>("hasEmergency")).Take(3).ToList() ?? [];
    if (facilities.Count == 0) { return; }
    string D(string k) => Umbraco.GetDictionaryValue("EHC.Er." + k) ?? "";
    var labels = System.Text.Json.JsonSerializer.Serialize(new { quiet = D("Quiet"), moderate = D("Moderate"), busy = D("Busy") });
    var heading = c.Value<string>("heading");
    var link = c.Value<Link>("link");
}
<div class="rounded-[28px] border border-white/20 bg-white/10 p-5 text-white shadow-[0_30px_80px_rgba(0,0,0,.25)] backdrop-blur-xl" data-er data-api="/api/er-wait" data-labels="@labels">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <b class="text-lg leading-tight">@(string.IsNullOrWhiteSpace(heading) ? D("Eyebrow") : heading)</b>
        <p class="hidden items-center gap-2 text-xs text-white/85" data-er-status>
            <span class="relative flex h-2 w-2" aria-hidden="true"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span></span>
            <span>@D("Live")</span><b class="hidden rounded-full bg-accent-400/25 px-2 text-white" data-er-illustrative>@D("Illustrative")</b>
        </p>
    </div>
    <p class="mb-3 text-sm text-white/80" data-er-soon>@D("ComingSoon")</p>
    <ul class="grid gap-2">
        @foreach (var f in facilities)
        {
            <li>
                <a href="@f.Url()" class="block rounded-2xl bg-white p-3 text-deep-950 transition hover:shadow-soft dark:bg-night-900 dark:text-white" data-er-feed="@(f.Value<string>("erFeedId"))">
                    <span class="flex items-center justify-between gap-3">
                        <span class="min-w-0"><b class="block truncate text-sm">@f.Name</b>@if (!string.IsNullOrWhiteSpace(f.Value<string>("city"))) {<span class="text-xs text-slate-500 dark:text-slate-400">@(f.Value<string>("city"))</span>}</span>
                        <span class="flex shrink-0 items-center gap-2">
                            <span class="hidden whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-bold" data-er-badge></span>
                            <span class="hidden items-baseline gap-1" data-er-value><b class="text-2xl font-extrabold leading-none" data-er-min></b><span class="text-xs text-slate-500 dark:text-slate-400">@D("Minutes")</span></span>
                        </span>
                    </span>
                    <span class="mt-2 hidden h-1.5 overflow-hidden rounded-full bg-slate-100 dark:bg-white/10" data-er-track aria-hidden="true"><i class="block h-full w-0 rounded-full" data-er-bar></i></span>
                </a>
            </li>
        }
    </ul>
    @if (link is not null) { <a href="@link.Url" target="@link.Target" class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-white underline-offset-4 hover:underline">@link.Name<svg class="ico flip !h-4 !w-4" aria-hidden="true"><use href="#i-arrow" /></svg></a> }
</div>
<script src="~/assets/js/components/er-wait.js" asp-append-version="true" defer></script>
