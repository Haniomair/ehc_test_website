  "contentData": [
    {
      "contentTypeKey": "7f2469b8-9405-4339-9fd8-0de2eeb7a5aa",
      "key": "7ea4e0ea-3527-4754-b740-1a053b371b20",
      "values": [
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0631\u0639\u0627\u064A\u062A\u0643\u0645 \u062A\u0628\u062F\u0623 \u0628\u0641\u0647\u0645 *\u0627\u062D\u062A\u064A\u0627\u062C\u0627\u062A\u0643\u0645*"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Your care begins with understanding *your needs*"
        },
        {
          "alias": "body",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003E\u0646\u0642\u062F\u0645 \u062E\u062F\u0645\u0627\u062A \u0635\u062D\u064A\u0629 \u0645\u0635\u0645\u0645\u0629 \u0644\u0643\u0644 \u0645\u0633\u062A\u0641\u064A\u062F\u060C \u062A\u062C\u0645\u0639 \u0628\u064A\u0646 \u0627\u0644\u062E\u0628\u0631\u0629 \u0627\u0644\u0637\u0628\u064A\u0629 \u0648\u0627\u0644\u0627\u0647\u062A\u0645\u0627\u0645 \u0627\u0644\u0634\u062E\u0635\u064A\u060C \u0644\u0636\u0645\u0627\u0646 \u062A\u062C\u0631\u0628\u0629 \u0639\u0644\u0627\u062C\u064A\u0629 \u0628\u0645\u0639\u0627\u064A\u064A\u0631 \u0639\u0627\u0644\u0645\u064A\u0629.\u003C/p\u003E\u003Cp\u003E\u0646\u062D\u0631\u0635 \u0639\u0644\u0649 \u0623\u0646 \u062A\u0628\u062F\u0623 \u062A\u062C\u0631\u0628\u062A\u0643\u0645 \u0645\u0639\u0646\u0627 \u0628\u0643\u0644 \u0631\u0627\u062D\u0629 \u0648\u0627\u0637\u0645\u0626\u0646\u0627\u0646. \u0648\u0645\u0646 \u062E\u0644\u0627\u0644 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062D\u0629\u060C \u0633\u062A\u062C\u062F\u0648\u0646 \u062C\u0645\u064A\u0639 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062A \u0627\u0644\u062A\u064A \u062A\u062D\u062A\u0627\u062C\u0648\u0646\u0647\u0627 \u0644\u0644\u062A\u062E\u0637\u064A\u0637 \u0644\u0632\u064A\u0627\u0631\u062A\u0643\u0645\u060C \u0648\u0627\u0644\u062A\u0639\u0631\u0641 \u0639\u0644\u0649 \u0627\u0644\u062E\u062F\u0645\u0627\u062A \u0648\u0627\u0644\u0645\u0631\u0627\u0641\u0642 \u0648\u0627\u0644\u0625\u0631\u0634\u0627\u062F\u0627\u062A \u0627\u0644\u062A\u064A \u062A\u0636\u0645\u0646 \u0644\u0643\u0645 \u062A\u062C\u0631\u0628\u0629 \u0633\u0644\u0633\u0629 \u0648\u0645\u0631\u064A\u062D\u0629 \u0645\u0646\u0630 \u0644\u062D\u0638\u0629 \u0648\u0635\u0648\u0644\u0643\u0645 \u0648\u062D\u062A\u0649 \u0627\u0646\u062A\u0647\u0627\u0621 \u0631\u062D\u0644\u062A\u0643\u0645 \u0627\u0644\u0639\u0644\u0627\u062C\u064A\u0629.\u003C/p\u003E"
          }
        },
        {
          "alias": "body",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe provide personalized healthcare services tailored to every patient, combining medical expertise with compassionate, individualized care to deliver an exceptional treatment experience that meets the highest international standards.\u003C/p\u003E\u003Cp\u003EYour comfort and peace of mind are our priority. This page provides everything you need to plan your visit, explore our services and facilities, and access helpful information designed to ensure a smooth, comfortable, and seamless experience from the moment you arrive until the completion of your care journey.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "77ab862d-8db0-4d2e-8230-6260fa0dcf52",
