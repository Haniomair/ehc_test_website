@* Columns layout: two or three columns, each holding its own sections (text, image, video, FAQ, table, callout,
   checklist, quote, downloads, embed, health tool…). Proportions, vertical alignment and card style are dropdowns.
   Columns stack on small screens (optionally the last column first). The nested sections render with their usual
   views; ehc.css (.cols-cell) removes their page container so they fit the column. *@
@using EHC.Web.Blocks
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@inject System.Text.Encodings.Web.HtmlEncoder Encoder
@{
    var c = Model.Content;
    var layout = c.Value<string>("layout") ?? "1-1";
    var count = layout == "1-1-1" ? 3 : 2;
    // render every column first: a column whose sections are all empty still keeps its place, all empty = no section
    var cells = new List<string>();
    for (var i = 1; i <= count; i++)
    {
        var html = new System.Text.StringBuilder();
        foreach (var item in c.Value<BlockListModel>("column" + i) ?? Enumerable.Empty<BlockListItem>())
        {
            if (item?.Content is null) { continue; }
            var inner = await Html.PartialAsync("blocklist/Components/" + item.Content.ContentType.Alias, item);
            using var writer = new System.IO.StringWriter();
            inner.WriteTo(writer, Encoder);
            var part = writer.ToString();
            if (!string.IsNullOrWhiteSpace(part)) { html.Append("<div data-block=\"").Append(Encoder.Encode(item.Content.ContentType.Alias)).Append("\">").Append(part).Append("</div>"); }
        }
        cells.Add(html.ToString());
    }
    if (cells.All(string.IsNullOrWhiteSpace)) { return; }
    var grid = layout switch
    {
        "2-1" => "lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]",
        "1-2" => "lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]",
        "1-1-1" => "md:grid-cols-2 lg:grid-cols-3",
        _ => "md:grid-cols-2",
    };
    var stackAt = layout is "2-1" or "1-2" ? "max-lg:order-first" : "max-md:order-first";
    var center = c.Value<string>("verticalAlign") == "center";
    var cards = c.Value<string>("columnStyle") == "cards";
    var reverse = c.Value<bool>("reverseOnMobile");
    var header = new SectionHeader(c.Value<string>("eyebrow"), c.Value<string>("heading"), c.Value<string>("intro"));
}
<div class="wrap">
    @if (!string.IsNullOrWhiteSpace(header.Eyebrow) || !string.IsNullOrWhiteSpace(header.Heading) || !string.IsNullOrWhiteSpace(header.Intro))
    {
        <div class="rv sec-head">@await Html.PartialAsync("blocklist/_SectionHeader", header)</div>
    }
    <div class="grid gap-8 lg:gap-12 @grid @(center ? "items-center" : "items-start") @(cards ? "cols-card" : "")">
        @for (var i = 0; i < cells.Count; i++)
        {
            <div class="cols-cell grid content-start gap-8 @(reverse && i == cells.Count - 1 ? stackAt : "") @(string.IsNullOrWhiteSpace(cells[i]) && cards ? "!border-0 !bg-transparent !p-0" : "")">@Html.Raw(cells[i])</div>
        }
    </div>
</div>
