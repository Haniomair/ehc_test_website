@* Clinical review panel of a library page: last and next review dates (Hijri and Gregorian) and the reviewer, or a
   clear "Awaiting clinical review" note while no review date is set; then the sources and the general disclaimer. *@
@using EHC.Web.Site
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPublishedContent>
@{
    var reviewed = Model.Value<DateOnly?>("reviewedDate");
    var next = Model.Value<DateOnly?>("nextReview");
    var by = Model.Value<string>("reviewedBy");
    var sources = Model.Value<IEnumerable<Link>>("sources")?.ToList() ?? [];
    string L(string k) => Umbraco.GetDictionaryValue("EHC.Library." + k) ?? k;
}
<section aria-labelledby="h-review" class="hl-sec">
    <h2 id="h-review" class="hl-h2">@L("Review.Title")</h2>
    <div class="rounded-[22px] border border-slate-200 p-6 dark:border-white/10">
        @if (reviewed is null)
        {
            <p class="inline-flex items-center gap-2 rounded-full bg-accent-400/15 px-3 py-1 text-xs font-bold text-deep-900 ring-1 ring-accent-400/40 dark:text-accent-400"><svg class="ico !h-4 !w-4" aria-hidden="true"><use href="#i-clock" /></svg>@L("Review.Awaiting")</p>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">@L("Review.AwaitingText")</p>
        }
        else
        {
            <dl class="grid gap-3 text-sm sm:grid-cols-2">
                <div><dt class="text-slate-500 dark:text-slate-400">@L("Review.Last")</dt><dd class="font-semibold text-deep-900 dark:text-white">@Dates.Html(reviewed.Value)</dd></div>
                @if (next is not null) { <div><dt class="text-slate-500 dark:text-slate-400">@L("Review.Next")</dt><dd class="font-semibold text-deep-900 dark:text-white">@Dates.Html(next.Value)</dd></div> }
            </dl>
        }
        @if (!string.IsNullOrWhiteSpace(by))
        {
            <p class="mt-4 flex items-center gap-2 text-sm"><svg class="ico !h-4 !w-4 text-brand-600 dark:text-brand-300" aria-hidden="true"><use href="#i-shield" /></svg><span class="text-slate-500 dark:text-slate-400">@L("Review.By")</span> <b class="text-deep-900 dark:text-white">@by</b></p>
        }
        @if (sources.Count > 0)
        {
            <h3 class="mt-6 border-t border-slate-200 pt-5 text-sm font-bold text-deep-900 dark:border-white/10 dark:text-white">@(Umbraco.GetDictionaryValue("EHC.Health.Sources"))</h3>
            <ol class="mt-2 grid list-decimal gap-1.5 ps-5 text-sm">
                @foreach (var s in sources) { <li><a href="@s.Url" target="@s.Target" rel="@(s.Type == LinkType.External ? "noopener" : null)" class="link">@s.Name</a></li> }
            </ol>
        }
    </div>
    <p class="mt-4 rounded-2xl bg-soft p-4 text-sm text-slate-600 dark:bg-white/5 dark:text-slate-400">@(Umbraco.GetDictionaryValue("EHC.Health.Disclaimer"))</p>
</section>
