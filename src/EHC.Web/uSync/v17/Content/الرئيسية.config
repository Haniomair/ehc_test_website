                  },
                  {
                    "alias": "imageAlt",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0645\u0631\u0623\u0629 \u062A\u0631\u062A\u062F\u064A \u062D\u062C\u0627\u0628\u064B\u0627 \u0648\u0631\u062F\u064A \u0627\u0644\u0644\u0648\u0646 \u0648\u062A\u0645\u0633\u0643 \u0628\u0634\u0631\u064A\u0637 \u0627\u0644\u062A\u0648\u0639\u064A\u0629 \u0627\u0644\u0648\u0631\u062F\u064A\u060C \u0645\u0639 \u0634\u0639\u0627\u0631 \u062D\u0645\u0644\u0629 \u00AB\u062F\u0631\u0628\u0643 \u0648\u0631\u062F\u064A\u00BB. \u0627\u0644\u0646\u0635: \u0628\u0627\u062F\u0631\u064A \u0628\u0627\u0644\u062A\u0648\u0627\u0635\u0644 \u0645\u0639 \u0637\u0628\u064A\u0628 \u0627\u0644\u0623\u0633\u0631\u0629 \u0648\u0627\u062D\u062C\u0632\u064A \u0645\u0648\u0639\u062F\u0643 \u0639\u0628\u0631 \u062A\u0637\u0628\u064A\u0642 \u0635\u062D\u062A\u064A\u060C \u0623\u0648 \u0639\u0646 \u0637\u0631\u064A\u0642 \u0627\u0644\u0627\u062A\u0635\u0627\u0644 \u0628\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062D\u062F 920022231."
                  },
                  {
                    "alias": "badge",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Pink October"
                  },
                  {
                    "alias": "kicker",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Breast cancer awareness month"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Early detection"
                  },
