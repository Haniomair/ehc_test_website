@* Hero 5 "Image": big statement over a full-bleed photo (mediaComposition + heroTextComposition).
   align = start | center. Give the block spacing "none". Without a photo it falls back to the brand gradient. *@
@using EHC.Web.Blocks
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@inject System.Text.Encodings.Web.HtmlEncoder Encoder
@{
    var c = Model.Content;
    var title = c.Value<string>("title");
    if (string.IsNullOrWhiteSpace(title)) { return; }
    var bg = MediaBackground.From(c);
    var center = (EHC.Web.Site.Customizer.Current(Context)?.HeroAlign ?? c.Value<string>("align")) == "center";   // look customizer may override
    var highlight = c.Value<string>("titleHighlight");
    var primary = c.Value<Link>("primaryCta");
    var secondary = c.Value<Link>("secondaryCta");
    var kicker = c.Value<string>("kicker");
}
<div class="@(bg.HasMedia ? "media-hero" : "hero-bg-0 relative overflow-hidden") text-white" style="@(bg.HasMedia ? bg.FocalStyle : null)"@HtmlAttributes.Data("overlay", bg.HasMedia ? bg.Overlay : null)@HtmlAttributes.Data("strength", bg.HasMedia ? bg.Strength : null)>
    @await Html.PartialAsync("site/_MediaBackground", bg)
    <div class="wrap relative flex min-h-[520px] flex-col justify-center py-20 @(center ? "items-center text-center" : "")">
        @if (!string.IsNullOrWhiteSpace(kicker)) { <span class="mb-5 text-sm font-bold uppercase tracking-[.2em] text-brand-100 rtl:tracking-normal">@kicker</span> }
        @Heading.Hero(Heading.IsFirstBlock(Umbraco.AssignedContentItem, Model.ContentKey), "max-w-4xl text-[clamp(2.4rem,5.8vw,4.8rem)] font-bold leading-[1.08] rtl:leading-[1.3]", title, highlight, "not-italic text-brand-300", Encoder)
        @if (!string.IsNullOrWhiteSpace(c.Value<string>("lead"))) { <p class="mt-5 max-w-2xl text-lg text-white/85">@(c.Value<string>("lead"))</p> }
        @if (primary is not null || secondary is not null)
        {
            <div class="mt-8 flex flex-wrap gap-3 @(center ? "justify-center" : "")">
                @if (primary is not null) { <a class="btn btn-sand btn-lg" href="@primary.Url" target="@primary.Target">@primary.Name</a> }
                @if (secondary is not null) { <a class="btn btn-outline btn-lg" href="@secondary.Url" target="@secondary.Target">@secondary.Name</a> }
            </div>
        }
        @if (c.Value<bool>("showScrollCue"))
        {
            <a href="#after-@Model.ContentKey.ToString("N")[..8]" class="mt-12 grid h-11 w-11 place-items-center rounded-full border border-white/40 hover:bg-white/10 @(center ? "" : "self-start")" aria-label="@Umbraco.GetDictionaryValue("EHC.Hero.ScrollCue")"><svg class="ico anim-bob" aria-hidden="true"><use href="#i-chev" /></svg></a>
        }
    </div>
</div>
@if (c.Value<bool>("showScrollCue")) { <span id="after-@Model.ContentKey.ToString("N")[..8]"></span> }
