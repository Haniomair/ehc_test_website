<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="f8dc8b7a-9545-4d58-b0db-904c56b391cd" Alias="theme" Level="2">
  <Info>
    <Name>Theme</Name>
    <Icon>icon-palette</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>An occasion look (National Day, Ramadan, campaigns…). Pick a few colours; the site builds the rest and keeps text readable. Schedule it in Site settings, or use it on one section. "Save and preview" shows the homepage in this theme.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Culture</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays></KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays></KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>EHC+-+Settings</Folder>
    <Compositions />
    <DefaultTemplate>themePreview</DefaultTemplate>
    <AllowedTemplates>
      <Template Key="c7a3e915-2d4b-4a86-b1f0-9e5d3c8a7b24">themePreview</Template>
    </AllowedTemplates>
  </Info>
