        {
          "alias": "intro",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0646\u0645\u0648\u0630\u062C \u0631\u0639\u0627\u064A\u0629 \u064A\u0631\u0643\u0651\u0632 \u0639\u0644\u0649 \u0627\u0644\u0641\u0631\u062F: \u0633\u062A\u0629 \u0623\u0646\u0638\u0645\u0629 \u0631\u0639\u0627\u064A\u0629 \u062A\u0644\u0628\u064A \u0627\u062D\u062A\u064A\u0627\u062C\u0627\u062A\u0643 \u0627\u0644\u062C\u0633\u062F\u064A\u0629 \u0648\u0627\u0644\u0646\u0641\u0633\u064A\u0629 \u0648\u0627\u0644\u0627\u062C\u062A\u0645\u0627\u0639\u064A\u0629\u060C \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u062D\u0645\u0644 \u062D\u062A\u0649 \u0627\u0644\u0645\u0631\u0627\u062D\u0644 \u0627\u0644\u0623\u062E\u064A\u0631\u0629 \u0645\u0646 \u0627\u0644\u062D\u064A\u0627\u0629."
