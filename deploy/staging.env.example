# Copy to deploy/staging.env (not committed) and fill in from the host's Web Deploy publishing settings
# (Plesk: Websites & Domains > the domain > Web Deploy Publishing Settings; the .publishsettings file holds the same
# values as publishUrl, msdeploySite and userName).
EHC_DEPLOY_SERVER=server.example.com
EHC_DEPLOY_SITE=test.example.com
EHC_DEPLOY_USER=deploy-user
# EHC_DEPLOY_ALLOW_UNTRUSTED=true  (when the Web Deploy port has a self-signed certificate)
# EHC_DEPLOY_SELF_CONTAINED=true   (when the server has no .NET 10 runtime: HTTP 500.31)
# Leave the password out to be asked for it on each deploy.
# EHC_DEPLOY_PASSWORD=
