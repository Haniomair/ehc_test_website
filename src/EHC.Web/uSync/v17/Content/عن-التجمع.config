        {
          "alias": "items",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "718975d1-06da-4097-9b49-b7663f981845",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "users"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "*\u0625\u062F\u0627\u0631\u0629* \u0635\u062D\u0629 \u0627\u0644\u0633\u0643\u0627\u0646 \u0628\u0634\u0643\u0644 \u0627\u0633\u062A\u0628\u0627\u0642\u064A \u0645\u0646 \u062E\u0644\u0627\u0644 \u0627\u0644\u062A\u0641\u0627\u0639\u0644 \u0648\u0627\u0644\u0627\u0644\u062A\u0632\u0627\u0645 \u0648\u0627\u0644\u062A\u0639\u0627\u0648\u0646 \u0627\u0644\u0645\u0643\u062B\u0641 \u0645\u0639 \u0627\u0644\u062C\u0647\u0627\u062A \u0627\u0644\u0645\u0639\u0646\u064A\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "*Proactively* manage the population\u0027s health through engagement \u0026 stakeholder collaboration."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "bf4742b3-7c3c-49a9-9a20-8383c09d40f4",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "brief"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "*\u0627\u0644\u0627\u0633\u062A\u062B\u0645\u0627\u0631* \u0641\u064A \u0628\u0646\u0627\u0621 \u0642\u0648\u0649 \u0639\u0627\u0645\u0644\u0629 \u0630\u0627\u062A \u0645\u0647\u0627\u0631\u0629 \u0639\u0627\u0644\u064A\u0629 \u0648\u0645\u0634\u0627\u0631\u0643\u0629 \u0641\u0639\u0651\u0627\u0644\u0629 \u0641\u064A \u0628\u064A\u0626\u0629 \u0639\u0645\u0644 \u0645\u062D\u0641\u0651\u0632\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "*Invest* in developing a skilled \u0026 engaged workforce in an attractive working environment."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "155b7d12-5f33-4cd5-a5a0-b76da85e921d",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "hosp"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "*\u0628\u0646\u0627\u0621* \u0647\u064A\u0627\u0643\u0644 \u062A\u0634\u063A\u064A\u0644\u064A\u0629 \u0648\u0631\u0623\u0633\u0645\u0627\u0644\u064A\u0629 \u0645\u0633\u062A\u062F\u0627\u0645\u0629."
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "*Build* sustainable operational and capital structures."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "883fc5a5-e5c5-4095-9693-2badb74bb1d4",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "heart"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "*\u062A\u0637\u0628\u064A\u0642* \u0646\u0645\u0648\u0630\u062C \u0631\u0639\u0627\u064A\u0629 \u0635\u062D\u064A\u0629 \u0645\u0628\u062A\u0643\u0631 \u064A\u062A\u0645\u062D\u0648\u0631 \u062D\u0648\u0644 \u0627\u0644\u0645\u0631\u064A\u0636 \u0628\u0627\u0644\u062A\u0639\u0627\u0648\u0646 \u0645\u0639 \u0645\u0631\u0627\u0643\u0632 \u0627\u0644\u062A\u0645\u064A\u0632 \u0627\u0644\u0639\u0627\u0644\u0645\u064A\u0629 \u0627\u0644\u0645\u0639\u0631\u0648\u0641\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "*Implement* an innovative, patient-centred model of care in collaboration with renowned global centres of excellence."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "e70ed698-99ad-4c2f-868f-3730d4c4056d",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "app"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "*\u062A\u0637\u0628\u064A\u0642* \u0645\u0646\u0638\u0648\u0645\u0629 \u0639\u0645\u0644 \u0631\u0642\u0645\u064A\u0629 \u0644\u0625\u062F\u0627\u0631\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062A \u0648\u0627\u0644\u062A\u062D\u0644\u064A\u0644\u0627\u062A \u0627\u0644\u0641\u0648\u0631\u064A\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "*Implement* a digital operating model for information management and real-time analytics."
                  }
                ]
              },
              {
                "contentTypeKey": "669181e0-db42-4649-97d5-0ea8384b41cb",
                "key": "b40dc8bd-74d7-4703-85e0-22c41f9015c3",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "shield"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "*\u0625\u0639\u062F\u0627\u062F* \u0645\u0646\u0638\u0648\u0645\u0629 \u0639\u0645\u0644 \u0641\u0639\u0627\u0644\u0629 \u0645\u0646 \u062E\u0644\u0627\u0644 \u062A\u0637\u0628\u064A\u0642 \u062D\u0648\u0643\u0645\u0629 \u0645\u062A\u064A\u0646\u0629 \u0648\u0625\u062F\u0627\u0631\u0629 \u0634\u0627\u0645\u0644\u0629 \u0644\u0644\u0645\u062E\u0627\u0637\u0631"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "*Establish* an effective operating model through robust governance and comprehensive risk management."
                  }
                ]
              }
            ],
