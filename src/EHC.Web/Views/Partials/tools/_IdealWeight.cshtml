@* Ideal body weight (adults): Devine formula (50 kg men / 45.5 kg women + 2.3 kg per inch over 5 feet), plus the
   healthy weight range for the height (BMI 18.5–24.9). Devine is not used below 152 cm. *@
@using EHC.Web.Site
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<HealthTools.Tool>
@{
    string D(string k) => Umbraco.GetDictionaryValue("EHC.Tools." + k) ?? "";
    var id = (string)ViewData["toolId"]!;
}
<form class="tool-grid" novalidate data-calc="idealWeight">
    <div class="grid content-start gap-5">
        <p class="text-sm text-slate-600 dark:text-slate-400">@D("Ibw.Intro")</p>
        @await Html.PartialAsync("tools/_Sex", id)
        @await Html.PartialAsync("tools/_Field", new ToolField(id + "-h", "height", D("Height"), D("Cm"), 120, 230, 0.1, "170"))
        @await Html.PartialAsync("tools/_Actions", D("Calculate"))
    </div>
    <div class="tool-result" data-tool-result aria-live="polite">
        <p data-empty class="text-slate-600 dark:text-slate-400">@D("Empty")</p>
        <div data-out hidden>
            <div data-v="ibwBox">
                <span class="text-sm text-slate-600 dark:text-slate-400">@D("Ibw.Result")</span>
                <b class="tool-value"><span data-v="ibw"></span> <small class="text-lg font-bold">@D("Kg")</small></b>
            </div>
            <p class="hidden text-sm text-slate-700 dark:text-slate-300" data-v="short">@D("Ibw.Short")</p>
            <div class="mt-5 rounded-2xl bg-white p-4 dark:bg-white/5">
                <span class="text-sm text-slate-600 dark:text-slate-400">@D("Ibw.Range")</span>
                <b class="block text-2xl font-extrabold text-deep-900 dark:text-white"><span data-v="range" dir="ltr"></span> @D("Kg")</b>
            </div>
            <p class="mt-4 text-sm text-slate-600 dark:text-slate-400">@D("Ibw.Note")</p>
        </div>
    </div>
</form>
