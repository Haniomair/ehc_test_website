<Dictionary Key="14d62ad2-3676-4b03-bd11-2d105f78ff22" Alias="EHC.Cookies.Text" Level="0">
  <Info />
  <Translations>
    <Translation Language="ar-SA">نستخدم ملفات تعريف الارتباط الضرورية والتخزين على جهازك لتشغيل الموقع وتذكّر إعداداتك، مثل إعدادات العرض وإمكانية الوصول. لا نستخدم الملفات الاختيارية، مثل ملفات التحليلات، إلا بموافقتك.</Translation>
    <Translation Language="en-US">We use essential cookies and storage on your device to run this site and remember your settings, such as display and accessibility. Optional cookies, such as analytics, are only used if you allow them.</Translation>
  </Translations>
</Dictionary>