      <Value Culture="ar-SA"><![CDATA[[
  {
    "name": "\u0645\u064A\u062F\u0644\u0627\u064A\u0646 \u0628\u0644\u0633 (\u0627\u0644\u0645\u0643\u062A\u0628\u0629 \u0627\u0644\u0648\u0637\u0646\u064A\u0629 \u0627\u0644\u0623\u0645\u0631\u064A\u0643\u064A\u0629 \u0644\u0644\u0637\u0628): \u0646\u0642\u0635 \u0625\u0646\u0632\u064A\u0645 G6PD",
