          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "359cf16f-0f01-4bed-9bc0-1111800cb40e",
                "key": "84916945-3cdd-4aab-987f-81bbfde8557a",
                "values": [
                  {
                    "alias": "icon",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "clinic"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0623\u0646 \u062A\u0635\u0628\u062D \u0645\u0631\u064A\u0636\u064B\u0627 \u0645\u0633\u062C\u0644\u0627\u064B"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Becoming a patient"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0644\u0644\u0627\u0633\u062A\u0641\u0627\u062F\u0629 \u0645\u0646 \u0645\u062C\u0645\u0648\u0639\u062A\u0646\u0627 \u0627\u0644\u0634\u0627\u0645\u0644\u0629 \u0645\u0646 \u062E\u062F\u0645\u0627\u062A \u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629\u060C \u0639\u0644\u064A\u0643 \u0623\u0648\u0644\u0627\u064B \u0627\u0644\u062A\u0633\u062C\u064A\u0644 \u0644\u062F\u064A\u0646\u0627\u060C \u0648\u062A\u062D\u062F\u064A\u062F \u0637\u0628\u064A\u0628 \u0631\u0639\u0627\u064A\u0629 \u0623\u0648\u0644\u064A\u0629 \u0644\u0643\u060C \u0648\u062A\u062D\u062F\u064A\u062F \u0645\u0648\u0639\u062F\u0643 \u0627\u0644\u0623\u0648\u0644."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "To benefit from our complete set of healthcare services, you will first need to be registered with us, have a Primary Care physician assigned to you and schedule your first appointment."
                  },
                  {
                    "alias": "link",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "\u0627\u0628\u062D\u062B \u0639\u0646 \u0645\u0631\u0643\u0632\u0643 \u0627\u0644\u0635\u062D\u064A",
                        "target": null,
                        "unique": "6fbbfeac-23b9-4f4a-b4d0-02da4911a504",
                        "type": "document",
                        "udi": "umb://document/6fbbfeac23b94f4ab4d002da4911a504",
                        "url": null,
                        "queryString": null,
                        "culture": null
                      }
                    ]
                  },
                  {
                    "alias": "link",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "Find your health centre",
                        "target": null,
                        "unique": "6fbbfeac-23b9-4f4a-b4d0-02da4911a504",
                        "type": "document",
