@* Intro split: heading + subheading on one side, text and buttons on the other, with an accent bar. Good as the first
   section under an inner page header. *@
@using EHC.Web.Blocks
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Strings
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@inject System.Text.Encodings.Web.HtmlEncoder Encoder
@{
    var c = Model.Content;
    var heading = c.Value<string>("heading");
    var body = c.Value<IHtmlEncodedString>("body")?.ToHtmlString();
    if (string.IsNullOrWhiteSpace(heading) && string.IsNullOrWhiteSpace(body)) { return; }
    var sub = c.Value<string>("subheading");
    var ctas = c.Value<IEnumerable<Link>>("ctas")?.ToList() ?? [];
}
<div class="wrap grid gap-8 lg:grid-cols-[1fr_1.25fr] lg:gap-16">
    <div class="rv">
        @if (!string.IsNullOrWhiteSpace(c.Value<string>("eyebrow"))) { <div class="eyebrow">@(c.Value<string>("eyebrow"))</div> }
        @if (!string.IsNullOrWhiteSpace(heading)) { <h2 class="h2">@Text.Emphasis(heading, Encoder)</h2> }
        @if (!string.IsNullOrWhiteSpace(sub)) { <p class="mt-3 text-lg font-semibold leading-relaxed text-brand-700 dark:text-brand-300">@Text.Emphasis(sub, Encoder)</p> }
        <span class="mt-6 block h-1 w-20 rounded-full bg-brand-600" aria-hidden="true"></span>
    </div>
    <div class="rv lg:border-s lg:border-slate-200 lg:ps-16 dark:lg:border-white/10">
        @if (!string.IsNullOrWhiteSpace(body)) { <div class="rte text-[1.05rem]">@Html.Raw(body)</div> }
        @if (ctas.Count > 0)
        {
            <div class="mt-7 flex flex-wrap gap-3">
                @for (var i = 0; i < ctas.Count; i++) { <a class="btn @(i == 0 ? "btn-primary" : "btn-ghost")" href="@ctas[i].Url" target="@ctas[i].Target">@ctas[i].Name</a> }
            </div>
        }
    </div>
</div>
