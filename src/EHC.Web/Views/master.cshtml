@* Master layout: culture/direction + active theme on <html>, site chrome around the page body. *@
@using EHC.Web.Blocks
@using EHC.Web.Site
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject ISiteContext Site
@inject Microsoft.Extensions.Options.IOptions<EHC.Web.Vitals.VitalsOptions> Vitals
@inject Microsoft.Extensions.Options.IOptions<EHC.Web.Stats.StatsOptions> Stats
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider Versions
@{
    Layout = null;
    var site = Site.Get(Model);                           // culture comes from the hostname (/ar, /en)
    var theme = site.Theme;
    var siteName = Umbraco.GetDictionaryValue("EHC.Common.SiteName");
    if (string.IsNullOrWhiteSpace(siteName)) { siteName = "EHC"; }
    var metaTitle = Model.Value<string>("metaTitle");
    if (string.IsNullOrWhiteSpace(metaTitle))
    {
        var pageTitle = Model.Value<string>("pageTitle");
        metaTitle = Model.ContentType.Alias == "home" ? siteName : $"{(string.IsNullOrWhiteSpace(pageTitle) ? Model.Name : pageTitle)} | {siteName}";
    }
    var metaDescription = Model.Value<string>("metaDescription");
    if (string.IsNullOrWhiteSpace(metaDescription)) { metaDescription = Model.Value<string>("intro"); }
    if (string.IsNullOrWhiteSpace(metaDescription)) { metaDescription = Umbraco.GetDictionaryValue("EHC.Common.SiteDescription"); }
    var canonical = site.Alternates.FirstOrDefault(a => a.Culture == site.Culture.Name)?.Url ?? Model.Url(mode: global::Umbraco.Cms.Core.Models.PublishedContent.UrlMode.Absolute);
    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var ogImage = Model.Value<global::Umbraco.Cms.Core.Models.MediaWithCrops>("ogImage")?.GetCropUrl(1200, 630) ?? site.LogoUrl;
    if (ogImage.StartsWith('/')) { ogImage = origin + ogImage; }
    var arabic = site.Alternates.FirstOrDefault(a => a.Language == "ar");
}
<!DOCTYPE html>
@* The active theme's colours arrive as CSS variables in the style attribute (Razor drops it when there is no theme). *@
@* class: the site's look (Site settings › Look) with a reviewer's customizer choices on top (allow-listed,
   Site/Customizer.cs); dropped when everything is default. *@
<html lang="@site.Language" dir="@(site.IsRtl ? "rtl" : "ltr")" class="@Customizer.HtmlClass(site.Looks, Customizer.Current(Context))" style="@theme.InlineStyle">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @* the site draws both schemes itself: stops mobile browsers (Chrome auto-dark, Samsung Internet) force-darkening it *@
    <meta name="color-scheme" content="light dark">
    @* installable app (sw.js registered in site.js; offline page with emergency numbers) *@
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#060F1E" media="(prefers-color-scheme: dark)">
    <link rel="apple-touch-icon" href="/assets/img/icons/apple-touch-icon.png">
    <title>@metaTitle</title>
    @if (!string.IsNullOrWhiteSpace(metaDescription))
    {
        <meta name="description" content="@metaDescription">
    }
    @if (Model.Value<bool>("noIndex"))
    {
        <meta name="robots" content="noindex">
    }
    <link rel="canonical" href="@canonical">
    @foreach (var alt in site.Alternates)
    {
        <link rel="alternate" hreflang="@alt.Language" href="@alt.Url">
    }
    @if (arabic is not null) { <link rel="alternate" hreflang="x-default" href="@arabic.Url"> }
    <meta property="og:site_name" content="@siteName">
    <meta property="og:type" content="@(Model.ContentType.Alias == "newsItem" ? "article" : "website")">
    <meta property="og:title" content="@metaTitle">
    @if (!string.IsNullOrWhiteSpace(metaDescription)) { <meta property="og:description" content="@metaDescription"> }
    <meta property="og:url" content="@canonical">
    <meta property="og:image" content="@ogImage">
    <meta property="og:locale" content="@site.Culture.Name.Replace('-', '_')">
    @foreach (var alt in site.Alternates.Where(a => a.Culture != site.Culture.Name)) { <meta property="og:locale:alternate" content="@alt.Culture.Replace('-', '_')"> }
    <meta name="twitter:card" content="summary_large_image">
    <script src="~/assets/js/theme-init.js" asp-append-version="true"></script>  @* sets .dark before paint; no inline script (CSP) *@
    @* both subsets: Arabic pages also use the Latin one for digits and punctuation in the hero headline *@
    <link rel="preload" href="~/assets/fonts/cairo-arabic-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="~/assets/fonts/cairo-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="~/assets/css/ehc.css" asp-append-version="true">
    @if (Customizer.IsOn(Context))
    {
        <link rel="stylesheet" href="~/assets/css/customizer-vt.css" asp-append-version="true">
        @* after a customizer change: show the page only once customizer.js has restored the scroll position *@
        if (Context.Request.Cookies[Customizer.OpenCookieName] == "1") { <link rel="expect" href="#cz-ready" blocking="render"> }
    }
</head>
<body class="leading-relaxed">
    @await Html.PartialAsync("site/_Icons")
    <a href="#main" class="absolute start-3 -top-16 z-[100] rounded-lg bg-deep-900 px-3.5 py-2.5 text-white focus:top-3">@Umbraco.GetDictionaryValue("EHC.Common.SkipToContent")</a>
    @await Html.PartialAsync("site/_CookieNotice", site)  @* early in the tab order; shown fixed at the bottom *@
    @await Html.PartialAsync("site/_BrowserTip")

    @await Html.PartialAsync("site/_StagingRibbon", site)
    @await Html.PartialAsync("site/_Ribbon", theme)
    @await Html.PartialAsync("site/_UtilityBar", site)
    @await Html.PartialAsync("site/_Header", site)
    @await Html.PartialAsync("site/_Drawer", site)

    <main id="main" tabindex="-1">
        @RenderBody()
        @if (ViewData["emptyPage"] is not true)
        {
            @await Html.PartialAsync("site/_Feedback", Model)
        }
    </main>

    @await Html.PartialAsync("site/_Footer", site)
    @await Html.PartialAsync("site/_MobileBar", site)
    @await Html.PartialAsync("site/_Search")
    @await Html.PartialAsync("site/_A11yPanel", site)
    @await Html.PartialAsync("site/_Assistant", site)
    @await Html.PartialAsync("site/_Customizer", site)
    <script src="~/assets/js/site.js" asp-append-version="true" defer></script>
    @if (Vitals.Value.Enabled)
    {
        @* real-visitor Core Web Vitals: loads and sends nothing until the visitor accepts optional cookies *@
        <script src="~/assets/js/components/vitals.js" asp-append-version="true" defer data-page="@Model.Key" data-culture="@site.Culture.Name"
                data-lib="@Versions.AddFileVersionToPath(Context.Request.PathBase, "/assets/vendor/web-vitals/web-vitals.iife.js")" data-sample="@Vitals.Value.SampleRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"></script>
    }
    @if (Stats.Value.Enabled && UmbracoContext?.InPreviewMode != true)
    {
        @* visitor statistics: cookieless, same-origin; editors previewing unpublished changes are not counted *@
        <script src="~/assets/js/components/stats.js" asp-append-version="true" defer data-page="@Model.Key" data-culture="@site.Culture.Name"
                data-consent="@(Stats.Value.RequireConsent ? "required" : "none")"></script>
        @if (Stats.Value.Heatmaps)
        {
            @* click and scroll heatmaps: records nothing until the visitor accepts optional cookies *@
            <script src="~/assets/js/components/heat.js" asp-append-version="true" defer data-page="@Model.Key" data-culture="@site.Culture.Name"
                    data-sample="@Stats.Value.HeatmapSampleRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"></script>
        }
    }
</body>
</html>
