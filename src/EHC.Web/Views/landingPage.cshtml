@* Landing page: page header (breadcrumb, title, intro) followed by the page's sections. *@
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "master.cshtml";
    var blocks = Model.Value<BlockListModel>("blocks");
    // a hero as the first section is the page header (and the page's h1)
    var heroFirst = blocks?.FirstOrDefault()?.Content.ContentType.Alias.StartsWith("hero") ?? false;
}
@if (!heroFirst)
{
    @await Html.PartialAsync("site/_PageHeader", Model)
}
@await Html.GetBlockListHtmlAsync(blocks)
