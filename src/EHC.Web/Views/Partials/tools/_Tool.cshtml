@* One health tool (calculator or self-assessment) in a card. Used by health tool pages and the "Health tool" section.
   Texts: dictionary EHC.Tools.* (clinical team approves the wording). Behaviour: components/health-tools.js and
   components/vision-test.js — everything is calculated in the browser; nothing is sent or stored. *@
@using System.Text.Json
@using EHC.Web.Site
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<HealthTools.Tool>
@{
    string D(string k) => Umbraco.GetDictionaryValue("EHC.Tools." + k) ?? "";
    // the same on every load (anchors and click heatmaps rely on it); numbered in case a page has a tool twice
    var n = (Context.Items["ehc-tool-n"] as int? ?? 0) + 1;
    Context.Items["ehc-tool-n"] = n;
    var id = $"tool-{Model.Key}-{n}";
    ViewData["toolId"] = id;
    var partial = Model.Key switch
    {
        "visualAcuity" => "tools/_VisualAcuity",
        "prediabetes" or "asthma" => "tools/_Questionnaire",
        _ => "tools/_" + char.ToUpperInvariant(Model.Key[0]) + Model.Key[1..],
    };
    // Hijri month names as spelled elsewhere on the site (Site/Dates.cs), for the date tools
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    var hijri = JsonSerializer.Serialize(Dates.HijriMonths(culture));
}
<div class="tool card p-5 sm:p-8" id="@id" data-tool="@Model.Key" data-hijri-months="@hijri" data-hijri-suffix="@(culture.TwoLetterISOLanguageName == "ar" ? "هـ" : " AH")">
    @await Html.PartialAsync(partial, Model, ViewData)
    <p class="mt-6 flex items-start gap-2 border-t border-slate-100 pt-5 text-sm text-slate-600 dark:border-white/10 dark:text-slate-400">
        <svg class="ico mt-0.5 !h-4 !w-4 shrink-0" aria-hidden="true"><use href="#i-shield" /></svg>
        <span>@D("Disclaimer") @D("Privacy")</span>
    </p>
    <noscript><p class="mt-4 rounded-2xl bg-soft p-4 text-sm dark:bg-white/5">@D("NoScript")</p></noscript>
</div>
@switch (Model.Key)
{
    case "visualAcuity": <script src="~/assets/js/components/vision-test.js" asp-append-version="true" defer></script> break;
    case "bmi": <script src="~/assets/js/components/bmi.js" asp-append-version="true" defer></script> break;
    default: <script src="~/assets/js/components/health-tools.js" asp-append-version="true" defer></script> break;
}
