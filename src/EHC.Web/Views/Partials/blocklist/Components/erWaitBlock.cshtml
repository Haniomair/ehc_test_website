@* Block 4 "ER wait times": picked facilities with an emergency department; live estimates from GET /api/er-wait
   (matched by facility.erFeedId). Until a real feed exists the section shows a "coming soon" note and no numbers —
   never fake numbers in production (docs/06). Demo data (development only) is labelled "illustrative".
   JS: components/er-wait.js. *@
@using EHC.Web.Blocks
@using EHC.Web.Site
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@inject ISiteContext Site
@{
    var c = Model.Content;
    var facilities = c.Value<IEnumerable<IPublishedContent>>("facilities")?.Where(f => f.Value<bool>("hasEmergency")).ToList() ?? [];
    var showCall = c.Value<bool>("showCallCard");
    if (facilities.Count == 0 && !showCall) { return; }
    var site = Site.Get(Umbraco.AssignedContentItem);
    var emergency = site.Phones.Where(p => p.IsEmergency).Take(2).ToList();
    string D(string k) => Umbraco.GetDictionaryValue("EHC.Er." + k) ?? "";
    var labels = System.Text.Json.JsonSerializer.Serialize(new { quiet = D("Quiet"), moderate = D("Moderate"), busy = D("Busy") });
}
<div class="wrap" data-er data-api="/api/er-wait" data-labels="@labels">
    <div class="rv mb-7 flex flex-wrap items-end justify-between gap-4">
        @await Html.PartialAsync("blocklist/_SectionHeader", new SectionHeader(D("Eyebrow"), c.Value<string>("heading"), null))
        <p class="hidden items-center gap-2 rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-[.8rem] text-slate-600 dark:border-white/10 dark:bg-night-900 dark:text-slate-300" data-er-status>
            <span class="relative flex h-2.5 w-2.5" aria-hidden="true"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span></span>
            <span>@D("Live")</span><b class="hidden rounded-full bg-accent-400/25 px-2 text-xs text-deep-900 dark:text-accent-400" data-er-illustrative>@D("Illustrative")</b>
        </p>
    </div>
    <p class="mb-5 rounded-2xl bg-soft p-4 text-sm text-slate-600 dark:bg-night-900 dark:text-slate-400" data-er-soon>@D("ComingSoon")</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var f in facilities)
        {
            <a href="@f.Url()" class="rv card group p-5 transition hover:-translate-y-1 hover:shadow-soft" data-er-feed="@(f.Value<string>("erFeedId"))">
                <div class="flex items-start justify-between gap-3">
                    <div><b class="block leading-snug">@f.Name</b>@if (!string.IsNullOrWhiteSpace(f.Value<string>("city"))) {<span class="text-[.8rem] text-slate-500 dark:text-slate-400">@(f.Value<string>("city"))</span>}</div>
                    <span class="hidden whitespace-nowrap rounded-full px-2 py-0.5 text-[.7rem] font-bold" data-er-badge></span>
                </div>
                <div class="mt-4 hidden items-baseline gap-1" data-er-value><b class="text-[2.4rem] font-extrabold leading-none text-deep-900 dark:text-white" data-er-min></b><span class="text-sm text-slate-500 dark:text-slate-400">@D("Minutes")</span></div>
                <div class="mt-3 hidden h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-white/10" data-er-track aria-hidden="true"><i class="block h-full w-0 rounded-full transition-all duration-700" data-er-bar></i></div>
                <span class="link mt-4 text-sm"><span>@D("Details")</span><svg class="ico flip !h-4 !w-4" aria-hidden="true"><use href="#i-arrow" /></svg></span>
            </a>
        }
        @if (showCall)
        {
            <div class="rv flex flex-col justify-between rounded-[22px] bg-emerg-600 p-5 text-white">
                <div><b class="block text-lg leading-snug">@D("CallTitle")</b><span class="mt-1 block text-sm text-white/85">@D("CallText")</span></div>
                @if (emergency.Count > 0)
                {
                    <div class="mt-4 grid grid-cols-2 gap-2">
                        @for (var i = 0; i < emergency.Count; i++) { <a href="tel:@emergency[i].Dial" class="rounded-xl py-2 text-center font-extrabold @(i == 0 ? "bg-white text-emerg-600" : "bg-white/15")">@emergency[i].Number</a> }
                    </div>
                }
            </div>
        }
    </div>
</div>
<script src="~/assets/js/components/er-wait.js" asp-append-version="true" defer></script>
