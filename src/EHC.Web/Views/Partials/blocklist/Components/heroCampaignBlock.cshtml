@* Block 1 "Campaign hero": rotating slides (nested `slides`) + optional right panel.
   Set this block's spacing to "none" (it is full-bleed). Behaviour: frontend/src/js/components/hero-campaign.js
   (tabs, auto-rotate with a pause button, stops under prefers-reduced-motion). *@
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var c = Model.Content;
    var slides = c.Value<BlockListModel>("slides")?.Select(s => s.Content).Where(s => !string.IsNullOrWhiteSpace(s.Value<string>("title"))).ToList() ?? [];
    if (slides.Count == 0) { return; }
    var seconds = c.Value<int>("autoRotateSeconds");
    if (seconds is <= 0 or > 60) { seconds = 7; }
    var panel = c.Value<string>("rightPanel") ?? "cards";
    var cards = c.Value<BlockListModel>("floatingCards")?.Select(x => x.Content).ToList() ?? [];
    var navigator = panel == "navigator" ? EHC.Web.Blocks.HeroNavigator.Embedded(Umbraco.AssignedContentItem.Value<BlockListModel>("blocks")) : null;
    var showPanel = panel != "none" && (cards.Count > 0 || panel == "art" || navigator is not null);
    string Bg(IPublishedElement s) => s.Value<string>("backgroundPreset") switch { "1" => "hero-bg-1", "2" => "hero-bg-2", _ => "hero-bg-0" };   // allow-list
    var id = "hero-" + Model.ContentKey.ToString("N")[..8];
    const string titleCss = "mb-5 text-[clamp(2.4rem,5.6vw,4.6rem)] font-bold leading-[1.12] tracking-[-.01em] rtl:leading-[1.3] rtl:tracking-normal";
}
<div data-hero data-interval="@(seconds * 1000)" class="@Bg(slides[0]) relative overflow-hidden text-white transition-[background] duration-700">
    <div class="mark-bg mark-white anim-spin-slow pointer-events-none absolute -end-[120px] top-[calc(50%-380px)] h-[760px] w-[760px] opacity-[.08]" aria-hidden="true"></div>
    <div class="wrap relative grid items-center gap-10 pb-[110px] pt-7 lg:min-h-[620px] lg:pb-[120px] lg:pt-10 @(showPanel ? "lg:grid-cols-[1.05fr_.95fr]" : "")">
        <div>
            @for (var i = 0; i < slides.Count; i++)
            {
                var s = slides[i];
                var primary = s.Value<Link>("primaryCta");
                var secondary = s.Value<Link>("secondaryCta");
                var highlight = s.Value<string>("titleHighlight");
                <div class="slide anim-fadeup @(i == 0 ? "" : "hidden")" id="@id-s@(i)" role="tabpanel" aria-labelledby="@id-t@(i)" data-bg="@Bg(s)">
                    @if (!string.IsNullOrWhiteSpace(s.Value<string>("kicker")))
                    {
                        <span class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-white/20 bg-white/10 py-1.5 pe-4 ps-1.5 text-[.85rem] font-medium">
                            @if (!string.IsNullOrWhiteSpace(s.Value<string>("badge"))) { <b class="rounded-full bg-white px-2.5 py-0.5 text-xs text-deep-900">@(s.Value<string>("badge"))</b> }
                            <span>@(s.Value<string>("kicker"))</span>
                        </span>
                    }
                    @* Only the first slide is the page's h1; the others are visually identical h2s. *@
                    @if (i == 0)
                    {
                        <h1 class="@titleCss">@(s.Value<string>("title"))@if (!string.IsNullOrWhiteSpace(highlight)) {<br><em class="not-italic text-brand-300">@highlight</em>}</h1>
                    }
                    else
                    {
                        <h2 class="@titleCss">@(s.Value<string>("title"))@if (!string.IsNullOrWhiteSpace(highlight)) {<br><em class="not-italic text-brand-300">@highlight</em>}</h2>
                    }
                    @if (!string.IsNullOrWhiteSpace(s.Value<string>("lead"))) { <p class="mb-8 max-w-[540px] text-[1.15rem] text-white/85">@(s.Value<string>("lead"))</p> }
                    @if (primary is not null || secondary is not null)
                    {
                        <div class="flex flex-wrap gap-3">
                            @if (primary is not null) { <a class="btn btn-sand btn-lg" href="@primary.Url" target="@primary.Target"><svg class="ico" aria-hidden="true"><use href="#i-cal" /></svg><span>@primary.Name</span></a> }
                            @if (secondary is not null) { <a class="btn btn-outline btn-lg" href="@secondary.Url" target="@secondary.Target">@secondary.Name</a> }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(s.Value<string>("finePrint"))) { <div class="mt-4 text-[.8rem] text-white/65">@(s.Value<string>("finePrint"))</div> }
                </div>
            }
            @if (slides.Count > 1)
            {
                <div class="mt-8 flex items-end gap-2 sm:mt-11 sm:gap-3.5">
                    <div class="flex flex-1 gap-2 sm:flex-none sm:gap-3.5" role="tablist" aria-label="@Umbraco.GetDictionaryValue("EHC.Hero.Campaigns")">
                        @for (var i = 0; i < slides.Count; i++)
                        {
                            var label = slides[i].Value<string>("navLabel");
                            if (string.IsNullOrWhiteSpace(label)) { label = slides[i].Value<string>("title"); }
                            <button type="button" id="@id-t@(i)" data-i="@i" role="tab" aria-controls="@id-s@(i)" aria-selected="@(i == 0 ? "true" : "false")" tabindex="@(i == 0 ? "0" : "-1")" class="flex flex-1 flex-col gap-2 text-start text-[.7rem] font-semibold text-white/70 sm:w-[170px] sm:flex-none sm:text-[.8rem] [&.prog-on]:text-white">
                                <span class="bar block h-[3px] overflow-hidden rounded bg-white/25" aria-hidden="true"><i class="block h-full w-0 bg-white"></i></span>
                                <span class="sr-only sm:not-sr-only">@label</span>
                            </button>
                        }
                    </div>
                    <button type="button" data-hero-pause class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-white/30 text-white hover:bg-white/10" aria-pressed="false" aria-label="@Umbraco.GetDictionaryValue("EHC.Hero.Pause")">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon="pause"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
                        <svg class="hidden h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon="play"><path d="M8 5v14l11-7z" /></svg>
                    </button>
                </div>
            }
        </div>
        @if (navigator is not null)
        {
            @await Html.PartialAsync("blocklist/Components/careNavigatorBlock", navigator, new ViewDataDictionary(ViewData) { ["inHero"] = true })
        }
        else if (showPanel)
        {
            <div class="relative hidden min-h-[380px] lg:block">
                @if (panel == "art")
                {
                    <div class="absolute inset-0 grid place-items-center">
                        <div class="relative h-[340px] w-[340px] rounded-full border border-white/15">
                            <div class="absolute inset-[40px] rounded-full border border-dashed border-white/20 anim-spin-slow"></div>
                            <div class="absolute inset-[110px] grid place-items-center rounded-full bg-white shadow-[0_30px_80px_rgba(0,0,0,.3)] dark:bg-night-900"><span class="mark-bg h-20 w-20"></span></div>
                        </div>
                    </div>
                }
                <div class="relative flex h-full flex-col justify-center gap-4 @(panel == "art" ? "items-end" : "")">
                    @for (var i = 0; i < cards.Count; i++)
                    {
                        var card = cards[i];
                        var icon = card.Value<string>("icon");
                        <div class="flex w-fit max-w-[320px] items-center gap-3 rounded-2xl border border-white/20 bg-white/10 p-4 shadow-[0_20px_50px_rgba(0,0,0,.2)] backdrop-blur-xl @(i % 2 == 1 ? "ms-10" : "")">
                            @if (!string.IsNullOrWhiteSpace(icon)) { <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-white text-brand-500 dark:bg-night-900 dark:text-brand-300"><svg class="ico" aria-hidden="true"><use href="#i-@icon" /></svg></span> }
                            <span><b class="block leading-tight">@(card.Value<string>("title"))</b><span class="text-sm text-white/75">@(card.Value<string>("subtitle"))</span></span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
<script src="~/assets/js/components/hero-campaign.js" asp-append-version="true" defer></script>
