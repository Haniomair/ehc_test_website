@* Search palette (Ctrl+K / search button / search hero). Results from GET /api/search, grouped; labels from the dictionary. *@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    string D(string k) => Umbraco.GetDictionaryValue(k) ?? k;
    var labels = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
    {
        ["specialties"] = D("EHC.Search.Group.specialties"),
        ["doctors"] = D("EHC.Search.Group.doctors"),
        ["facilities"] = D("EHC.Search.Group.facilities"),
        ["campaigns"] = D("EHC.Search.Group.campaigns"),
        ["news"] = D("EHC.Search.Group.news"),
        ["pages"] = D("EHC.Search.Group.pages"),
    });
}
<div id="search" class="fixed inset-0 z-[90] hidden" role="dialog" aria-modal="true" aria-labelledby="searchTitle">
    <div class="absolute inset-0 bg-deep-950/60 backdrop-blur-sm" data-action="search-close"></div>
    <div class="relative mx-auto mt-[8vh] w-[min(680px,calc(100%-32px))] overflow-hidden rounded-3xl bg-white shadow-[0_40px_100px_rgba(0,0,0,.35)] dark:bg-night-900 dark:ring-1 dark:ring-white/10">
        <h2 id="searchTitle" class="sr-only">@D("EHC.Search.Title")</h2>
        <label class="flex items-center gap-3 border-b border-slate-200 px-5 dark:border-white/10">
            <svg class="ico text-brand-500" aria-hidden="true"><use href="#i-search" /></svg>
            <span class="sr-only">@D("EHC.Search.Title")</span>
            <input id="sIn" type="search" autocomplete="off" class="h-16 min-w-0 flex-1 bg-transparent text-lg outline-hidden placeholder:text-slate-400" placeholder="@D("EHC.Search.Placeholder")" aria-controls="sRes">
            <button type="button" data-action="search-close" class="rounded-md border border-slate-200 px-1.5 py-0.5 text-xs text-slate-400 dark:border-white/15" aria-label="@D("EHC.Common.Close")">Esc</button>
        </label>
        <div id="sRes" class="max-h-[60vh] overflow-y-auto p-3" aria-live="polite"
             data-api="/api/search" data-labels="@labels" data-hint="@D("EHC.Search.Hint")" data-empty="@D("EHC.Search.NoResults")" data-error="@D("EHC.Search.Error")">
            <p class="px-3 py-8 text-center text-slate-500 dark:text-slate-400">@D("EHC.Search.Hint")</p>
        </div>
    </div>
</div>
