                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      "cal"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062A \u0627\u0644\u062E\u0627\u0635\u0629 \u0628\u0627\u0644\u0639\u064A\u0627\u062F\u0627\u062A \u0627\u0644\u062E\u0627\u0631\u062C\u064A\u0629"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Outpatient information"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062E\u062F\u0645\u0627\u062A\u0646\u0627 \u0644\u0644\u0645\u0631\u0636\u0649 \u0627\u0644\u062E\u0627\u0631\u062C\u064A\u064A\u0646 \u062A\u064F\u0645\u0643\u0651\u0646\u0646\u0627 \u0645\u0646 \u062A\u0642\u062F\u064A\u0645 \u0639\u0644\u0627\u062C \u0639\u0627\u0644\u064A \u0627\u0644\u062C\u0648\u062F\u0629 \u062F\u0648\u0646 \u0627\u0644\u062D\u0627\u062C\u0629 \u0644\u0644\u0628\u0642\u0627\u0621 \u0623\u0646\u062A \u0623\u0648 \u0623\u062D\u062F \u0623\u062D\u0628\u0627\u0626\u0643 \u0641\u064A \u0627\u0644\u0645\u0633\u062A\u0634\u0641\u0649 \u0637\u0648\u0627\u0644 \u0627\u0644\u0644\u064A\u0644."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Our outpatient services enable us to provide quality treatment without the need for you or your loved one to remain in hospital overnight."
                  },
                  {
                    "alias": "link",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "\u0627\u0644\u0645\u0648\u0627\u0639\u064A\u062F \u0648\u0627\u0644\u062E\u062F\u0645\u0627\u062A \u0627\u0644\u0625\u0644\u0643\u062A\u0631\u0648\u0646\u064A\u0629",
                        "target": null,
                        "unique": "6dbcc9f3-97f8-4191-8064-ec0a80ec8551",
