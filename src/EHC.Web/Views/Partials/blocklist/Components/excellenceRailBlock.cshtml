@* Block 10 "Centers of excellence": horizontal snap rail of cards on its own deep background (give it spacing "none";
   the section paints its own padding). Prev/next buttons: frontend/src/js/components/rail.js. Numbers are automatic. *@
@using EHC.Web.Blocks
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var c = Model.Content;
    var items = c.Value<BlockListModel>("items")?.Select(i => i.Content).Where(i => !string.IsNullOrWhiteSpace(i.Value<string>("title"))).ToList() ?? [];
    if (items.Count == 0) { return; }
    var id = "rail-" + Model.ContentKey.ToString("N")[..8];
}
<div class="relative overflow-hidden bg-deep-900 py-16 text-white lg:py-24 dark:bg-deep-950 dark:ring-1 dark:ring-white/5">
    <div class="mark-bg mark-white absolute -bottom-52 -start-52 h-[600px] w-[600px] opacity-[.05]" aria-hidden="true"></div>
    <div class="wrap relative">
        <div class="rv sec-head-row">
            @await Html.PartialAsync("blocklist/_SectionHeader", new SectionHeader(c.Value<string>("eyebrow"), c.Value<string>("heading"), c.Value<string>("intro"), OnDark: true))
            @if (items.Count > 1)
            {
                <div class="flex gap-2">
                    <button type="button" data-rail-prev="@id" class="grid h-12 w-12 place-items-center rounded-full border border-white/30 hover:bg-white/10" aria-label="@Umbraco.GetDictionaryValue("EHC.Common.Previous")" aria-controls="@id"><svg class="ico rotate-180 rtl:rotate-0" aria-hidden="true"><use href="#i-arrow" /></svg></button>
                    <button type="button" data-rail-next="@id" class="grid h-12 w-12 place-items-center rounded-full border border-white/30 hover:bg-white/10" aria-label="@Umbraco.GetDictionaryValue("EHC.Common.Next")" aria-controls="@id"><svg class="ico flip" aria-hidden="true"><use href="#i-arrow" /></svg></button>
                </div>
            }
        </div>
        <div id="@id" class="scrollbar-none grid snap-x snap-mandatory auto-cols-[minmax(280px,1fr)] grid-flow-col gap-5 overflow-x-auto py-1 sm:auto-cols-[minmax(300px,1fr)]">
            @for (var i = 0; i < items.Count; i++)
            {
                var it = items[i];
                var hi = it.Value<bool>("highlight");
                var link = it.Value<Link>("link");
                var icon = it.Value<string>("icon");
                <a class="flex min-h-[340px] snap-start flex-col gap-3 rounded-[22px] p-7 transition hover:-translate-y-1 @(hi ? "bg-linear-to-br from-brand-500 to-support-500" : "border border-white/10 bg-white/[.06] hover:bg-white/10")" href="@(link?.Url ?? "#")" target="@link?.Target">
                    <span class="text-[4rem] font-bold leading-none @(hi ? "text-white/60" : "text-brand-300/70")" aria-hidden="true">@((i + 1).ToString("00"))</span>
                    @if (!string.IsNullOrWhiteSpace(icon)) { <span class="grid h-14 w-14 place-items-center rounded-2xl @(hi ? "bg-white/20" : "bg-brand-300/15 text-brand-300")"><svg class="ico" aria-hidden="true"><use href="#i-@icon" /></svg></span> }
                    <h3 class="mt-auto text-[1.35rem] font-bold">@(it.Value<string>("title"))</h3>
                    @if (!string.IsNullOrWhiteSpace(it.Value<string>("text"))) { <p class="text-[.92rem] @(hi ? "text-brand-50" : "text-on-deep")">@(it.Value<string>("text"))</p> }
                    @if (!string.IsNullOrWhiteSpace(link?.Name)) { <span class="inline-flex items-center gap-1.5 font-semibold @(hi ? "" : "text-brand-300")">@link.Name<svg class="ico flip !h-4 !w-4" aria-hidden="true"><use href="#i-arrow" /></svg></span> }
                </a>
            }
        </div>
    </div>
</div>
<script src="~/assets/js/components/rail.js" asp-append-version="true" defer></script>
