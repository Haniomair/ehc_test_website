    <during>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u064A\u0648\u0636\u0639 \u0645\u0634\u0628\u0643 \u0639\u0644\u0649 \u0623\u0646\u0641\u0643\u060C \u062B\u0645 \u062A\u0623\u062E\u0630 \u0646\u0641\u0633\u064B\u0627 \u0639\u0645\u064A\u0642\u064B\u0627 \u0648\u062A\u0646\u0641\u062E \u0628\u0623\u0642\u0648\u0649 \u0648\u0623\u0633\u0631\u0639 \u0645\u0627 \u064A\u0645\u0643\u0646 \u0641\u064A \u0623\u0646\u0628\u0648\u0628. \u064A\u064F\u0643\u0631\u0631 \u0630\u0644\u0643 \u0639\u062F\u0629 \u0645\u0631\u0627\u062A\u060C \u0648\u0642\u062F \u064A\u064F\u0639\u0627\u062F \u0628\u0639\u062F \u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0628\u062E\u0627\u062E \u0645\u0648\u0633\u0651\u0639 \u0644\u0644\u0634\u0639\u0628.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EA clip is placed on your nose. You take a deep breath and blow as hard and fast as you can into a mouthpiece. This is repeated a few times, and may be repeated after using a reliever inhaler.\u003C/p\u003E"
}]]></Value>
    </during>
