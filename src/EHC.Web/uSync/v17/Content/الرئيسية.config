                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "\u062A\u0635\u0641\u0651\u062D \u0627\u0644\u0645\u0643\u062A\u0628\u0629 \u0627\u0644\u0635\u062D\u064A\u0629",
