                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "\u0627\u0644\u0645\u0643\u062A\u0628\u0629 \u0627\u0644\u0635\u062D\u064A\u0629",
                        "target": null,
                        "unique": null,
                        "type": null,
                        "udi": "umb://document/5ace45919d5c420883ccc855385383f6",
                        "url": null,
                        "queryString": null,
                        "culture": null
                      }
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Self-care at home"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "This usually gets better with rest and fluids. See your family doctor if it gets worse or lasts more than a few days."
                  },
