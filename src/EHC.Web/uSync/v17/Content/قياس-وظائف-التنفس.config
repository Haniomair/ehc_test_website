    <about>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u064A\u0642\u064A\u0633 \u0627\u0644\u062C\u0647\u0627\u0632 \u0643\u0645\u064A\u0629 \u0627\u0644\u0647\u0648\u0627\u0621 \u0627\u0644\u062A\u064A \u062A\u0633\u062A\u0637\u064A\u0639 \u0625\u062E\u0631\u0627\u062C\u0647\u0627 \u0628\u0639\u062F \u0623\u062E\u0630 \u0646\u0641\u0633 \u0639\u0645\u064A\u0642\u060C \u0648\u0633\u0631\u0639\u0629 \u0625\u062E\u0631\u0627\u062C\u0647\u0627.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EA machine measures how much air you can blow out after a deep breath, and how quickly.\u003C/p\u003E"
}]]></Value>
    </about>
