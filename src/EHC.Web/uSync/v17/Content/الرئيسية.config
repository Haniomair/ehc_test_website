        {
          "alias": "intro",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0645\u0633\u062A\u0634\u0641\u064A\u0627\u062A \u0648\u0645\u0631\u0627\u0643\u0632 \u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0627\u0644\u0623\u0648\u0644\u064A\u0629 \u0641\u064A \u0627\u0644\u062A\u062C\u0645\u0639 \u0645\u0648\u0632\u0639\u0629 \u0639\u0644\u0649 \u0634\u0628\u0643\u0627\u062A \u0635\u062D\u064A\u0629."
