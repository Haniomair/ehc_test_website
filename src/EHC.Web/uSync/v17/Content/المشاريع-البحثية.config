          "segment": null,
          "value": "\u0627\u0646\u0636\u0645 \u0625\u0644\u0649 \u0623\u0628\u062D\u0627\u062B\u0646\u0627"
        },
        {
          "alias": "title",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Join our research"
        },
        {
          "alias": "text",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u062A\u0639\u0631\u0651\u0641 \u0639\u0644\u0649 \u062E\u062F\u0645\u0627\u062A \u0627\u0644\u062F\u0639\u0645 \u0627\u0644\u0628\u062D\u062B\u064A \u0648\u0643\u064A\u0641 \u062A\u0628\u062F\u0623 \u0631\u062D\u0644\u062A\u0643 \u0627\u0644\u0628\u062D\u062B\u064A\u0629 \u0645\u0639\u0646\u0627."
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Find out about our research support services and how to start your research journey with us."
