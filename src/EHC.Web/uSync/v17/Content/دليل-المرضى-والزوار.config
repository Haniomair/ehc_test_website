                    "value": "\u0627\u0644\u0632\u0648\u0627\u0631"
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Visitor information"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062E\u0637\u0637 \u0644\u0632\u064A\u0627\u0631\u062A\u0643 \u0645\u0639 \u0645\u0639\u0644\u0648\u0645\u0627\u062A \u062D\u0648\u0644 \u0623\u0648\u0642\u0627\u062A \u0627\u0644\u0632\u064A\u0627\u0631\u0629 \u0648\u0645\u0631\u0627\u0641\u0642\u0646\u0627 \u0648\u062E\u062F\u0645\u0627\u062A\u0646\u0627 \u0648\u0645\u0627 \u064A\u0645\u0643\u0646\u0643 \u0648\u0645\u0627 \u0644\u0627 \u064A\u0645\u0643\u0646\u0643 \u0625\u062D\u0636\u0627\u0631\u0647 \u0625\u0644\u0649 \u0645\u0633\u062A\u0634\u0641\u064A\u0627\u062A\u0646\u0627."
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Plan your visit with information about visiting times, our facilities and services, and what you can and cannot bring to our hospitals."
                  },
