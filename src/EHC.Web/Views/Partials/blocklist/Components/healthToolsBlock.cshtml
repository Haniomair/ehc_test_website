@* Block 11 "Health tools" (Know your numbers): BMI calculator + reference cards + disclaimer.
   Medical wording (BMI categories/tips in the dictionary, reference values here) must be approved by the clinical team.
   Calculator: Views/Partials/tools/_BmiSlider.cshtml (also used on the BMI tool page). *@
@using EHC.Web.Blocks
@using EHC.Web.Site
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var c = Model.Content;
    var showBmi = c.Value<bool>("showBmi");
    var cards = c.Value<BlockListModel>("referenceCards")?.Select(x => x.Content).Where(x => !string.IsNullOrWhiteSpace(x.Value<string>("value"))).ToList() ?? [];
    if (!showBmi && cards.Count == 0) { return; }
    var ctas = c.Value<IEnumerable<Link>>("bmiCtas")?.ToList() ?? [];
    var disclaimer = c.Value<string>("disclaimer");
    var id = "bmi-" + Model.ContentKey.ToString("N")[..8];
}
<div class="wrap">
    <div class="rv sec-head">
        @await Html.PartialAsync("blocklist/_SectionHeader", new SectionHeader(c.Value<string>("eyebrow"), c.Value<string>("heading"), c.Value<string>("intro")))
    </div>
    <div class="grid gap-5 @(showBmi && cards.Count > 0 ? "lg:grid-cols-[1.25fr_.75fr]" : "")">
        @if (showBmi)
        {
            <div class="rv card p-6 sm:p-8">
                @await Html.PartialAsync("tools/_BmiSlider", new BmiSlider(id, ShowTitle: true))
                @if (ctas.Count > 0)
                {
                    <div class="mt-5 flex flex-wrap gap-3">
                        @for (var i = 0; i < ctas.Count; i++) { <a href="@ctas[i].Url" target="@ctas[i].Target" class="btn @(i == 0 ? "btn-primary" : "btn-ghost") btn-sm">@ctas[i].Name</a> }
                    </div>
                }
            </div>
        }
        @if (cards.Count > 0)
        {
            <div class="grid content-start gap-5">
                @for (var i = 0; i < cards.Count; i++)
                {
                    var r = cards[i];
                    var link = r.Value<Link>("link");
                    var dark = i == 0;
                    <div class="rv rounded-[22px] p-6 @(dark ? "bg-deep-900 text-white dark:bg-brand-500/15 dark:ring-1 dark:ring-brand-400/20" : "bg-soft dark:bg-night-900 dark:ring-1 dark:ring-white/10")">
                        <span class="text-xs font-bold uppercase tracking-widest rtl:tracking-normal @(dark ? "text-brand-300" : "text-support-800 dark:text-support-300")">@(r.Value<string>("label"))</span>
                        <b class="mt-2 block text-[2.4rem] font-extrabold leading-none @(dark ? "" : "text-deep-900 dark:text-white")" dir="ltr">@(r.Value<string>("value"))</b>
                        @if (!string.IsNullOrWhiteSpace(r.Value<string>("unit"))) { <span class="mt-1 block text-sm @(dark ? "text-brand-100" : "text-slate-600 dark:text-slate-400")">@(r.Value<string>("unit"))</span> }
                        @if (link is not null) { <a href="@link.Url" target="@link.Target" class="mt-3 inline-flex items-center gap-1.5 py-1 text-sm font-semibold @(dark ? "text-brand-300" : "link")"><span>@link.Name</span><svg class="ico flip !h-4 !w-4" aria-hidden="true"><use href="#i-arrow" /></svg></a> }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(disclaimer)) { <p class="text-xs text-slate-500 dark:text-slate-400">@disclaimer</p> }
            </div>
        }
    </div>
</div>
@if (showBmi) { <script src="~/assets/js/components/bmi.js" asp-append-version="true" defer></script> }
