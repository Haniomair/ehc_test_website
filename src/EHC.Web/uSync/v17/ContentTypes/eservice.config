      <Composition Key="3f47f63a-8a9e-48ce-92eb-155620ba2a85">seoComposition</Composition>
    </Compositions>
    <DefaultTemplate>eService</DefaultTemplate>
    <AllowedTemplates>
      <Template Key="8e8eeecf-a325-4062-a28a-69c46f01dc9e">eService</Template>
    </AllowedTemplates>
  </Info>
  <Structure />
