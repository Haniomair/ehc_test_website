      "values": [
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0623\u062B\u0646\u0627\u0621 \u062A\u0644\u0642\u064A\u0643 \u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u064A\u062D\u0642 \u0644\u0643"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "During your care, you have the right to"
        },
        {
          "alias": "columns",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "1"
          ]
        },
