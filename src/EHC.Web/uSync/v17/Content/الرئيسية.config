          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0631\u0639\u0627\u064A\u0629 \u0645\u062A\u0643\u0627\u0645\u0644\u0629 *\u0644\u0627\u062D\u062A\u064A\u0627\u062C\u0627\u062A\u0643* \u0641\u064A \u0643\u0644 \u0648\u0642\u062A"
