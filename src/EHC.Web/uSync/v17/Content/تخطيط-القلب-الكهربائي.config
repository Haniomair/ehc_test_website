  <Properties>
    <about>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u064A\u0633\u062C\u0644 \u0627\u0644\u062A\u062E\u0637\u064A\u0637 \u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062A \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064A\u0629 \u0627\u0644\u062A\u064A \u062A\u0646\u0638\u0645 \u0636\u0631\u0628\u0627\u062A \u0627\u0644\u0642\u0644\u0628\u060C \u0648\u064A\u0638\u0647\u0631 \u0633\u0631\u0639\u062A\u0647\u0627 \u0648\u0627\u0646\u062A\u0638\u0627\u0645\u0647\u0627.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EAn ECG records the electrical signals that control your heartbeat, showing how fast and how regularly it beats.\u003C/p\u003E"
}]]></Value>
    </about>
    <alsoKnownAs>
      <Value Culture="ar-SA"><![CDATA[تخطيط القلب، رسم القلب، EKG]]></Value>
      <Value Culture="en-US"><![CDATA[ECG, EKG, heart tracing]]></Value>
    </alsoKnownAs>
