<Dictionary Key="f68c9e7a-cdfb-4268-af8e-4cd779253dde" Alias="EHC.ContactForm.MessageHint" Level="0">
  <Info />
  <Translations>
    <Translation Language="ar-SA">اذكر ما يساعدنا على خدمتك، مثل اسم المنشأة والتاريخ. لا تكتب تفاصيل طبية لا نحتاج إليها.</Translation>
    <Translation Language="en-US">Include what helps us, such as the facility and the date. Please leave out medical details we don't need.</Translation>
  </Translations>
</Dictionary>