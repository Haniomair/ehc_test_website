                    "value": [
                      "primaryCare"
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u062D\u0635\u0644 \u0639\u0644\u0649 \u0631\u0639\u0627\u064A\u0629 \u0639\u0627\u062C\u0644\u0629 \u0627\u0644\u064A\u0648\u0645"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u064A\u062D\u062A\u0627\u062C \u0625\u0644\u0649 \u062A\u0642\u064A\u064A\u0645 \u0627\u0644\u064A\u0648\u0645\u060C \u0644\u0643\u0646\u0647 \u063A\u0627\u0644\u0628\u064B\u0627 \u0644\u0627 \u064A\u0633\u062A\u062F\u0639\u064A \u0627\u0644\u0637\u0648\u0627\u0631\u0626. \u062A\u0648\u062C\u0651\u0647 \u0625\u0644\u0649 \u0623\u0642\u0631\u0628 \u0645\u0631\u0643\u0632 \u0635\u062D\u064A\u060C \u0623\u0648 \u0627\u062A\u0635\u0644 \u0639\u0644\u0649 937 \u0644\u0644\u0627\u0633\u062A\u0634\u0627\u0631\u0629."
                  },
                  {
                    "alias": "ctaLabel",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u062A\u0635\u0644 \u0639\u0644\u0649 937"
                  },
                  {
                    "alias": "ctaLink",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": [
                      {
                        "name": "937",
                        "target": null,
                        "unique": null,
                        "type": null,
                        "udi": null,
                        "url": "tel:937",
                        "queryString": null,
                        "culture": null
                      }
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Get urgent care today"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "It needs to be seen today, but usually not in the emergency department. Go to your nearest health centre, or call 937 for advice."
                  },
                  {
                    "alias": "ctaLabel",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Call 937"
                  },
                  {
                    "alias": "ctaLink",
                    "culture": "en-US",
