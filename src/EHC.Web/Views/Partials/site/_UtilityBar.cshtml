@* Top bar: advice / unified numbers, email, accessibility settings, language switcher. *@
@using EHC.Web.Site
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<EHC.Web.Site.SiteData>
<div class="bg-deep-900 text-[.84rem] text-on-deep dark:border-b dark:border-white/10 dark:bg-night-950">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5 py-1.5">
        <div class="flex items-center gap-[18px]">
            @if (Model.Advice is { } advice)
            {
                <a href="tel:@advice.Dial" class="inline-flex min-h-7 items-center gap-1.5 hover:text-white"><svg class="ico !h-[15px] !w-[15px]" aria-hidden="true"><use href="#i-phone" /></svg><span>@advice.Label</span> <b class="text-white">@advice.Number</b></a>
            }
            @if (Model.UnifiedNumber is { } unified)
            {
                <span class="hidden items-center gap-1.5 sm:inline-flex"><svg class="ico !h-[15px] !w-[15px]" aria-hidden="true"><use href="#i-phone" /></svg><span>@Umbraco.GetDictionaryValue("EHC.Utility.UnifiedNumber")</span> <b class="text-white">@unified</b></span>
            }
            @if (Model.Email is { } email)
            {
                <span class="hidden items-center gap-1.5 md:inline-flex"><svg class="ico !h-[15px] !w-[15px]" aria-hidden="true"><use href="#i-mail" /></svg>@email</span>
            }
        </div>
        <div class="flex items-center gap-2">
            <button type="button" data-action="a11y-open" class="util-btn max-sm:w-7 max-sm:px-0" aria-haspopup="dialog" aria-controls="a11y" aria-expanded="false"><svg class="ico !h-4 !w-4" aria-hidden="true"><use href="#i-a11y" /></svg><span class="max-sm:sr-only">@Umbraco.GetDictionaryValue("EHC.Utility.Accessibility")</span></button>
            @if (Model.OtherLanguage is { } other)
            {
                <a href="@other.Url" hreflang="@other.Language" lang="@other.Language" class="util-btn" aria-label="@Umbraco.GetDictionaryValue("EHC.Utility.OtherLanguageLabel")">@Umbraco.GetDictionaryValue("EHC.Utility.OtherLanguage")</a>
            }
        </div>
    </div>
</div>
