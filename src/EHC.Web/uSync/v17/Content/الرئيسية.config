        {
          "alias": "text",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0627\u062D\u062C\u0632 \u0639\u0628\u0631 \u0635\u062D\u062A\u064A \u0623\u0648 \u0627\u062A\u0635\u0644 \u0639\u0644\u0649 937. \u0648\u0646\u062D\u0646 \u0647\u0646\u0627 \u062F\u0627\u0626\u0645\u064B\u0627 \u0641\u064A \u0627\u0644\u062D\u0627\u0644\u0627\u062A \u0627\u0644\u0637\u0627\u0631\u0626\u0629."
