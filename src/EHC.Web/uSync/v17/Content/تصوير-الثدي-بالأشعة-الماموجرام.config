    <prepare>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cul\u003E\u003Cli\u003E\u064A\u064F\u0641\u0636\u0651\u0644 \u0627\u0644\u062D\u062C\u0632 \u0628\u0639\u062F \u0627\u0644\u062F\u0648\u0631\u0629 \u0627\u0644\u0634\u0647\u0631\u064A\u0629 \u0628\u0623\u0633\u0628\u0648\u0639 \u062D\u064A\u0646 \u064A\u0643\u0648\u0646 \u0627\u0644\u062B\u062F\u064A \u0623\u0642\u0644 \u062D\u0633\u0627\u0633\u064A\u0629\u003C/li\u003E\u003Cli\u003E\u0644\u0627 \u062A\u0633\u062A\u062E\u062F\u0645\u064A \u0645\u0632\u064A\u0644 \u0627\u0644\u0639\u0631\u0642 \u0623\u0648 \u0627\u0644\u0628\u0648\u062F\u0631\u0629 \u0623\u0648 \u0627\u0644\u0643\u0631\u064A\u0645 \u0639\u0644\u0649 \u0627\u0644\u0635\u062F\u0631 \u0648\u0627\u0644\u0625\u0628\u0637 \u064A\u0648\u0645 \u0627\u0644\u0641\u062D\u0635\u003C/li\u003E\u003Cli\u003E\u0627\u0631\u062A\u062F\u064A \u0645\u0644\u0627\u0628\u0633 \u0645\u0646 \u0642\u0637\u0639\u062A\u064A\u0646\u003C/li\u003E\u003Cli\u003E\u0623\u062E\u0628\u0631\u064A \u0627\u0644\u0641\u0631\u064A\u0642 \u0625\u0646 \u0643\u0646\u062A\u0650 \u062D\u0627\u0645\u0644\u064B\u0627 \u0623\u0648 \u0645\u0631\u0636\u0639\u064B\u0627 \u0623\u0648 \u0644\u062F\u064A\u0643\u0650 \u062D\u0634\u0648\u0627\u062A \u0641\u064A \u0627\u0644\u062B\u062F\u064A\u003C/li\u003E\u003C/ul\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cul\u003E\u003Cli\u003EBook for about a week after your period, when your breasts are less tender\u003C/li\u003E\u003Cli\u003EDon\u0026#39;t use deodorant, powder or cream on your chest and underarms on the day\u003C/li\u003E\u003Cli\u003EWear a two-piece outfit\u003C/li\u003E\u003Cli\u003ETell the staff if you are pregnant, breastfeeding or have breast implants\u003C/li\u003E\u003C/ul\u003E"
}]]></Value>
    </prepare>
    <relatedConditions>
      <Value><![CDATA[umb://document/4d17bbdf2b38494b911c4c4e6b58a221]]></Value>
    </relatedConditions>
    <results>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u064A\u0642\u0631\u0623 \u0627\u0644\u0635\u0648\u0631 \u0637\u0628\u064A\u0628 \u0623\u0634\u0639\u0629. \u0642\u062F \u064A\u064F\u0637\u0644\u0628 \u0645\u0646\u0643\u0650 \u0627\u0644\u0639\u0648\u062F\u0629 \u0644\u0635\u0648\u0631 \u0625\u0636\u0627\u0641\u064A\u0629\u060C \u0648\u0623\u063A\u0644\u0628 \u062D\u0627\u0644\u0627\u062A \u0627\u0644\u0627\u0633\u062A\u062F\u0639\u0627\u0621 \u0644\u0627 \u062A\u0643\u0648\u0646 \u0633\u0631\u0637\u0627\u0646\u064B\u0627.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EA radiologist reads the images. You may be asked to come back for more images; most women who are called back don\u0026#39;t have cancer.\u003C/p\u003E"
}]]></Value>
    </results>
    <reviewedBy>
      <Value Culture="ar-SA"><![CDATA[اسم الطبيب]]></Value>
      <Value Culture="en-US"><![CDATA[Doctor Name]]></Value>
