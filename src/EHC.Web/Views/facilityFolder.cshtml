@* Facilities: network / type / emergency filters and a name search (query string, works without JS), map with every
   matching facility, list 24 per page. Facilities may sit directly under this page or under its health network pages. *@
@using System.Text.Json
@using EHC.Web.Site
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "master.cshtml";
    var req = Context.Request;
    var networks = Model.Children().Where(c => c.ContentType.Alias == "healthNetwork" && c.IsVisible()).ToList();
    var network = ListingQuery.Key(req, "network") is { } nk ? networks.FirstOrDefault(n => n.Key == nk) : null;
    string? type = req.Query["type"];
    string[] types = ["hospital", "primaryCare", "specialist", "emergency"];
    if (type is not null && !types.Contains(type)) { type = null; }
    var q = ((string?)req.Query["q"])?.Trim();
    if (q?.Length > 80) { q = q[..80]; }
    var list = (network ?? Model).DescendantsOfType("facility")
        .Where(f => type is null || (type == "emergency" ? f.Value<bool>("hasEmergency") : f.Value<string>("facilityType") == type))
        .Where(f => string.IsNullOrEmpty(q) || f.Name.Contains(q, StringComparison.CurrentCultureIgnoreCase) || (f.Value<string>("city") ?? "").Contains(q, StringComparison.CurrentCultureIgnoreCase))
        .OrderBy(f => f.Value<string>("facilityType") == "primaryCare" ? 1 : 0).ThenBy(f => f.Name).ToList();
    string FacilityMeta(IPublishedContent f) => string.Join(" · ", new[] { Umbraco.GetDictionaryValue("EHC.Facility.Type." + (f.Value<string>("facilityType") is { Length: > 0 } t ? t : "hospital")), f.Value<string>("city") }.Where(x => !string.IsNullOrWhiteSpace(x)));
    var points = JsonSerializer.Serialize(list
        .Where(f => f.Value<decimal?>("latitude") is { } la && la != 0 && f.Value<decimal?>("longitude") is { } lo && lo != 0)
        .Select(f => new { id = f.Key, name = f.Name, type = f.Value<string>("facilityType") ?? "", meta = FacilityMeta(f), lat = f.Value<decimal?>("latitude"), lng = f.Value<decimal?>("longitude"), er = f.Value<bool>("hasEmergency"), url = f.Url() }));
    const int size = 24;
    var pages = Math.Max(1, (int)Math.Ceiling(list.Count / (double)size));
    var page = Math.Min(ListingQuery.CurrentPage(req), pages);
}
@await Html.PartialAsync("site/_PageHeader", Model)
<div class="wrap py-10 lg:py-14">
    <form method="get" action="@req.Path" class="mb-5 flex max-w-xl gap-2" role="search">
        @if (network is not null) { <input type="hidden" name="network" value="@network.Key"> }
        @if (type is not null) { <input type="hidden" name="type" value="@type"> }
        <label for="fac-q" class="sr-only">@Umbraco.GetDictionaryValue("EHC.Facility.Search")</label>
        <input id="fac-q" name="q" type="search" value="@q" maxlength="80" class="field" placeholder="@Umbraco.GetDictionaryValue("EHC.Facility.Search")">
        <button type="submit" class="btn btn-primary shrink-0 !px-5"><svg class="ico" aria-hidden="true"><use href="#i-search" /></svg><span class="sr-only">@Umbraco.GetDictionaryValue("EHC.Health.SearchButton")</span></button>
    </form>
    @if (networks.Count > 0)
    {
        <nav class="mb-3 flex flex-wrap gap-2" aria-label="@Umbraco.GetDictionaryValue("EHC.Network.Filter")">
            <a class="chip" href="@ListingQuery.With(req, "network", null)" aria-current="@(network is null ? "true" : null)">@Umbraco.GetDictionaryValue("EHC.Network.All")</a>
            @foreach (var n in networks) { <a class="chip" href="@ListingQuery.With(req, "network", n.Key.ToString())" aria-current="@(network?.Key == n.Key ? "true" : null)">@n.Name</a> }
        </nav>
    }
    <nav class="mb-6 flex flex-wrap gap-2" aria-label="@Umbraco.GetDictionaryValue("EHC.Facility.Filter")">
        <a class="chip" href="@ListingQuery.With(req, "type", null)" aria-current="@(type is null ? "true" : null)">@Umbraco.GetDictionaryValue("EHC.Common.All")</a>
        @foreach (var t in types)
        {
            <a class="chip" href="@ListingQuery.With(req, "type", t)" aria-current="@(type == t ? "true" : null)">@Umbraco.GetDictionaryValue(t == "emergency" ? "EHC.Facility.Emergency" : "EHC.Facility.Type." + t)</a>
        }
    </nav>
    @if (network is not null)
    {
        <p class="mb-6"><a class="link" href="@network.Url()"><span>@string.Format(Umbraco.GetDictionaryValue("EHC.Network.About") ?? "{0}", network.Name)</span><svg class="ico flip !h-4 !w-4" aria-hidden="true"><use href="#i-arrow" /></svg></a></p>
    }
    <div class="grid gap-6 lg:grid-cols-[1.1fr_.9fr]">
        <div class="min-h-[420px] overflow-hidden rounded-[22px] border border-slate-200 lg:sticky lg:top-24 lg:h-[calc(100vh-8rem)] dark:border-white/10" data-map data-points="@points" role="region" aria-label="@Umbraco.GetDictionaryValue("EHC.Facility.Map")"></div>
        <div>
            <p class="mb-4 text-sm text-slate-500 dark:text-slate-400" role="status">@string.Format(Umbraco.GetDictionaryValue("EHC.Common.ResultCount") ?? "{0}", list.Count)</p>
            @if (list.Count == 0) { <p class="card p-10 text-center text-slate-500 dark:text-slate-400">@Umbraco.GetDictionaryValue("EHC.Common.NoResults")</p> }
            <div class="grid gap-3">
                @foreach (var f in list.Skip((page - 1) * size).Take(size)) { @await Html.PartialAsync("cards/_FacilityCard", f) }
            </div>
            @await Html.PartialAsync("site/_Pager", (page, pages))
        </div>
    </div>
</div>
@await Html.PartialAsync("site/_MapAssets")
@await Html.GetBlockListHtmlAsync(Model.Value<BlockListModel>("blocks"))
