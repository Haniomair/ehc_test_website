    <why>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cul\u003E\u003Cli\u003E\u062A\u0634\u062E\u064A\u0635 \u0627\u0644\u0633\u0643\u0631\u064A \u0645\u0646 \u0627\u0644\u0646\u0648\u0639 \u0627\u0644\u062B\u0627\u0646\u064A \u0648\u0645\u0631\u062D\u0644\u0629 \u0645\u0627 \u0642\u0628\u0644 \u0627\u0644\u0633\u0643\u0631\u064A\u003C/li\u003E\u003Cli\u003E\u0645\u062A\u0627\u0628\u0639\u0629 \u0627\u0644\u062A\u062D\u0643\u0645 \u0641\u064A \u0627\u0644\u0633\u0643\u0631\u064A\u060C \u0639\u0627\u062F\u0629 \u0643\u0644 3 \u0625\u0644\u0649 6 \u0623\u0634\u0647\u0631\u003C/li\u003E\u003C/ul\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cul\u003E\u003Cli\u003ETo diagnose type 2 diabetes and prediabetes\u003C/li\u003E\u003Cli\u003ETo check how well diabetes is controlled, usually every 3 to 6 months\u003C/li\u003E\u003C/ul\u003E"
}]]></Value>
    </why>
  </Properties>
</Content>