          "value": "A\u2013Z index"
        },
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0627\u0644\u0645\u0646\u0634\u0622\u062A \u0627\u0644\u0635\u062D\u064A\u0629 *\u0645\u0646 \u0623 \u0625\u0644\u0649 \u064A*"
