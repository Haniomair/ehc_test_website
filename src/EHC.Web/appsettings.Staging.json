{
  "$schema": "appsettings-schema.json",
  "Umbraco": {
    "CMS": {
      "Global": {
        "UseHttps": true
      }
    }
  },
  "uSync": {
    "Settings": {
      "ImportAtStartup": "Settings",
      "ExportOnSave": "None"
    },
    "Sets": {
      "Default": {
        "Handlers": {
          "DictionaryHandler": {
            "Group": "Settings"
          }
        }
      }
    }
  },
  "Ehc": {
    "Customizer": {
      "Enabled": true
    },
    "Assistant": {
      "Demo": true
    },
    "ErWait": {
      "UseDemoData": true
    },
    "Seo": {
      "NoIndex": true
    }
  }
}
