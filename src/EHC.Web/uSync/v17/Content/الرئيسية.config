                      }
                    ]
                  },
                  {
                    "alias": "title",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "Get advice without a visit"
                  },
                  {
                    "alias": "text",
                    "culture": "en-US",
                    "editorAlias": null,
                    "segment": null,
                    "value": "A doctor can help without a visit: a consultation in the Sehhaty app, or call 937."
                  },
                  {
                    "alias": "ctaLabel",
                    "culture": "en-US",
                    "editorAlias": null,
