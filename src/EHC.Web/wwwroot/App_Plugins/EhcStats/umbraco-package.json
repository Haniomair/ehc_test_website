{
  "$schema": "../../umbraco-package-schema.json",
  "name": "EHC Visitor statistics",
  "version": "1.0.0",
  "allowPublicAccess": false,
  "extensions": [
    {
      "type": "section",
      "alias": "Ehc.Section.Statistics",
      "name": "Statistics",
      "weight": 850,
      "meta": { "label": "Statistics", "pathname": "statistics" },
      "conditions": [{ "alias": "Umb.Condition.SectionUserPermission", "match": "Ehc.Section.Statistics" }]
    },
    {
      "type": "dashboard",
      "alias": "Ehc.Dashboard.VisitorStatistics",
      "name": "Visitor statistics",
      "element": "/App_Plugins/EhcStats/stats-dashboard.js",
      "weight": 10,
      "meta": { "label": "Visitors", "pathname": "visitors" },
      "conditions": [{ "alias": "Umb.Condition.SectionAlias", "match": "Ehc.Section.Statistics" }]
    },
    {
      "type": "dashboard",
      "alias": "Ehc.Dashboard.RealTime",
      "name": "Real-time visitors",
      "element": "/App_Plugins/EhcStats/stats-live.js",
      "weight": 5,
      "meta": { "label": "Real time", "pathname": "real-time" },
      "conditions": [{ "alias": "Umb.Condition.SectionAlias", "match": "Ehc.Section.Statistics" }]
    },
    {
      "type": "dashboard",
      "alias": "Ehc.Dashboard.Funnels",
      "name": "Funnels",
      "element": "/App_Plugins/EhcStats/stats-funnels.js",
      "weight": 3,
      "meta": { "label": "Funnels", "pathname": "funnels" },
      "conditions": [{ "alias": "Umb.Condition.SectionAlias", "match": "Ehc.Section.Statistics" }]
    },
    {
      "type": "dashboard",
      "alias": "Ehc.Dashboard.Heatmaps",
      "name": "Heatmaps",
      "element": "/App_Plugins/EhcStats/stats-heatmap.js",
      "weight": 2,
      "meta": { "label": "Heatmaps", "pathname": "heatmaps" },
      "conditions": [{ "alias": "Umb.Condition.SectionAlias", "match": "Ehc.Section.Statistics" }]
    }
  ]
}
