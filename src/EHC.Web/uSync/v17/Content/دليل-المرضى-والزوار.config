    },
    {
      "contentTypeKey": "4fa0d635-4129-440d-a044-6c8c8aeeb204",
      "key": "062c8339-08e8-4bfb-8fde-bb1d86873f01",
      "values": [
        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0645\u0627 \u064A\u062C\u0628 \u0625\u062D\u0636\u0627\u0631\u0647 \u0625\u0644\u0649 \u0645\u0648\u0639\u062F\u0643"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "What to bring to your appointment"
        },
        {
          "alias": "columns",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "2"
          ]
        },
        {
          "alias": "marker",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "check"
          ]
        },
        {
          "alias": "items",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0627\u0644\u0647\u0648\u064A\u0629 \u0627\u0644\u0648\u0637\u0646\u064A\u0629 \u0623\u0648 \u0627\u0644\u0625\u0642\u0627\u0645\u0629\n\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0623\u062F\u0648\u064A\u0629 \u0627\u0644\u062D\u0627\u0644\u064A\u0629\n\u0627\u0644\u062A\u0642\u0627\u0631\u064A\u0631 \u0627\u0644\u0637\u0628\u064A\u0629 \u0627\u0644\u0633\u0627\u0628\u0642\u0629\n\u0631\u0642\u0645 \u0627\u0644\u062C\u0648\u0627\u0644 \u0627\u0644\u0645\u0633\u062C\u0644"
        },
        {
          "alias": "items",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "National ID or iqama\nA list of your current medicines\nPrevious medical reports\nYour registered mobile number"
        }
      ]
    },
    {
      "contentTypeKey": "0e6367ab-cbbe-47ba-bb36-d98f67198d15",
      "key": "1f743fef-c261-416b-a43f-cb57defc5fe8",
      "values": [
        {
          "alias": "tone",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            "emergency"
          ]
        },
        {
          "alias": "title",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0641\u064A \u0627\u0644\u062D\u0627\u0644\u0627\u062A \u0627\u0644\u0637\u0627\u0631\u0626\u0629"
        },
        {
          "alias": "title",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "In an emergency"
        },
        {
          "alias": "text",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u062A\u0648\u062C\u0651\u0647 \u0625\u0644\u0649 \u0623\u0642\u0631\u0628 \u0642\u0633\u0645 \u0637\u0648\u0627\u0631\u0626 \u0623\u0648 \u0627\u062A\u0635\u0644 \u0628\u0627\u0644\u0625\u0633\u0639\u0627\u0641 \u0639\u0644\u0649 997."
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Go to the nearest emergency department or call an ambulance on 997."
        },
        {
          "alias": "link",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "\u0627\u0628\u062D\u062B \u0639\u0646 \u0623\u0642\u0631\u0628 \u0637\u0648\u0627\u0631\u0626",
              "target": null,
              "unique": "6fbbfeac-23b9-4f4a-b4d0-02da4911a504",
              "type": "document",
              "udi": "umb://document/6fbbfeac23b94f4ab4d002da4911a504",
              "url": null,
              "queryString": null,
              "culture": null
            }
          ]
        },
        {
          "alias": "link",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "Find the nearest emergency department",
              "target": null,
              "unique": "6fbbfeac-23b9-4f4a-b4d0-02da4911a504",
              "type": "document",
              "udi": "umb://document/6fbbfeac23b94f4ab4d002da4911a504",
              "url": null,
              "queryString": null,
              "culture": null
            }
          ]
        }
      ]
    },
    {
      "contentTypeKey": "1a42d957-7e10-4666-91fa-0d0b08dbe775",
      "key": "511d12a7-973c-45ae-8fb1-337252de2cf5",
      "values": [
        {
          "alias": "title",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0647\u0644 \u0644\u062F\u064A\u0643 \u0627\u0633\u062A\u0641\u0633\u0627\u0631 \u0623\u0648 \u0645\u0644\u0627\u062D\u0638\u0629\u061F"
        },
        {
          "alias": "title",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Have a question or feedback?"
        },
        {
          "alias": "text",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u064A\u0633\u0631\u0651\u0646\u0627 \u062A\u0648\u0627\u0635\u0644\u0643 \u0645\u0639\u0646\u0627\u060C \u0648\u0633\u064A\u062A\u0648\u0627\u0635\u0644 \u0645\u0639\u0643 \u0641\u0631\u064A\u0642\u0646\u0627 \u0641\u064A \u0623\u0642\u0631\u0628 \u0648\u0642\u062A \u0645\u0645\u0643\u0646."
        },
        {
          "alias": "text",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "We are glad to hear from you, and our team will contact you as soon as possible."
        },
        {
          "alias": "primaryCta",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "\u062A\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627",
              "target": null,
              "unique": "37b475e5-0fbe-4568-938e-5eaed2a778bf",
              "type": "document",
              "udi": "umb://document/37b475e50fbe4568938e5eaed2a778bf",
              "url": null,
              "queryString": null,
              "culture": null
            }
          ]
        },
        {
          "alias": "primaryCta",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "Contact us",
              "target": null,
