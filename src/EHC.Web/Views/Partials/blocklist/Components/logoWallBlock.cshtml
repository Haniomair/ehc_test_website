@* Logo wall: partners, accreditations, insurers. Grid, or a slow scrolling strip (paused on hover/focus and
   static under prefers-reduced-motion). Each logo needs a name (used as alt text); optional link and grayscale. *@
@using EHC.Web.Blocks
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var c = Model.Content;
    var items = c.Value<BlockListModel>("items")?.Select(i => i.Content).Where(i => i.Value<MediaWithCrops>("logo") is not null).ToList() ?? [];
    if (items.Count == 0) { return; }
    var scroll = c.Value<string>("layout") == "scroll" && items.Count > 3;
    var gray = c.Value<bool>("grayscale");
}
@{
    void Logo(IPublishedElement l, bool hidden)
    {
        var img = l.Value<MediaWithCrops>("logo")!;
        var url = img.Url()!;
        var src = url.EndsWith(".svg", StringComparison.OrdinalIgnoreCase) ? url : img.GetCropUrl(height: 120, furtherOptions: "format=webp&quality=85");
        var link = l.Value<Link>("link");
        var cls = $"flex h-24 items-center justify-center rounded-2xl bg-white px-6 ring-1 ring-slate-100 transition dark:bg-white/95 dark:ring-0 {(gray ? "grayscale opacity-75 hover:grayscale-0 hover:opacity-100 focus-visible:grayscale-0 focus-visible:opacity-100" : "")}";
        var alt = hidden ? "" : l.Value<string>("orgName") ?? "";
        if (link is not null && !hidden)
        {
            <a href="@link.Url" target="@link.Target" class="@cls"><img src="@src" alt="@alt" class="max-h-14 w-auto max-w-full object-contain" loading="lazy"></a>
        }
        else
        {
            <div class="@cls"><img src="@src" alt="@alt" class="max-h-14 w-auto max-w-full object-contain" loading="lazy"></div>
        }
    }
}
<div class="wrap">
    <div class="rv sec-head @(c.Value<string>("align") == "center" ? "sec-head-center" : "")">@await Html.PartialAsync("blocklist/_SectionHeader", new SectionHeader(c.Value<string>("eyebrow"), c.Value<string>("heading"), c.Value<string>("intro")))</div>
    @if (scroll)
    {
        <div class="logo-strip rv overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)]">
            <ul class="logo-track flex w-max gap-5">
                @foreach (var l in items) { <li class="w-48 shrink-0">@{ Logo(l, false); }</li> }
                @foreach (var l in items) { <li class="w-48 shrink-0" aria-hidden="true">@{ Logo(l, true); }</li> }
            </ul>
        </div>
    }
    else
    {
        <ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-@(Math.Clamp(items.Count, 3, 6))">
            @foreach (var l in items) { <li class="rv">@{ Logo(l, false); }</li> }
        </ul>
    }
</div>
