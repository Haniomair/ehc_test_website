          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0627\u0644\u0648\u062B\u0627\u0626\u0642 \u0627\u0644\u0631\u0633\u0645\u064A\u0629"
        },
        {
          "alias": "heading",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "Official documents"
        },
        {
          "alias": "intro",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u062A\u0644\u062E\u0651\u0635 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062D\u0629 \u062D\u0642\u0648\u0642 \u0627\u0644\u0645\u0631\u0636\u0649 \u0643\u0645\u0627 \u062A\u0646\u0634\u0631\u0647\u0627 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0635\u062D\u0629\u060C \u0648\u0627\u0644\u0648\u062B\u0627\u0626\u0642 \u0627\u0644\u0631\u0633\u0645\u064A\u0629 \u0647\u064A \u0627\u0644\u0645\u0631\u062C\u0639."
        },
        {
          "alias": "intro",
          "culture": "en-US",
          "editorAlias": null,
          "segment": null,
          "value": "This page summarises patient rights as published by the Ministry of Health; the official documents are the reference."
        },
