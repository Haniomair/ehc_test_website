                    "value": "\u064A\u0646\u0642\u0630 \u0627\u0644\u062D\u064A\u0627\u0629."
                  },
                  {
                    "alias": "lead",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u0627\u062D\u062C\u0632\u064A \u0641\u062D\u0635 \u0627\u0644\u0645\u0627\u0645\u0648\u062C\u0631\u0627\u0645 \u0641\u064A \u0623\u0642\u0631\u0628 \u0645\u0646\u0634\u0623\u0629. \u062F\u0642\u0627\u0626\u0642 \u0642\u0644\u064A\u0644\u0629 \u0642\u062F \u062A\u0635\u0646\u0639 \u0627\u0644\u0641\u0631\u0642."
