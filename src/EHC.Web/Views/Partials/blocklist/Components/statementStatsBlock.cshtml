@* Block 6 "Statement + stats" ("Why EHC"), with an optional strip of accreditation logos under it (scrolling slowly;
   paused on hover, keyboard focus and with its button; still and scrollable under reduced motion). Italic text in the statement is shown as the highlighted phrase.
   Stats: keep "##" placeholders until official figures are approved. *@
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Strings
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>
@{
    var c = Model.Content;
    var eyebrow = c.Value<string>("eyebrow");
    var statement = c.Value<IHtmlEncodedString>("statement")?.ToHtmlString();
    var ctas = c.Value<IEnumerable<Link>>("ctas")?.ToList() ?? [];
    var stats = c.Value<BlockListModel>("stats")?.Select(s => s.Content).Where(s => !string.IsNullOrWhiteSpace(s.Value<string>("value"))).ToList() ?? [];
    // optional row of accreditation logos under the statement (same items as the Accreditations section)
    var marks = c.Value<BlockListModel>("accreditations")?.Select(x => x.Content).Where(x => !string.IsNullOrWhiteSpace(x.Value<string>("title"))).ToList() ?? [];
    var marksHeading = c.Value<string>("accreditationsHeading");
    if (string.IsNullOrWhiteSpace(statement) && stats.Count == 0 && marks.Count == 0) { return; }
    var stripId = "acc-" + Model.ContentKey.ToString("N")[..8];
    // enough copies that one half of the track is wider than the screen, then the same again (the loop moves by half)
    var copies = marks.Count == 0 ? 0 : Math.Max(1, (int)Math.Ceiling(10.0 / marks.Count));
    var duration = Math.Max(24, marks.Count * copies * 4);
    const string cell = "flex h-20 w-40 items-center justify-center px-3 sm:w-44 [&_img]:opacity-70 [&_img]:grayscale [&_img]:transition hover:[&_img]:opacity-100 hover:[&_img]:grayscale-0 focus-visible:[&_img]:opacity-100 focus-visible:[&_img]:grayscale-0 dark:[&_img]:opacity-85";
}
@{
    void Mark(string? name, IPublishedContent? logo)
    {
        if (logo is not null) { <img src="@logo.Url()" alt="@name" class="max-h-16 w-auto max-w-[140px] object-contain" loading="lazy"> }
        else { <span class="text-xl font-black tracking-[.04em] text-slate-500 dark:text-slate-300">@name</span> }
    }
}
<div class="wrap">
<div class="grid items-center gap-14 @(stats.Count > 0 && !string.IsNullOrWhiteSpace(statement) ? "lg:grid-cols-[1.1fr_.9fr]" : "")">
    @if (!string.IsNullOrWhiteSpace(statement))
    {
        <div class="rv">
            @if (!string.IsNullOrWhiteSpace(eyebrow)) { <div class="eyebrow">@eyebrow</div> }
            <div class="max-w-[38rem] text-[clamp(1.15rem,1.7vw,1.45rem)] font-normal leading-[1.75] text-slate-600 text-pretty dark:text-slate-300 [&_strong]:font-semibold [&_strong]:text-deep-900 dark:[&_strong]:text-white [&_em]:font-semibold [&_em]:not-italic [&_em]:text-brand-500 [&_em]:bg-[linear-gradient(transparent_62%,color-mix(in_srgb,var(--brand-500)_18%,transparent)_62%)] dark:[&_em]:text-brand-300 [&_p]:m-0">@Html.Raw(statement)</div>
            @if (ctas.Count > 0)
            {
                <div class="mt-7 flex flex-wrap gap-3">
                    @for (var i = 0; i < ctas.Count; i++)
                    {
                        <a class="btn @(i == 0 ? "btn-primary" : "btn-ghost")" href="@ctas[i].Url" target="@ctas[i].Target">@ctas[i].Name</a>
                    }
                </div>
            }
        </div>
    }
    @if (stats.Count > 0)
    {
        <div class="rv">
            <div class="grid grid-cols-2 gap-4">
                @foreach (var s in stats)
                {
                    var hi = s.Value<bool>("highlight");
                    <div class="rounded-[22px] p-6 @(hi ? "bg-deep-900 text-white dark:bg-brand-500/15 dark:ring-1 dark:ring-brand-400/20" : "bg-soft dark:bg-night-900 dark:ring-1 dark:ring-white/10")">
                        <b class="block text-[2.1rem] leading-none sm:text-[2.8rem] @(hi ? "" : "text-deep-900 dark:text-white")">@(s.Value<string>("value"))@if (!string.IsNullOrWhiteSpace(s.Value<string>("suffix"))) {<sup class="text-[.5em] text-brand-500">@(s.Value<string>("suffix"))</sup>}</b>
                        <span class="text-sm @(hi ? "text-brand-100" : "text-slate-600 dark:text-slate-400")">@(s.Value<string>("label"))</span>
                    </div>
                }
            </div>
        </div>
    }
</div>
@if (marks.Count > 0)
{
    <div class="rv mt-12 border-t border-slate-200 pt-8 dark:border-white/10">
        @if (!string.IsNullOrWhiteSpace(marksHeading)) { <h2 class="mb-8 text-center text-sm font-bold uppercase tracking-[.14em] text-slate-500 rtl:tracking-normal dark:text-slate-400">@marksHeading</h2> }
        @* the first set is the real list; the copies (for the endless loop) are hidden from screen readers and keyboards *@
        <div id="@stripId" class="logo-strip overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)]">
            <ul class="logo-track flex w-max items-center gap-x-6" style="--mq-dur: @(duration)s" aria-label="@marksHeading">
                @for (var round = 0; round < copies * 2; round++)
                {
                    foreach (var it in marks)
                    {
                        var name = it.Value<string>("title");
                        var logo = it.Value<IPublishedContent>("logo");
                        var link = it.Value<Link>("link");
                        if (round > 0) { <li class="shrink-0" aria-hidden="true"><div class="@cell">@{ Mark(name, logo); }</div></li> continue; }
                        <li class="shrink-0">
                            @if (link is not null) { <a href="@link.Url" target="@link.Target" class="@cell">@{ Mark(name, logo); }</a> }
                            else { <div class="@cell">@{ Mark(name, logo); }</div> }
                        </li>
                    }
                }
            </ul>
        </div>
        @* pause for the moving strip (WCAG 2.2.2: hover is not enough on touch screens) *@
        <div class="mt-3 flex justify-end">
            <button type="button" data-strip-pause aria-controls="@stripId" aria-pressed="false" aria-label="@Umbraco.GetDictionaryValue("EHC.Hero.Pause")" class="grid h-7 w-7 place-items-center rounded-full text-slate-500 transition hover:bg-soft hover:text-brand-600 dark:text-slate-400 dark:hover:bg-white/10">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon="pause"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
                <svg class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon="play"><path d="M8 5v14l11-7z" /></svg>
            </button>
        </div>
    </div>
    <script src="~/assets/js/components/logo-strip.js" asp-append-version="true" defer></script>
}
</div>
