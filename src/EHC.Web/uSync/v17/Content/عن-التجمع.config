                    "alias": "title",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0623\u0633\u064A\u0633 \u0627\u0644\u0645\u062C\u0644\u0633 \u0627\u0644\u062A\u0623\u0633\u064A\u0633\u064A \u0644\u0644\u0642\u0637\u0627\u0639 \u0627\u0644\u0634\u0631\u0642\u064A"
                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0623\u0633\u064A\u0633 \u0627\u0644\u0645\u062C\u0644\u0633 \u0627\u0644\u062A\u0623\u0633\u064A\u0633\u064A \u0644\u0644\u0642\u0637\u0627\u0639 \u0627\u0644\u0634\u0631\u0642\u064A \u0628\u0647\u062F\u0641 \u062F\u0639\u0645 \u0627\u0644\u062D\u0648\u0643\u0645\u0629 \u0648\u062A\u0639\u0632\u064A\u0632 \u0627\u0644\u062A\u0643\u0627\u0645\u0644 \u0628\u064A\u0646 \u0645\u0643\u0648\u0646\u0627\u062A \u0627\u0644\u0645\u0646\u0638\u0648\u0645\u0629 \u0627\u0644\u0635\u062D\u064A\u0629\u060C \u0648\u0627\u0644\u0645\u0633\u0627\u0647\u0645\u0629 \u0641\u064A \u0631\u0633\u0645 \u0627\u0644\u062A\u0648\u062C\u0647\u0627\u062A \u0627\u0644\u0627\u0633\u062A\u0631\u0627\u062A\u064A\u062C\u064A\u0629 \u0644\u0645\u0633\u062A\u0642\u0628\u0644 \u0627\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u0641\u064A \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0634\u0631\u0642\u064A\u0629\u060C \u0628\u0645\u0627 \u064A\u062A\u0645\u0627\u0634\u0649 \u0645\u0639 \u0645\u0633\u062A\u0647\u062F\u0641\u0627\u062A \u0627\u0644\u062A\u062D\u0648\u0644 \u0627\u0644\u0635\u062D\u064A \u0627\u0644\u0648\u0637\u0646\u064A."
