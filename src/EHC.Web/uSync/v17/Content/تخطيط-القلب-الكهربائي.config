      <Value><![CDATA[]]></Value>
    </blocks>
    <bodySystems>
      <Value><![CDATA[[
  "heart"
]]]></Value>
    </bodySystems>
    <careFacilities>
      <Value><![CDATA[umb://document/0b7d01833d4d4b7887be4b9cf3db3598]]></Value>
    </careFacilities>
    <during>
      <Value Culture="ar-SA"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003E\u062A\u0648\u0636\u0639 \u0644\u0635\u0642\u0627\u062A \u0635\u063A\u064A\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u0635\u062F\u0631 \u0648\u0627\u0644\u0630\u0631\u0627\u0639\u064A\u0646 \u0648\u0627\u0644\u0633\u0627\u0642\u064A\u0646 \u0648\u062A\u0648\u0635\u0644 \u0628\u0627\u0644\u062C\u0647\u0627\u0632\u060C \u0648\u062A\u0628\u0642\u0649 \u0645\u0633\u062A\u0644\u0642\u064A\u064B\u0627 \u062F\u0648\u0646 \u062D\u0631\u0643\u0629 \u0644\u062F\u0642\u0627\u0626\u0642. \u064A\u0633\u062A\u063A\u0631\u0642 \u0627\u0644\u0641\u062D\u0635 \u0646\u062D\u0648 5 \u0625\u0644\u0649 10 \u062F\u0642\u0627\u0626\u0642.\u003C/p\u003E"
}]]></Value>
      <Value Culture="en-US"><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003ESmall sticky pads are placed on your chest, arms and legs and connected to the machine, and you lie still for a few minutes. The test takes about 5 to 10 minutes.\u003C/p\u003E"
}]]></Value>
    </during>
