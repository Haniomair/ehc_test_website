                    "value": {
                      "blocks": {
                        "contentData": [],
                        "settingsData": [],
                        "expose": [],
                        "layout": {}
                      },
                      "markup": "\u003Ch2\u003EPlaceholder heading\u003C/h2\u003E\u003Cp\u003EPlaceholder text in the first column. Each column can hold text, an image, a video, an FAQ or a health tool.\u003C/p\u003E\u003Cul\u003E\u003Cli\u003EPlaceholder point\u003C/li\u003E\u003Cli\u003EPlaceholder point\u003C/li\u003E\u003C/ul\u003E"
                    }
