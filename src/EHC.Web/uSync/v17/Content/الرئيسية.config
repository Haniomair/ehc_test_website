        {
          "alias": "heading",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0627\u0637\u0645\u0626\u0646 \u0639\u0644\u0649 \u0635\u062D\u062A\u0643 \u0641\u064A *\u062F\u0642\u0627\u0626\u0642*"
        },
        {
          "alias": "intro",
          "culture": "ar-SA",
          "editorAlias": null,
          "segment": null,
          "value": "\u0623\u062F\u0648\u0627\u062A \u0633\u0631\u064A\u0639\u0629 \u062A\u0633\u0627\u0639\u062F\u0643 \u0639\u0644\u0649 \u0641\u0647\u0645 \u0635\u062D\u062A\u0643\u060C \u0648\u0645\u062A\u0649 \u062A\u062D\u062A\u0627\u062C \u0625\u0644\u0649 \u0632\u064A\u0627\u0631\u0629 \u0637\u0628\u064A\u0628\u0643."
