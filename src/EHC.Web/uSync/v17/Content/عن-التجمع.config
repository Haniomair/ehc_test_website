                  },
                  {
                    "alias": "text",
                    "culture": "ar-SA",
                    "editorAlias": null,
                    "segment": null,
                    "value": "\u062A\u0642\u062F\u064A\u0645 \u0646\u0645\u0648\u0630\u062C \u0645\u0633\u062A\u062F\u0627\u0645 \u0648\u0645\u0628\u062A\u0643\u0631 \u0644\u0644\u0631\u0639\u0627\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u0629 \u064A\u0639\u0632\u0632 \u0645\u0646 \u062C\u0648\u062F\u0629 \u0627\u0644\u062D\u064A\u0627\u0629 \u0644\u0644\u062C\u0645\u064A\u0639."
